/* components/nav-bar/index.wxss - Dota2 风格导航栏 */
.nav-wrap {
  background: #0d1017;
  border-bottom: 1rpx solid rgba(224, 181, 111, 0.15);
  display: flex;
  align-items: center;
  position: relative;
  box-sizing: content-box;
}
.nav-left {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx;
}
.nav-home-text {
  font-size: 28rpx;
  color: #b9c0cb;
  letter-spacing: 1rpx;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #e8c27c;
  letter-spacing: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nav-right {
  display: flex;
  align-items: center;
  padding: 8rpx 0 8rpx 8rpx;
}
.nav-staff-text {
  font-size: 26rpx;
  color: #b9c0cb;
}
.nav-hover {
  opacity: 0.6;
}
