/* components/nav-bar/index.wxss - 页面标题栏，主导航位于底部 tabBar */
.nav-wrap {
  background: #0d1017;
  border-bottom: 1rpx solid rgba(224, 181, 111, 0.15);
  display: flex;
  align-items: center;
  position: relative;
  box-sizing: content-box;
}
.nav-back {
  position: absolute;
  left: 12rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
}
.nav-back-icon { width: 40rpx; height: 40rpx; }
.nav-back-pressed { opacity: .5; }
.nav-title {
  width: 100%;
  padding: 0 150rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #e8c27c;
  letter-spacing: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
