.effect-freezingfield .effect-a { inset: 0; background: radial-gradient(circle at 50% 45%,rgba(174,239,255,.32),transparent 58%),linear-gradient(180deg,rgba(103,189,225,.12),rgba(191,244,255,.28)); animation: skill-stage 5s ease-in-out infinite; }
