.player-card {
  position: relative;
  overflow: hidden;
  min-height: 100rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(230, 192, 122, .66);
  box-sizing: border-box;
  background: linear-gradient(135deg, #202838, #10151e 70%);
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, .28), inset 0 0 32rpx rgba(226, 177, 94, .07);
}
.player-card-glow {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  right: -96rpx;
  top: -172rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(220, 181, 105, .22), rgba(220, 181, 105, 0) 68%);
  pointer-events: none;
}
.smurf-warning {
  position: relative;
  z-index: 3;
  height: 36rpx;
  margin: -4rpx 0 12rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 112, 92, .72);
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(112, 20, 20, .88), rgba(190, 48, 32, .88), rgba(112, 20, 20, .88));
  color: #ffe3a3;
  box-shadow: 0 0 14rpx rgba(255, 75, 52, .28);
}
.smurf-warning-track { display: flex; width: max-content; animation: smurf-warning-scroll 5s linear infinite; }
.smurf-warning-text { flex: none; padding: 0 48rpx; color: #ffe3a3; font-size: 22rpx; font-weight: 800; line-height: 34rpx; white-space: nowrap; text-shadow: 0 0 8rpx rgba(255, 218, 128, .55); }
@keyframes smurf-warning-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.player-card-content { position: relative; z-index: 2; display: flex; align-items: center; gap: 16rpx; }
.player-card-heading { display: flex; align-items: center; gap: 12rpx; flex: 1; min-width: 0; }
.player-card-role { padding: 4rpx 12rpx; border-radius: 16rpx; color: #201809; background: #e2ba70; font-size: 19rpx; flex: none; }
.player-card-name { flex: 1; min-width: 0; margin-top: 0; color: #f1e6cf; font-size: 38rpx; line-height: 1.2; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-card-side { flex: 0 1 auto; min-width: 0; max-width: 62%; }
.player-card-meta { display: flex; align-items: center; justify-content: flex-end; gap: 14rpx; margin-top: 0; color: rgba(223, 208, 177, .83); font-size: 22rpx; }
.player-card-dota { flex: 0 1 auto; min-width: 0; margin-top: 0; color: rgba(230, 214, 183, .9); font-size: 21rpx; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-card-location { flex-shrink: 0; white-space: nowrap; }
/* 全站统一名片两段式：第一排「昵称 / 段位与位次」，第二排「赛季战绩在昵称正下方，签名靠右」 */
.player-card-season-label { color: rgba(222, 204, 164, .58); }
.player-card-season-value { color: #f0cd7e; font-size: 22rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.player-card-season-dot { margin: 0 3rpx; color: rgba(222, 204, 164, .42); }
/* 第二排：左侧战绩贴左对齐到昵称下方，签名占右侧剩余宽度，过长时省略 */
.player-card-sub { position: relative; z-index: 2; display: flex; align-items: baseline; gap: 18rpx; margin-top: 4rpx; }
.player-card-honors-line { display: flex; align-items: baseline; flex: none; gap: 6rpx; color: rgba(222, 204, 164, .78); font-size: 18rpx; line-height: 1.3; white-space: nowrap; overflow: hidden; }
.player-card-honors { flex: none; color: rgba(240, 205, 126, .86); font-size: 18rpx; line-height: 1.3; white-space: nowrap; }
.player-card-signature-row { flex: 1 1 auto; min-width: 0; margin-top: 0; color: rgba(235, 229, 216, .72); font-size: 19rpx; line-height: 1.3; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 位次数字徽章：组件样式隔离，样式必须自带 */
.player-card-roles { display: flex; align-items: center; flex-shrink: 0; }
.player-card-role-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  margin-left: 6rpx;
  box-sizing: border-box;
  border-radius: 6rpx;
  border: 1rpx solid rgba(224, 181, 111, .42);
  background: rgba(224, 181, 111, .16);
  color: #e8c27c;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}
.player-card-roles .player-card-role-chip:first-child { margin-left: 0; }
/* 「全能」徽章：五个位次全选时折叠成一个，去掉方块固定宽，按文字自适应 */
.player-card-role-chip-versatile { min-width: 0; padding: 0 10rpx; letter-spacing: 2rpx; }
/* 全站名片统一尺寸：不再有小号名片，任何页面渲染出来的名片都与「我的名片」同一套尺寸与字号 */

/* 背景 */
.card-bg-arena { background: radial-gradient(ellipse at 82% 5%, rgba(213, 159, 76, .25), transparent 43%), linear-gradient(135deg, #283142, #111722 74%); }
.card-bg-dire { background: radial-gradient(ellipse at 84% 10%, rgba(190, 54, 47, .34), transparent 46%), linear-gradient(135deg, #392326, #171319 75%); }
.card-bg-ice { background: radial-gradient(ellipse at 82% 5%, rgba(86, 193, 223, .27), transparent 45%), linear-gradient(135deg, #1c3442, #10171f 75%); }
.card-bg-arcane { background: radial-gradient(ellipse at 82% 5%, rgba(137, 104, 225, .3), transparent 46%), linear-gradient(135deg, #2b2441, #12131e 75%); }
.card-bg-river { background: radial-gradient(ellipse at 18% 0%, rgba(74, 174, 190, .3), transparent 48%), linear-gradient(135deg, #1c404d, #0f1c26 75%); }
.card-bg-forest { background: radial-gradient(ellipse at 82% 5%, rgba(104, 157, 91, .28), transparent 46%), linear-gradient(135deg, #293f32, #111b18 75%); }
.card-bg-lava { background: radial-gradient(ellipse at 82% 8%, rgba(224, 104, 51, .34), transparent 46%), linear-gradient(135deg, #4b2d25, #1b1517 75%); }
.card-bg-moon { background: radial-gradient(ellipse at 78% 0%, rgba(167, 181, 216, .3), transparent 44%), linear-gradient(135deg, #30394f, #121621 75%); }
.card-bg-desert { background: radial-gradient(ellipse at 80% 6%, rgba(220, 176, 100, .32), transparent 46%), linear-gradient(135deg, #4a3d2c, #1b1917 75%); }
/* 边框 */
.card-border-gold { border-color: rgba(230, 192, 122, .78); }
.card-border-rune { border-color: rgba(154, 128, 232, .82); box-shadow: 0 0 0 4rpx rgba(154, 128, 232, .08), inset 0 0 24rpx rgba(154, 128, 232, .1); }
.card-border-steel { border-color: rgba(152, 177, 195, .78); box-shadow: inset 0 0 0 5rpx rgba(152, 177, 195, .06); }
.card-border-ember { border-color: rgba(255, 126, 74, .86); box-shadow: 0 0 20rpx rgba(255, 100, 52, .14), inset 0 0 24rpx rgba(255, 126, 74, .08); }
.card-border-frost { border-color: rgba(143, 224, 237, .86); box-shadow: 0 0 20rpx rgba(116, 214, 235, .14), inset 0 0 24rpx rgba(143, 224, 237, .08); }
.card-border-toxic { border-color: rgba(169, 223, 137, .84); box-shadow: 0 0 20rpx rgba(121, 201, 102, .12), inset 0 0 24rpx rgba(169, 223, 137, .07); }
.card-border-dire { border-color: rgba(220, 85, 79, .88); box-shadow: 0 0 20rpx rgba(208, 56, 50, .16), inset 0 0 24rpx rgba(220, 85, 79, .08); }
.card-border-radiant { border-color: rgba(189, 213, 122, .84); box-shadow: 0 0 20rpx rgba(190, 205, 105, .12), inset 0 0 24rpx rgba(224, 181, 111, .08); }
.card-border-shadow { border-color: rgba(104, 113, 136, .82); box-shadow: 0 0 20rpx rgba(25, 27, 42, .4), inset 0 0 28rpx rgba(104, 113, 136, .1); }
.card-border-pearl { border-color: rgba(239, 235, 217, .88); box-shadow: 0 0 20rpx rgba(239, 235, 217, .12), inset 0 0 24rpx rgba(239, 235, 217, .07); }
/* 字体与点缀色 */
.card-font-standard .player-card-name { font-family: -apple-system, "PingFang SC", sans-serif; }
.card-font-serif .player-card-name { font-family: "Songti SC", "Noto Serif CJK SC", serif; letter-spacing: 2rpx; }
.card-font-rune .player-card-name { font-family: "STKaiti", "KaiTi", serif; letter-spacing: 3rpx; }
.card-font-bold .player-card-name { font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; font-weight: 800; letter-spacing: 1rpx; }
.card-font-light .player-card-name { font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; font-weight: 300; letter-spacing: 2rpx; }
.card-font-italic .player-card-name { font-family: -apple-system, "PingFang SC", sans-serif; font-style: italic; font-weight: 600; letter-spacing: 2rpx; }
.card-font-wide .player-card-name { font-family: "Arial Black", "PingFang SC", sans-serif; font-weight: 700; letter-spacing: 5rpx; }
.card-font-compact .player-card-name { font-family: -apple-system, "PingFang SC", sans-serif; font-weight: 600; letter-spacing: -1rpx; }
.card-font-mono .player-card-name { font-family: Menlo, Consolas, monospace; font-weight: 600; letter-spacing: 1rpx; }
.card-font-round .player-card-name { font-family: "Yuanti SC", "Arial Rounded MT Bold", "PingFang SC", sans-serif; font-weight: 600; letter-spacing: 1rpx; }
.card-color-gold .player-card-name { color: #f1d18b; }
.card-color-arcane .player-card-name { color: #d3beff; }
.card-color-frost .player-card-name { color: #a9e7f2; }
.card-color-toxic .player-card-name { color: #b8ed9f; }
.card-color-ember .player-card-name { color: #ffb2a1; }
.card-color-crimson .player-card-name { color: #f08080; }
.card-color-amber .player-card-name { color: #f5b56b; }
.card-color-pink .player-card-name { color: #f4b0ca; }
.card-color-pearl .player-card-name { color: #f4efe2; }
.card-color-silver .player-card-name { color: #c8d0dc; }

/* 动画效果：全卡分层演出，内容层始终保持在上层 */
.player-card-effect { position: absolute; z-index: 1; inset: 0; overflow: hidden; border-radius: inherit; pointer-events: none; }
.effect-a, .effect-b, .effect-c { position: absolute; pointer-events: none; }
.effect-blink .effect-a { inset: 0; background: radial-gradient(circle at 72% 45%,rgba(139,71,255,.5),transparent 44%),linear-gradient(110deg,transparent 20%,rgba(79,30,140,.3),transparent 80%); animation: skill-stage 3.4s ease-in-out infinite; }
.effect-blink .effect-b { width: 150rpx; height: 150rpx; right: -15rpx; top: -55rpx; border: 5rpx solid rgba(201,145,255,.85); border-left-color: transparent; border-radius: 50%; box-shadow: 0 0 35rpx rgba(164,84,255,.75),inset 0 0 28rpx rgba(164,84,255,.5); animation: blink-gateway 3.4s ease-in-out infinite; }
.effect-blink .effect-c { width: 420rpx; height: 8rpx; left: -90rpx; top: 45%; transform: rotate(-18deg); background: linear-gradient(90deg,transparent,#fff,#c98cff,transparent); box-shadow: 0 0 18rpx #a35eff,0 0 45rpx rgba(163,94,255,.65); animation: blink-slash 3.4s ease-in-out infinite; }
.effect-bkb .effect-a { inset: 0; background: radial-gradient(circle at 72% 40%,rgba(255,198,66,.42),transparent 52%),linear-gradient(120deg,transparent,rgba(153,96,16,.2),transparent); animation: skill-stage 3.8s ease-in-out infinite; }
.effect-bkb .effect-b { width: 230rpx; height: 230rpx; right: -30rpx; top: -80rpx; border: 4rpx solid rgba(255,220,122,.9); border-radius: 48% 52% 46% 54%; background: radial-gradient(circle,rgba(255,224,135,.25),rgba(255,184,45,.05) 62%,transparent 70%); box-shadow: 0 0 40rpx rgba(255,183,45,.65),inset 0 0 35rpx rgba(255,220,122,.3); animation: bkb-dome 3.8s ease-in-out infinite; }
.effect-bkb .effect-c { width: 340rpx; height: 50rpx; left: -60rpx; top: 35%; transform: rotate(-25deg); background: linear-gradient(90deg,transparent,rgba(255,235,170,.6),transparent); animation: bkb-flare 3.8s ease-in-out infinite; }
.effect-ward .effect-a { inset: 0; background: radial-gradient(circle at 75% 45%,rgba(65,226,126,.32),transparent 54%); animation: skill-stage 3.6s ease-in-out infinite; }
.effect-ward .effect-b { width: 190rpx; height: 190rpx; right: -10rpx; top: -70rpx; border: 2rpx solid rgba(130,255,166,.72); border-radius: 50%; background: repeating-radial-gradient(circle,transparent 0 24rpx,rgba(104,245,156,.18) 25rpx 27rpx); box-shadow: 0 0 30rpx rgba(70,230,130,.4); animation: ward-radar 3.6s ease-out infinite; }
.effect-ward .effect-c { left: -20%; top: 0; width: 35%; height: 100%; transform: skewX(-15deg); background: linear-gradient(90deg,transparent,rgba(112,255,162,.5),transparent); animation: ward-sweep 3.6s ease-in-out infinite; }
.effect-arcane .effect-a { inset: 0; background: radial-gradient(circle at 72% 40%,rgba(61,224,232,.38),transparent 50%); animation: skill-stage 3.6s ease-in-out infinite; }
.effect-arcane .effect-b { width: 150rpx; height: 150rpx; right: 15rpx; top: -35rpx; border: 4rpx solid rgba(127,245,248,.88); transform: rotate(45deg); background: radial-gradient(circle,rgba(105,239,244,.22),transparent 66%); box-shadow: 0 0 35rpx rgba(68,222,230,.65),inset 0 0 25rpx rgba(127,245,248,.25); animation: arcane-sigil 3.6s ease-in-out infinite; }
.effect-arcane .effect-c { width: 18rpx; height: 18rpx; left: 20%; top: 30%; border: 2rpx solid #b9ffff; transform: rotate(45deg); box-shadow: 90rpx -35rpx 0 rgba(113,231,236,.75),180rpx 20rpx 0 rgba(113,231,236,.6),280rpx -20rpx 0 rgba(113,231,236,.7),0 0 18rpx #71e7ec; animation: arcane-stars 3.6s ease-in-out infinite; }
