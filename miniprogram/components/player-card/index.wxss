.effect-freezingfield .freezing-snowflake { position: absolute; color: #e8fdff; line-height: 1; text-shadow: 0 0 10rpx rgba(169,233,255,.8); animation-name: freezing-snowflake-fall; animation-timing-function: linear; animation-iteration-count: infinite; }
.effect-omnislash .omnislash-angle { position: absolute; width: 430rpx; height: 8rpx; pointer-events: none; }
.effect-omnislash .omnislash-blade { width: 100%; height: 100%; background: linear-gradient(90deg,transparent,#fff6cf,#ffc95e,transparent); box-shadow: 0 0 22rpx #ffc95e; animation-name: omnislash-strike; animation-timing-function: ease-in-out; animation-iteration-count: infinite; }
.effect-deathscythe .effect-a { inset: 0; background: radial-gradient(circle at 65% 35%,rgba(91,219,121,.35),rgba(10,44,24,.25) 50%,transparent 72%); animation: skill-stage 4.2s ease-in-out infinite; }
.effect-deathscythe .effect-b { width: 14rpx; height: 200rpx; right: 120rpx; top: -65rpx; border-radius: 8rpx; background: linear-gradient(90deg,#183b27,#8ac79a,#142d20); box-shadow: 0 0 18rpx rgba(128,239,153,.5); animation: death-scythe-swing 4.2s ease-in-out infinite; }
