.effect-chronosphere .effect-a { inset: 0; background: radial-gradient(circle at 72% 38%,rgba(82,128,255,.42),transparent 58%); animation: skill-stage 4s ease-in-out infinite; }
.effect-chronosphere .effect-b { width: 280rpx; height: 280rpx; right: -85rpx; top: -105rpx; border: 4rpx solid rgba(145,184,255,.85); border-radius: 50%; background: radial-gradient(circle,rgba(107,155,255,.24),rgba(44,72,161,.1) 58%,transparent 70%); box-shadow: 0 0 42rpx rgba(84,133,255,.65),inset 0 0 35rpx rgba(145,184,255,.25); animation: chronosphere-bubble 4s ease-in-out infinite; }
