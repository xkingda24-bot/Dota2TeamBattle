.player-card {
  position: relative;
  overflow: hidden;
  min-height: 194rpx;
  padding: 26rpx 28rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(230, 192, 122, .66);
  box-sizing: border-box;
  background: linear-gradient(135deg, #202838, #10151e 70%);
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, .28), inset 0 0 32rpx rgba(226, 177, 94, .07);
}
.player-card-glow {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  right: -96rpx;
  top: -172rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(220, 181, 105, .22), rgba(220, 181, 105, 0) 68%);
  pointer-events: none;
}
.player-card-content { position: relative; z-index: 2; }
.player-card-heading { display: flex; align-items: center; gap: 12rpx; }
.player-card-role { padding: 4rpx 12rpx; border-radius: 16rpx; color: #201809; background: #e2ba70; font-size: 19rpx; }
.player-card-name { flex: 1; min-width: 0; margin-top: 0; color: #f1e6cf; font-size: 38rpx; line-height: 1.2; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-card-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 12rpx; color: rgba(223, 208, 177, .83); font-size: 22rpx; }
.player-card-dota { flex: 0 1 auto; min-width: 0; margin-top: 0; color: rgba(230, 214, 183, .9); font-size: 21rpx; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-card-location { flex-shrink: 0; white-space: nowrap; }
.player-card-signature { margin-top: 10rpx; max-width: 92%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: rgba(235, 229, 216, .72); font-size: 21rpx; }
.player-card-compact { min-height: 138rpx; padding: 18rpx 22rpx; }
.player-card-compact .player-card-name { font-size: 32rpx; }
.player-card-compact .player-card-dota { font-size: 19rpx; }
.player-card-compact .player-card-meta { margin-top: 8rpx; font-size: 20rpx; }

/* 背景 */
.card-bg-arena { background: radial-gradient(ellipse at 82% 5%, rgba(213, 159, 76, .25), transparent 43%), linear-gradient(135deg, #283142, #111722 74%); }
.card-bg-dire { background: radial-gradient(ellipse at 84% 10%, rgba(190, 54, 47, .34), transparent 46%), linear-gradient(135deg, #392326, #171319 75%); }
.card-bg-ice { background: radial-gradient(ellipse at 82% 5%, rgba(86, 193, 223, .27), transparent 45%), linear-gradient(135deg, #1c3442, #10171f 75%); }
.card-bg-arcane { background: radial-gradient(ellipse at 82% 5%, rgba(137, 104, 225, .3), transparent 46%), linear-gradient(135deg, #2b2441, #12131e 75%); }
/* 边框 */
.card-border-gold { border-color: rgba(230, 192, 122, .78); }
.card-border-rune { border-color: rgba(154, 128, 232, .82); box-shadow: 0 0 0 4rpx rgba(154, 128, 232, .08), inset 0 0 24rpx rgba(154, 128, 232, .1); }
.card-border-steel { border-color: rgba(152, 177, 195, .78); box-shadow: inset 0 0 0 5rpx rgba(152, 177, 195, .06); }
/* 字体与点缀色 */
.card-font-standard .player-card-name { font-family: -apple-system, "PingFang SC", sans-serif; }
.card-font-serif .player-card-name { font-family: "Songti SC", "Noto Serif CJK SC", serif; letter-spacing: 2rpx; }
.card-font-rune .player-card-name { font-family: "STKaiti", "KaiTi", serif; letter-spacing: 3rpx; }
.card-color-gold .player-card-name { color: #f1d18b; }
.card-color-arcane .player-card-name { color: #d3beff; }
.card-color-frost .player-card-name { color: #a9e7f2; }
.card-color-toxic .player-card-name { color: #b8ed9f; }
.card-color-ember .player-card-name { color: #ffb2a1; }

/* 动画效果：纯 CSS 绘制，避免额外图片资源 */
.player-card-effect { position: absolute; z-index: 1; inset: 0; overflow: hidden; pointer-events: none; }
.effect-a, .effect-b, .effect-c { position: absolute; }
.effect-blink .effect-a { width: 88rpx; height: 88rpx; right: 54rpx; top: -28rpx; border: 4rpx solid rgba(190, 135, 255, .72); border-radius: 50%; box-shadow: 0 0 22rpx rgba(155, 87, 255, .7), inset 0 0 18rpx rgba(155, 87, 255, .55); animation: blink-portal 2.8s ease-in-out infinite; }
.effect-blink .effect-b { width: 122rpx; height: 5rpx; right: -22rpx; top: 82rpx; transform: rotate(-34deg); background: linear-gradient(90deg, transparent, #e6d2ff, #a96cff, transparent); box-shadow: 0 0 14rpx #b580ff; animation: blink-sword 2.8s ease-in-out infinite; }
.effect-blink .effect-c { width: 4rpx; height: 4rpx; right: 32rpx; top: 92rpx; border-radius: 50%; background: #fff; box-shadow: 22rpx -38rpx 0 2rpx #c19aff, 60rpx -18rpx 0 1rpx #e5d3ff; animation: spark 1.8s ease-in-out infinite; }
.effect-bkb .effect-a { width: 170rpx; height: 170rpx; right: -35rpx; top: -72rpx; border: 3rpx solid rgba(255, 211, 106, .8); border-radius: 48% 52% 46% 54%; background: radial-gradient(ellipse, rgba(255, 220, 120, .17), transparent 68%); box-shadow: 0 0 28rpx rgba(255, 186, 56, .55), inset 0 0 25rpx rgba(255, 211, 106, .18); animation: shield 3.2s ease-in-out infinite; }
.effect-bkb .effect-b { width: 4rpx; height: 145rpx; right: 63rpx; top: -18rpx; transform: rotate(45deg); background: linear-gradient(transparent, rgba(255, 231, 166, .75), transparent); animation: shield-ray 2.6s ease-in-out infinite; }
.effect-ward .effect-a { width: 148rpx; height: 148rpx; right: 0; top: -18rpx; border: 2rpx solid rgba(99, 230, 149, .5); border-radius: 50%; background: repeating-radial-gradient(circle, transparent 0 22rpx, rgba(99, 230, 149, .13) 23rpx 24rpx); }
.effect-ward .effect-b { width: 160rpx; height: 35rpx; right: -8rpx; top: 35rpx; background: linear-gradient(180deg, transparent, rgba(104, 245, 156, .34), transparent); animation: ward-scan 2.4s ease-in-out infinite; }
.effect-ward .effect-c { width: 12rpx; height: 12rpx; right: 62rpx; top: 44rpx; border-radius: 50%; background: #a5ffc4; box-shadow: 0 0 16rpx #58ef95; animation: spark 1.7s ease-in-out infinite; }
.effect-illusion .effect-a, .effect-illusion .effect-b { width: 40rpx; height: 82rpx; top: 6rpx; right: 65rpx; border: 2rpx solid rgba(190, 196, 255, .76); border-radius: 45% 45% 18% 18%; background: linear-gradient(rgba(193, 198, 255, .34), rgba(130, 135, 220, .03)); box-shadow: 0 0 16rpx rgba(152, 158, 255, .45); animation: illusion-left 2.8s ease-in-out infinite; }
.effect-illusion .effect-b { right: 20rpx; border-color: rgba(227, 184, 255, .73); animation-name: illusion-right; }
.effect-roshan .effect-a, .effect-roshan .effect-b { width: 110rpx; height: 54rpx; right: -20rpx; bottom: -30rpx; border: 3rpx solid rgba(255, 97, 64, .77); border-radius: 50%; box-shadow: 0 0 20rpx rgba(237, 66, 46, .6); animation: roshan-wave 2.3s ease-out infinite; }
.effect-roshan .effect-b { animation-delay: 1.15s; }
.effect-roshan .effect-c { width: 95rpx; height: 3rpx; right: 2rpx; bottom: 39rpx; transform: rotate(-12deg); background: linear-gradient(90deg, transparent, #ff7b58, transparent); animation: roshan-crack 1.9s ease-in-out infinite; }
.effect-arcane .effect-a, .effect-arcane .effect-b, .effect-arcane .effect-c { width: 18rpx; height: 18rpx; right: 48rpx; top: 27rpx; border: 2rpx solid rgba(113, 231, 236, .85); transform: rotate(45deg); box-shadow: 0 0 14rpx rgba(80, 235, 240, .72); animation: rune-flicker 1.8s ease-in-out infinite; }
.effect-arcane .effect-b { right: 84rpx; top: 69rpx; animation-delay: .6s; }
.effect-arcane .effect-c { right: 20rpx; top: 88rpx; animation-delay: 1.1s; }
@keyframes blink-portal { 0%, 100% { transform: scale(.78); opacity: .55; } 50% { transform: scale(1.12); opacity: 1; } }
@keyframes blink-sword { 0%, 20% { opacity: 0; transform: translateX(32rpx) rotate(-34deg); } 48%, 70% { opacity: 1; transform: translateX(-12rpx) rotate(-34deg); } 100% { opacity: 0; transform: translateX(-44rpx) rotate(-34deg); } }
@keyframes spark { 0%, 100% { opacity: .25; transform: scale(.7); } 50% { opacity: 1; transform: scale(1.35); } }
@keyframes shield { 0%, 100% { transform: scale(.92); opacity: .55; } 50% { transform: scale(1.04); opacity: 1; } }
@keyframes shield-ray { 0%, 100% { opacity: .1; } 50% { opacity: .8; } }
@keyframes ward-scan { 0% { transform: translateY(-25rpx); opacity: .15; } 50% { opacity: .85; } 100% { transform: translateY(72rpx); opacity: .1; } }
@keyframes illusion-left { 0%, 100% { opacity: .8; transform: translateX(0) scale(.9); } 55% { opacity: .4; transform: translateX(26rpx) scale(1.03); } }
@keyframes illusion-right { 0%, 100% { opacity: .65; transform: translateX(0) scale(.92); } 55% { opacity: .25; transform: translateX(-26rpx) scale(1.02); } }
@keyframes roshan-wave { 0% { transform: scale(.45); opacity: .9; } 100% { transform: scale(1.8); opacity: 0; } }
@keyframes roshan-crack { 0%, 100% { opacity: .2; transform: scaleX(.5) rotate(-12deg); } 50% { opacity: .95; transform: scaleX(1) rotate(-12deg); } }
@keyframes rune-flicker { 0%, 100% { opacity: .2; transform: rotate(45deg) scale(.65); } 50% { opacity: 1; transform: rotate(225deg) scale(1.25); } }
