.effect-reincarnation .reincarnation-cross { position: absolute; color: #79ee8f; line-height: 1; text-shadow: 0 0 10rpx rgba(91,238,124,.7); animation-name: reincarnation-cross-rise; animation-timing-function: linear; animation-iteration-count: infinite; }
.effect-sunstrike .effect-a { inset: 0; background: radial-gradient(circle at 75% 35%,rgba(215,164,81,.22),transparent 58%); animation: skill-stage 3.4s ease-in-out infinite; }
