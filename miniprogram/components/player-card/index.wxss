.effect-eclipse .effect-a { inset: 0; background: radial-gradient(circle at 68% 18%,rgba(202,190,226,.18),transparent 36%),linear-gradient(160deg,rgba(38,23,72,.38),rgba(104,77,153,.12),rgba(20,15,43,.42)); animation: eclipse-stage 6s ease-in-out infinite; }
.effect-eclipse .effect-b { width: 110rpx; height: 110rpx; right: 45rpx; top: -30rpx; border-radius: 50%; background: radial-gradient(circle at 38% 35%,#c9c0d8 0 8%,#aa9cbb 25%,#756984 58%,#40374f 76%); box-shadow: 0 0 24rpx rgba(202,190,226,.32),0 0 52rpx rgba(153,125,210,.2); animation: eclipse-moon 6s ease-in-out infinite; }
.effect-eclipse .eclipse-beam { position: absolute; top: -30%; width: 20rpx; height: 190rpx; background: linear-gradient(180deg,transparent,#fff 38%,#d7c7ff 68%,transparent); box-shadow: 0 0 20rpx #e2d5ff,0 0 45rpx rgba(176,143,238,.6); animation-name: eclipse-beam-fall; animation-timing-function: ease-in; animation-iteration-count: infinite; }
.effect-lagunablade .effect-a { inset: 0; background: radial-gradient(circle at 48% 50%,rgba(255,100,48,.48),rgba(134,23,29,.2) 45%,transparent 72%); animation: laguna-stage 4.2s ease-in-out infinite; }
