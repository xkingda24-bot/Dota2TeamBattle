.ban-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, .76);
}
.ban-panel {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 181, 111, .24);
  border-radius: 16rpx;
  background: linear-gradient(180deg, #171d29, #12161f);
}
.ban-title { color: #e8c27c; font-size: 34rpx; font-weight: 700; text-align: center; }
.ban-user { margin-top: 22rpx; color: #e8e4da; font-size: 30rpx; font-weight: 600; }
.ban-dota-id { margin-top: 6rpx; color: #98a0ab; font-size: 23rpx; }
.ban-label { margin: 24rpx 0 12rpx; color: #c9c3b6; font-size: 25rpx; }
.ban-label text { color: #e4776d; }
.ban-durations { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ban-duration {
  flex: 1;
  min-width: 100rpx;
  padding: 16rpx 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 181, 111, .18);
  border-radius: 10rpx;
  color: #aab2bd;
  background: #1a2130;
  font-size: 25rpx;
  text-align: center;
}
.ban-duration-active { border-color: #e8c27c; color: #e8c27c; background: rgba(224, 181, 111, .14); font-weight: 600; }
.ban-reason {
  width: 100%;
  height: 170rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 181, 111, .14);
  border-radius: 10rpx;
  color: #e8e4da;
  background: #1a2130;
  font-size: 26rpx;
  line-height: 1.5;
}
.ban-placeholder { color: #8994a3; }
.ban-count { margin-top: 6rpx; color: #77818e; font-size: 21rpx; text-align: right; }
.ban-effect { margin-top: 16rpx; padding: 16rpx; border-radius: 8rpx; color: #d4bd8d; background: rgba(224, 181, 111, .08); font-size: 23rpx; line-height: 1.5; }
.ban-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.ban-btn { flex: 1; padding: 17rpx 0; border-radius: 10rpx; font-size: 28rpx; font-weight: 600; text-align: center; }
.ban-btn-cancel { border: 1rpx solid rgba(224, 181, 111, .25); color: #c8c2b5; background: #1a2130; }
.ban-btn-confirm { color: #ffe4df; background: linear-gradient(135deg, #c55443, #94362d); }
.ban-btn-disabled { opacity: .45; }
