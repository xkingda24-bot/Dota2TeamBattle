/* components/bracket-type-sheet/index.wxss - 赛制选择底部弹层（复用 app.wxss 的深色金边视觉） */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.7);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.22s ease, visibility 0s linear 0.22s;
}

.sheet-mask.is-open {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.22s ease, visibility 0s linear 0s;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 32rpx 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(224, 181, 111, 0.22);
  border-radius: 28rpx 28rpx 0 0;
  background: linear-gradient(180deg, #1b2231 0%, #12161f 100%);
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.22, 0.9, 0.3, 1);
}

.sheet-mask.is-open .sheet {
  transform: translateY(0);
}

.sheet-handle {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #e8e4da;
}

.sheet-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #98a0ab;
}

.format-list {
  margin-top: 26rpx;
}

.format-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(224, 181, 111, 0.14);
  border-radius: 20rpx;
  background: #161c27;
  transition: border-color 0.18s ease, background-color 0.18s ease;
}

.format-card:first-child {
  margin-top: 0;
}

.format-card.is-picked {
  border-color: #e8c27c;
  background: rgba(224, 181, 111, 0.1);
}

.format-card-hover {
  background: #1b2331;
}

.format-card.is-picked.format-card-hover {
  background: rgba(224, 181, 111, 0.16);
}

.format-head {
  display: flex;
  align-items: center;
}

.format-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8e4da;
}

.format-badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(224, 181, 111, 0.16);
  color: #d9c089;
  font-size: 20rpx;
  line-height: 1.6;
}

.format-radio {
  margin-left: auto;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 181, 111, 0.4);
  border-radius: 50%;
  transition: background-color 0.18s ease, border-color 0.18s ease;
}

.format-card.is-picked .format-radio {
  border-color: #e8c27c;
  background: #e8c27c;
}

.format-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #98a0ab;
}

.format-figure {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.format-lanes {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  min-height: 60rpx;
}

.lane-row {
  display: flex;
  align-items: center;
}

.lane-row + .lane-row {
  margin-top: 10rpx;
}

.lane-label {
  flex: none;
  width: 88rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #8b93a1;
}

.lane-label-dim {
  color: #7f8997;
}

.lane-segs {
  display: flex;
  align-items: center;
}

.seg {
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
}

.seg-3 {
  width: 46rpx;
}

.seg-2 {
  width: 46rpx;
}

.seg-1 {
  width: 46rpx;
}

.seg-gold .seg-3 {
  background: rgba(232, 194, 124, 0.78);
}

.seg-gold .seg-2 {
  background: rgba(232, 194, 124, 0.52);
}

.seg-gold .seg-1 {
  background: rgba(232, 194, 124, 0.32);
}

.seg-dim .seg {
  height: 10rpx;
}

.seg-dim .seg-3 {
  background: rgba(150, 162, 178, 0.55);
}

.seg-dim .seg-2 {
  background: rgba(150, 162, 178, 0.38);
}

.seg-dim .seg-1 {
  background: rgba(150, 162, 178, 0.24);
}

.final-box {
  flex: none;
  margin-left: 16rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(232, 194, 124, 0.45);
  border-radius: 10rpx;
  color: #e8c27c;
  font-size: 22rpx;
  line-height: 1.4;
}

.format-rank {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6f7785;
}

.sheet-picked {
  margin-top: 26rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #98a0ab;
}

.sheet-picked.is-picked {
  color: #e8c27c;
}

.sheet-actions {
  display: flex;
  margin-top: 20rpx;
}

/* 自定义组件默认样式隔离，app.wxss 的 .btn 系列在这里不生效，按钮样式必须自带 */
.sheet-btn {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 92rpx;
  box-sizing: border-box;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.4;
}

.sheet-actions .sheet-btn + .sheet-btn {
  margin-left: 16rpx;
}

.sheet-btn-main {
  background: linear-gradient(135deg, #e5b96f, #b98a3e);
  color: #241a08;
}

.sheet-btn-main.is-disabled {
  background: #232a38;
  color: #6d7480;
}

.sheet-btn-ghost {
  border: 1rpx solid rgba(224, 181, 111, 0.28);
  background: #1a2130;
  color: #dcd6c8;
}

.sheet-btn-hover {
  opacity: 0.86;
}
