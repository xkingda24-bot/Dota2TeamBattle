<view class="tab-bar">
  <view class="tab-bar-items">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{selected === index ? 'tab-item-active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
      hover-class="tab-item-pressed"
    >
      <view class="tab-indicator"></view>
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
  <view class="tab-safe-area"></view>
</view>
