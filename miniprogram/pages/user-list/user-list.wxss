/* pages/user-list/user-list.wxss - 超管用户列表：统计概览 + 权限名册 + 用户管理 */

/* ---------- 统计概览 ---------- */
.stats-card {
  display: flex;
  align-items: center;
  padding: 30rpx 12rpx;
}
.stat-item {
  flex: 1;
  min-width: 0;
  text-align: center;
}
.stat-num {
  color: #e8c27c;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.stat-num-sub {
  color: #8d96a3;
  font-size: 24rpx;
  font-weight: 400;
}
.stat-label {
  margin-top: 8rpx;
  color: #98a0ab;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(224, 181, 111, 0.16);
}
.stat-item-toggle {
  padding: 6rpx 0;
  border-radius: 12rpx;
}
.stat-item-pressed { opacity: .6; }
.stat-item-expanded .stat-label { color: #e8c27c; }

/* ---------- 搜索与排序 ---------- */
.user-search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(224, 181, 111, 0.22);
  border-radius: 999rpx;
  background: #1a2130;
}
.user-search-icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}
.user-search-input {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  min-height: 84rpx;
  font-size: 26rpx;
}
.user-search-clear {
  flex-shrink: 0;
  padding: 12rpx 4rpx;
  color: #e8c27c;
  font-size: 23rpx;
}
.sort-label {
  margin-top: 24rpx;
  color: #98a0ab;
  font-size: 22rpx;
}
.user-sort-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 14rpx 0 4rpx;
}
.user-sort-option {
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(224, 181, 111, 0.2);
  border-radius: 999rpx;
  background: #1a2130;
  color: #b9c0ca;
  font-size: 22rpx;
}
.user-sort-active {
  border-color: rgba(224, 181, 111, 0.72);
  background: rgba(224, 181, 111, 0.15);
  color: #e8c27c;
}

/* ---------- 用户行：头像 + 信息 + 操作 ---------- */
.user-list-card {
  padding-top: 12rpx;
}
.admin-user-row {
  padding: 22rpx 20rpx;
  border: 1rpx solid rgba(224, 181, 111, 0.28);
  border-radius: 16rpx;
  background: rgba(224, 181, 111, 0.04);
}
.admin-user-row + .admin-user-row {
  margin-top: 16rpx;
}
.admin-user-row-pressed { opacity: .65; }
.user-list-tip {
  padding: 6rpx 4rpx 14rpx;
  color: #8b939f;
  font-size: 22rpx;
}
.admin-user-info {
  flex: 1;
  min-width: 0;
}
.admin-user-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
  row-gap: 8rpx;
}
.user-nick {
  min-width: 0;
  max-width: 100%;
  color: #e8e4da;
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.admin-user-heading .tag {
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}
.admin-user-meta {
  margin-top: 8rpx;
  color: #a5adba;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}
.tag-ban { margin-left: 12rpx; color: #eda293; background: rgba(196, 92, 75, .15); }

/* ---------- 分页 ---------- */
.user-page-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 20rpx;
}
.user-page-controls .btn-small {
  border-radius: 999rpx;
}
.user-page-text {
  flex: 1;
  color: #e8c27c;
  text-align: center;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

/* ---------- 权限名册 chips ---------- */
.roster-expand-card .admin-roster-chips { margin-bottom: 6rpx; }
.admin-roster-tip { margin-top: 6rpx; color: #8b939f; font-size: 20rpx; }
.admin-roster-head { color: rgba(223, 208, 177, .86); font-size: 24rpx; font-weight: 600; }
.admin-roster-empty { margin-top: 10rpx; color: #8b939f; font-size: 22rpx; }
.admin-roster-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.admin-roster-chip { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 8rpx 6rpx 18rpx; border-radius: 999rpx; border: 1rpx solid rgba(152, 177, 195, .4); background: rgba(152, 177, 195, .1); color: #cbd7e2; font-size: 22rpx; }
.admin-roster-name { max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 名册里的小「×」：点一下取消该管理员（带二次确认） */
.admin-roster-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(214, 96, 87, .3);
  border: 2rpx solid rgba(224, 118, 108, .75);
  color: #ffd0ca;
  font-size: 26rpx;
  line-height: 1;
}
.admin-roster-remove-disabled { opacity: .4; }
