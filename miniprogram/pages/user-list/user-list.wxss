/* pages/user-list/user-list.wxss - 超管用户列表（独立页面，原 staff 弹窗样式迁移） */
.user-search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.user-search-input {
  flex: 1;
  min-width: 0;
  margin: 0;
}
.user-search-clear {
  flex-shrink: 0;
  padding: 12rpx 4rpx;
  color: #e8c27c;
  font-size: 23rpx;
}
.sort-label {
  margin-top: 24rpx;
  color: #98a0ab;
  font-size: 22rpx;
}
.user-sort-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 12rpx 0 8rpx;
}
.user-sort-option {
  padding: 10rpx 15rpx;
  border: 1rpx solid rgba(224, 181, 111, 0.2);
  border-radius: 10rpx;
  background: #1a2130;
  color: #b9c0ca;
  font-size: 21rpx;
}
.user-sort-active {
  border-color: rgba(224, 181, 111, 0.72);
  background: rgba(224, 181, 111, 0.15);
  color: #e8c27c;
}
.admin-user-row {
  padding: 18rpx 4rpx;
  border-bottom: 1rpx solid rgba(224, 181, 111, 0.12);
}
.admin-user-info {
  min-width: 0;
}
.admin-user-heading {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
  row-gap: 6rpx;
}
.user-nick {
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  color: #e8e4da;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.admin-user-meta {
  margin-top: 7rpx;
  color: #a5adba;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-all;
}
.admin-user-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 14rpx;
}
.admin-user-actions .btn-small {
  min-width: 132rpx;
  text-align: center;
}
.btn-small.btn-ban {
  border: 1rpx solid rgba(196, 92, 75, .45);
  color: #e7a294;
  background: rgba(196, 92, 75, .1);
}
.tag-ban { margin-left: 12rpx; color: #eda293; background: rgba(196, 92, 75, .15); }
.user-page-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 16rpx;
}
.user-page-text {
  flex: 1;
  color: #b9c0ca;
  text-align: center;
  font-size: 22rpx;
}

/* 普通管理员名册：页面顶部直接展示，不用翻页找蓝色标签 */
.admin-roster { margin: 10rpx 0 2rpx; }
.create-permission-roster { margin-top: 18rpx; }
.admin-roster-tip { margin-top: 6rpx; color: #8b939f; font-size: 20rpx; }
.admin-roster-head { color: rgba(223, 208, 177, .86); font-size: 22rpx; font-weight: 600; }
.admin-roster-empty { margin-top: 8rpx; color: #8b939f; font-size: 22rpx; }
.admin-roster-chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.admin-roster-chip { display: flex; align-items: center; gap: 10rpx; padding: 4rpx 8rpx 4rpx 16rpx; border-radius: 999rpx; border: 1rpx solid rgba(152, 177, 195, .5); background: rgba(152, 177, 195, .12); color: #cbd7e2; font-size: 22rpx; }
.admin-roster-name { max-width: 260rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
/* 名册里的小「×」：点一下取消该管理员（带二次确认） */
.admin-roster-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(214, 96, 87, .3);
  border: 2rpx solid rgba(224, 118, 108, .75);
  color: #ffd0ca;
  font-size: 28rpx;
  line-height: 1;
}
.admin-roster-remove-disabled { opacity: .4; }
