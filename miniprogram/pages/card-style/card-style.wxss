.card-style-page { padding-bottom: 48rpx; }
.card-style-nav { position: sticky; z-index: 91; top: 0; }
.card-style-intro { padding: 34rpx 28rpx 0; border: 1rpx solid rgba(224,181,111,.18); border-bottom: 0; border-radius: 18rpx 18rpx 0 0; background: radial-gradient(ellipse at 94% 0%, rgba(120,86,190,.22), transparent 38%), linear-gradient(160deg,#1a2230,#11161e 72%); }
.card-preview-sticky { position: sticky; z-index: 90; padding: 0 28rpx 26rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(224,181,111,.18); border-top: 0; border-radius: 0 0 18rpx 18rpx; background: linear-gradient(160deg,#1a2230,#11161e 72%); box-shadow: 0 12rpx 28rpx rgba(0,0,0,.22); }
.card-style-kicker { color: #a79877; font-size: 20rpx; letter-spacing: 4rpx; }
.card-style-heading { margin-top: 10rpx; color: #edd5a4; font-size: 36rpx; font-weight: 700; }
.card-style-copy { margin: 8rpx 0 0; color: #9ca4b0; font-size: 23rpx; line-height: 1.6; }
.preview-caption { margin-top: 14rpx; color: #777f8b; text-align: right; font-size: 20rpx; }
.style-section { padding: 24rpx 22rpx; margin-bottom: 18rpx; border: 1rpx solid rgba(224,181,111,.1); border-radius: 14rpx; background: rgba(21,27,37,.86); }
.style-heading { margin-bottom: 18rpx; color: #dfc68f; font-size: 28rpx; font-weight: 600; }
.option-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.style-option { min-width: 0; padding: 12rpx; border: 1rpx solid rgba(255,255,255,.07); border-radius: 12rpx; background: #141a24; }
.style-option-active { border-color: #dbb56c; background: rgba(219,181,108,.09); box-shadow: 0 0 0 2rpx rgba(219,181,108,.09); }
.option-swatch { height: 70rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.swatch-arena { background: radial-gradient(circle at 75% 10%,#aa7b38,transparent 42%),linear-gradient(120deg,#3d4854,#121722); }
.swatch-dire { background: radial-gradient(circle at 75% 10%,#aa3a32,transparent 42%),linear-gradient(120deg,#4b2929,#17131a); }
.swatch-ice { background: radial-gradient(circle at 75% 10%,#54a9bc,transparent 42%),linear-gradient(120deg,#24404b,#121923); }
.swatch-arcane { background: radial-gradient(circle at 75% 10%,#8061bd,transparent 42%),linear-gradient(120deg,#372c52,#131520); }
.swatch-river { background: radial-gradient(circle at 24% 12%,#4aaebe,transparent 44%),linear-gradient(120deg,#1c4854,#101d27); }
.swatch-forest { background: radial-gradient(circle at 80% 8%,#568b55,transparent 42%),linear-gradient(120deg,#263f32,#111b18); }
.swatch-lava { background: radial-gradient(circle at 76% 12%,#d66a38,transparent 44%),linear-gradient(120deg,#533027,#1c1516); }
.swatch-moon { background: radial-gradient(circle at 76% 10%,#9aa9cf,transparent 40%),linear-gradient(120deg,#30394f,#121621); }
.swatch-desert { background: radial-gradient(circle at 76% 10%,#c59b58,transparent 42%),linear-gradient(120deg,#51432f,#1b1917); }
.option-name { color: #e0d4bb; font-size: 24rpx; }
.choice-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10rpx; }
.choice-chip { display: flex; align-items: center; justify-content: center; gap: 6rpx; min-width: 0; min-height: 52rpx; box-sizing: border-box; padding: 12rpx 4rpx; border: 1rpx solid rgba(255,255,255,.09); border-radius: 30rpx; color: #aab0ba; background: #151b25; font-size: 20rpx; line-height: 1.2; white-space: nowrap; }
.choice-chip-active { color: #ecd49c; border-color: rgba(224,181,111,.7); background: rgba(224,181,111,.1); }
.color-dot { flex: none; width: 14rpx; height: 14rpx; border-radius: 50%; }
.color-gold { background: #e8c27c; }
.color-arcane { background: #b99cff; }
.color-frost { background: #8fe0ed; }
.color-toxic { background: #a9df89; }
.color-ember { background: #ff927c; }
.color-crimson { background: #f08080; }
.color-amber { background: #f5b56b; }
.color-pink { background: #f4b0ca; }
.color-pearl { background: #f4efe2; }
.color-silver { background: #c8d0dc; }
.style-hint { margin: -8rpx 0 18rpx; line-height: 1.5; }
.animation-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10rpx; }
.animation-option { display: flex; align-items: center; min-width: 0; min-height: 82rpx; box-sizing: border-box; padding: 12rpx 10rpx; border: 1rpx solid rgba(255,255,255,.07); border-radius: 12rpx; background: #141a24; }
.animation-option-active { border-color: rgba(224,181,111,.68); background: linear-gradient(90deg,rgba(224,181,111,.12),rgba(24,30,41,.7)); }
.animation-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-right: 10rpx; border-radius: 12rpx; color: #d6c098; background: rgba(224,181,111,.1); font-size: 28rpx; }
.animation-icon-blink { color: #c69aff; background: rgba(153,104,229,.15); }
.animation-icon-bkb { color: #f5ca62; background: rgba(231,176,54,.15); }
.animation-icon-ward { color: #82e89b; background: rgba(76,203,111,.13); }
.animation-icon-arcane { color: #7de5e8; background: rgba(68,198,205,.15); }
.animation-icon-blackhole { color: #c29aff; background: rgba(104,63,159,.2); }
.animation-icon-thunder { color: #9fc8ff; background: rgba(78,137,220,.17); }
.animation-icon-chronosphere { color: #93b9ff; background: rgba(75,112,207,.17); }
.animation-icon-reincarnation { color: #9be69a; background: rgba(78,165,83,.16); }
.animation-icon-sunstrike { color: #ffd27c; background: rgba(229,151,51,.17); }
.animation-icon-freezingfield { color: #b9f3ff; background: rgba(80,174,211,.18); }
.animation-icon-omnislash { color: #ffe19a; background: rgba(223,171,64,.18); }
.animation-icon-deathscythe { color: #9be7ac; background: rgba(45,119,68,.2); }
.animation-icon-ghostship { color: #a8e5ef; background: rgba(58,137,164,.18); }
.animation-icon-eclipse { color: #e0d5ff; background: rgba(119,91,182,.2); }
.animation-icon-lagunablade { color: #ffac91; background: rgba(217,73,45,.2); }
.animation-icon-haunt { color: #d1a8f2; background: rgba(91,50,126,.22); }
.animation-icon-chainfrost { color: #bdeeff; background: rgba(63,145,190,.2); }
.animation-copy { flex: 1; min-width: 0; }.animation-name { color: #e1d7c5; font-size: 22rpx; }
.animation-check { flex: none; width: 24rpx; color: #e8c27c; font-size: 26rpx; text-align: center; }
.style-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }.style-actions .btn { flex: 1; margin: 0; }
.reset-btn { background: #191f2b; color: #aaaeb6; border: 1rpx solid rgba(255,255,255,.1); }.save-btn { box-shadow: 0 8rpx 22rpx rgba(181,132,57,.18); }
.style-footnote { padding: 16rpx 10rpx; color: #727b89; font-size: 20rpx; line-height: 1.55; text-align: center; }
