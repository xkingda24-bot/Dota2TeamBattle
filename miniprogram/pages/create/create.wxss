.create-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 100% 0%, rgba(183,130,62,.09), transparent 34%), linear-gradient(180deg,#0d121b 0%,#0a0e15 100%);
}
.form-heading { padding: 12rpx 6rpx 26rpx; }
.form-kicker { color:#d7b46f; font-size:19rpx; font-weight:700; letter-spacing:4rpx; }
.form-title { margin-top:12rpx; color:#f3efe6; font-size:40rpx; font-weight:700; letter-spacing:1rpx; }
.form-intro { max-width:650rpx; margin-top:10rpx; color:#8f9baa; font-size:23rpx; line-height:1.65; }
.form-card { margin-bottom:20rpx; padding:28rpx 26rpx; border-color:rgba(213,183,124,.13); border-radius:18rpx; }
.card-heading { display:flex; align-items:center; margin-bottom:26rpx; }
.step-number { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border:1rpx solid rgba(218,181,103,.36); border-radius:15rpx; color:#e0bf78; background:rgba(194,146,69,.1); font-size:21rpx; font-weight:700; letter-spacing:1rpx; }
.card-heading-copy { margin-left:16rpx; }
.form-card .card-title { margin:0; color:#ede4d1; font-size:29rpx; }
.card-caption { margin-top:5rpx; color:#7f8a98; font-size:21rpx; }
.field { margin-bottom:28rpx; }
.label { margin-bottom:12rpx; color:#d0d7e0; font-size:25rpx; font-weight:600; letter-spacing:.3rpx; }
.input { min-height:96rpx; padding:20rpx 24rpx; border:2rpx solid rgba(213,181,111,.48); border-radius:14rpx; background:#1a2635; color:#f1eee7; font-size:28rpx; box-shadow:inset 0 2rpx 5rpx rgba(0,0,0,.22); }
.input:focus { border-color:#d9b96f; background:#1d2b3b; box-shadow:0 0 0 3rpx rgba(217,185,111,.14),inset 0 2rpx 5rpx rgba(0,0,0,.2); }
.field-hint { margin-top:9rpx; color:#95a2b1; font-size:21rpx; line-height:1.45; }
.field-pair { display:flex; gap:18rpx; }
.field-half { min-width:0; flex:1; }
.picker { min-height:96rpx; padding:16rpx 18rpx 16rpx 24rpx; border:2rpx solid rgba(213,181,111,.48); border-radius:14rpx; background:#1a2635; box-shadow:inset 0 2rpx 5rpx rgba(0,0,0,.22); font-size:27rpx; box-sizing:border-box; }
.picker-control { display:flex; align-items:center; justify-content:space-between; }
.picker-value { color:#f1eee7; font-size:28rpx; font-weight:500; }
.picker-chevron { display:flex; flex:none; align-items:center; justify-content:center; width:42rpx; height:42rpx; margin-left:14rpx; border:1rpx solid rgba(220,188,124,.38); border-radius:10rpx; color:#e2c477; background:rgba(194,146,69,.13); font-size:30rpx; line-height:1; }
.form-control-pressed { border-color:#e5c474; background:#243347; opacity:.95; }
.capacity-card { margin-top:10rpx; padding:22rpx 20rpx; border:1rpx solid rgba(215,181,111,.14); border-radius:14rpx; background:linear-gradient(135deg,rgba(196,151,72,.08),rgba(39,61,78,.15)); }
.capacity-title { color:#d9c38d; font-size:22rpx; font-weight:600; }
.capacity-values { display:flex; align-items:center; justify-content:space-around; margin-top:18rpx; }
.capacity-item { display:flex; flex:1; flex-direction:column; align-items:center; }
.capacity-number { color:#f0d797; font-size:34rpx; font-weight:700; line-height:1.1; }
.capacity-label { margin-top:7rpx; color:#8592a1; font-size:20rpx; }
.capacity-divider { width:1rpx; height:44rpx; background:rgba(218,190,133,.15); }
.capacity-note { margin-top:17rpx; padding-top:14rpx; border-top:1rpx solid rgba(218,190,133,.1); color:#8f9baa; font-size:21rpx; line-height:1.55; }
.edit-note { display:flex; align-items:flex-start; margin-top:18rpx; padding:15rpx 16rpx; border-radius:11rpx; color:#a4a090; background:rgba(204,162,84,.08); font-size:20rpx; line-height:1.5; }
.note-icon { display:flex; flex:none; align-items:center; justify-content:center; width:28rpx; height:28rpx; margin-right:10rpx; border:1rpx solid rgba(215,181,111,.4); border-radius:50%; color:#dfbd73; font-size:18rpx; font-weight:700; }
.submit-button { display:flex; align-items:center; justify-content:space-between; margin-top:28rpx; padding:22rpx 25rpx 22rpx 29rpx; border-radius:13rpx; color:#21180b; background:linear-gradient(110deg,#efd79f,#c79c52); box-shadow:0 8rpx 22rpx rgba(0,0,0,.22); font-size:27rpx; font-weight:700; }
.submit-arrow { font-size:38rpx; font-weight:400; line-height:1; }
.button-disabled { opacity:.58; }
.button-pressed { opacity:.7; transform:scale(.99); }
.form-bottom-note { padding:34rpx 0 12rpx; color:#596474; font-size:18rpx; letter-spacing:3rpx; text-align:center; }
.form-bottom-note text { margin:0 8rpx; color:#a17c43; }
.gate-card { margin-top:35rpx; padding:48rpx 30rpx; border:1rpx solid rgba(213,183,124,.14); border-radius:18rpx; background:linear-gradient(145deg,#172230,#111923); text-align:center; }
.gate-orbit { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; margin:0 auto; border:1rpx solid rgba(224,181,111,.28); border-radius:50%; color:#e0bf78; background:rgba(194,146,69,.1); font-size:31rpx; }
.gate-title { margin-top:20rpx; color:#e9e4d8; font-size:29rpx; font-weight:600; }
.gate-desc { margin-top:10rpx; color:#8f9baa; font-size:22rpx; line-height:1.55; }
.gate-skeleton { width:44%; height:9rpx; margin:28rpx auto 0; border-radius:9rpx; background:linear-gradient(90deg,#8c6b3a,#e0bd73,#8c6b3a); background-size:220% 100%; animation:gate-shimmer 1.5s ease-in-out infinite; }
.gate-error { border-color:rgba(216,117,101,.2); }
.gate-error .gate-orbit { border-color:rgba(216,117,101,.34); color:#e0a39a; background:rgba(169,63,54,.1); }
.retry-button { display:inline-block; margin-top:25rpx; padding:13rpx 28rpx; border:1rpx solid rgba(224,181,111,.25); border-radius:9rpx; color:#e0bf78; font-size:22rpx; }
@keyframes gate-shimmer { 0% { background-position:100% 0; } 100% { background-position:-100% 0; } }
@media (prefers-reduced-motion: reduce) { .gate-skeleton { animation:none; } }
