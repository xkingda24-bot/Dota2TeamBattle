/* pages/history/history.wxss - Dota2 风格 */
.load-state, .load-error { padding-top: 34rpx; padding-bottom: 34rpx; }
.load-error { border-color: rgba(216,117,101,.2); }
.load-error .card-title { color: #e0a39a; }
.history-list-card { position: relative; }
.history-delete { margin-top: 14rpx; width: 100%; box-sizing: border-box; border: 0; }
.champion-banner {
  background: linear-gradient(135deg, rgba(224, 181, 111, 0.28), rgba(200, 69, 47, 0.12));
  border: 2rpx solid rgba(224, 181, 111, 0.5);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  color: #e8c27c;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
}
.match-card {
  border-left: 6rpx solid #e8c27c;
}
.match-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8e4da;
}
.vs-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.team {
  flex: 1;
  font-size: 28rpx;
  color: #e8e4da;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-win {
  color: #e8c27c;
  font-weight: 600;
}
.vs-center {
  width: 140rpx;
  text-align: center;
}
.vs-text {
  font-size: 24rpx;
  color: #6d7480;
}
.score {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8c27c;
}
.team-block {
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(224, 181, 111, 0.08);
}
.team-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8c27c;
  margin-bottom: 6rpx;
}
.history-members { margin-top: 12rpx; }
.history-members .player-card { margin-top: 12rpx; }
.history-members .player-card:first-child { margin-top: 0; }
