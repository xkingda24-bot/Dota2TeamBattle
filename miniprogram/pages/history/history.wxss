/* pages/history/history.wxss */
.champion-banner {
  background: linear-gradient(90deg, rgba(255, 107, 53, 0.25), rgba(255, 107, 53, 0.1));
  border: 2rpx solid rgba(255, 107, 53, 0.5);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  color: #ffb38a;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}
.match-card {
  border-left: 6rpx solid #ff6b35;
}
.match-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #f0f2f5;
}
.vs-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.team {
  flex: 1;
  font-size: 28rpx;
  color: #e8eaed;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-win {
  color: #57d68d;
  font-weight: 600;
}
.vs-center {
  width: 140rpx;
  text-align: center;
}
.vs-text {
  font-size: 24rpx;
  color: #6b7583;
}
.score {
  font-size: 34rpx;
  font-weight: 700;
  color: #f0f2f5;
}
.team-block {
  padding: 14rpx 4rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.06);
}
.team-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ff8a5c;
  margin-bottom: 6rpx;
}
