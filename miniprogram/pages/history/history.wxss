/* pages/history/history.wxss - 完整历史赛事 */
page {
  background: #0d1017;
}

.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 60rpx;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 搜索 */
.search-row { padding: 8rpx 0 16rpx; }
.search-box {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border: 1rpx solid rgba(213, 183, 124, 0.16);
  border-radius: 12rpx;
  background: #151b25;
}
.search-icon { flex: none; color: #7c8797; font-size: 26rpx; }
.search-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 14rpx;
  border: none;
  background: transparent;
  color: #e8e4da;
  font-size: 26rpx;
}
.search-clear {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  color: #8591a1;
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: center;
}

/* 赛季筛选 */
.season-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  margin-bottom: 18rpx;
}
.season-chip {
  display: inline-flex;
  align-items: center;
  flex: none;
  padding: 11rpx 18rpx;
  border: 1rpx solid rgba(206, 178, 116, 0.22);
  border-radius: 999rpx;
  color: #b6bdc7;
  background: rgba(255, 255, 255, 0.02);
  font-size: 22rpx;
}
.season-chip-active {
  border-color: rgba(226, 196, 127, 0.72);
  color: #f0d9a8;
  background: rgba(226, 196, 127, 0.15);
  font-weight: 600;
}
.season-chip-current {
  margin-left: 8rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: #8f7b52;
  background: rgba(226, 196, 127, 0.16);
  font-size: 18rpx;
}

/* 列表 */
.list { border-top: 1rpx solid rgba(218, 190, 133, 0.09); }
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 26rpx 4rpx;
  border-bottom: 1rpx solid rgba(218, 190, 133, 0.09);
}
.item-pressed { background: rgba(255, 255, 255, 0.02); }
.item-main { flex: 1; min-width: 0; }
.item-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.item-title {
  min-width: 0;
  overflow: hidden;
  color: #d8dde4;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.phase-tag {
  display: flex;
  align-items: center;
  flex: none;
  padding: 7rpx 12rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  white-space: nowrap;
}
.phase-registration { color: #a9d7a5; background: rgba(74, 171, 105, 0.14); }
.phase-draft { color: #dfc27c; background: rgba(215, 169, 72, 0.15); }
.phase-battle { color: #e7b480; background: rgba(203, 115, 69, 0.15); }
.phase-finished { color: #a6b0bd; background: rgba(146, 161, 180, 0.13); }

.item-meta { margin-top: 8rpx; color: #7f8997; font-size: 22rpx; line-height: 1.5; }
.item-meta text { margin-right: 2rpx; }
.item-champion { color: #d6b36c; }
.item-unsettled {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(224, 163, 106, 0.4);
  border-radius: 6rpx;
  color: #e0a36a;
  background: rgba(224, 163, 106, 0.08);
  font-size: 19rpx;
}
.item-actions { display: flex; flex-direction: column; gap: 10rpx; flex: none; }
.item-settle {
  flex: none;
  width: 132rpx;
  min-width: 132rpx;
  max-width: 132rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 181, 111, 0.38);
  border-radius: 8rpx;
  color: #dcc38d;
  background: rgba(224, 181, 111, 0.1);
  font-size: 21rpx;
  font-weight: 600;
}
.item-delete {
  flex: none;
  width: 108rpx;
  min-width: 108rpx;
  max-width: 108rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border: 1rpx solid rgba(206, 99, 87, 0.28);
  border-radius: 8rpx;
  color: #e1998f;
  background: rgba(206, 99, 87, 0.08);
  font-size: 21rpx;
  font-weight: 600;
}

/* 状态与分页 */
.state { padding: 36rpx 0; color: #7f8997; font-size: 24rpx; text-align: center; }
.state-error { color: #e1998f; }
.more {
  margin-top: 24rpx;
  padding: 24rpx 0;
  border: 1rpx solid rgba(224, 181, 111, 0.24);
  border-radius: 12rpx;
  color: #dcc38d;
  font-size: 25rpx;
  font-weight: 600;
  text-align: center;
}
.more-pressed { opacity: 0.72; }
.end { padding: 26rpx 0 6rpx; color: #626e7d; font-size: 21rpx; text-align: center; }
.ph { color: #6f7a89; }
.link-pressed { opacity: 0.72; }
.btn-pressed { opacity: 0.75; }

/* 暗号弹窗里输入框与按钮沿用全局样式，仅补一个遥控尺寸 */
.secret-input { margin-bottom: 8rpx; }
