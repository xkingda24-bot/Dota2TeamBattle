/* pages/staff/staff.wxss */
.my-nick {
  margin-bottom: 4rpx;
}
.staff-row {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx;
}
.staff-nick {
  font-size: 30rpx;
  color: #e8e4da;
}
.staff-add-row {
  margin-top: 16rpx;
}
.staff-add-input {
  flex: 1;
  margin-right: 16rpx;
}
/* 添加管理员输入框：显式占满整行，加高防裁切 */
.add-input {
  width: 100%;
  min-height: 92rpx;
}

.ph {
  color: #9aa4b2;
}

/* 用户列表弹窗 */
.user-row {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx;
  border-bottom: 1rpx solid rgba(224, 181, 111, 0.08);
}
.user-row:last-child {
  border-bottom: none;
}
.user-info {
  flex: 1;
  min-width: 0;
}
.user-nick {
  font-size: 28rpx;
  color: #e8e4da;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
