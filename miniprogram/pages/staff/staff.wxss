/* pages/staff/staff.wxss */
.container {
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
.my-nick {
  margin-bottom: 4rpx;
}
.staff-row {
  display: flex;
  align-items: center;
  padding: 14rpx 4rpx;
}
.staff-nick {
  font-size: 30rpx;
  color: #e8e4da;
}
.ph {
  color: #9aa4b2;
}

.profile-card-showcase .player-card { margin-top: 18rpx; }
.profile-title {
  min-width: 0;
}
.profile-actions {
  display: flex;
  flex: none;
  align-items: center;
}
.profile-actions .btn-small {
  flex: none;
  white-space: nowrap;
}
.profile-actions .btn-small + .btn-small {
  margin-left: 12rpx;
}

.bootstrap-openid-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}
.bootstrap-openid {
  min-width: 0;
  flex: 1;
  color: #8c96a5;
  font-family: Menlo, Consolas, monospace;
  font-size: 19rpx;
  word-break: break-all;
}
