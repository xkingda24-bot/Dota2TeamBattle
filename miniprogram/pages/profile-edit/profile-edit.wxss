/* pages/profile-edit/profile-edit.wxss - 资料编辑（原 staff 弹窗样式迁移） */
.optional {
  margin-left: 10rpx;
  color: #8993a1;
  font-size: 22rpx;
}
.dota-id-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.dota-id-input {
  flex: 1;
  min-width: 0;
  width: auto;
}
.dota-lookup-btn {
  flex: none;
  min-width: 86rpx;
  text-align: center;
}
.mmr-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.mmr-input {
  flex: 1;
  min-width: 0;
  width: auto;
}
.mmr-estimate-btn {
  flex: none;
  min-width: 132rpx;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
}
.mmr-estimate-btn.btn-disabled {
  opacity: .45;
}
.dota-lookup-result {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(224, 181, 111, 0.2);
  border-radius: 8rpx;
  background: rgba(224, 181, 111, 0.06);
}
.dota-lookup-copy {
  flex: 1;
  min-width: 0;
}
.dota-player-name {
  overflow: hidden;
  color: #e8e4da;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dota-change-btn {
  flex: none;
  margin-left: 12rpx;
}
.verified-lock {
  margin-left: 12rpx;
  color: #7bc89b;
  font-size: 22rpx;
}
