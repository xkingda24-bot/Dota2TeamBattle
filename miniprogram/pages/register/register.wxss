/* pages/register/register.wxss */
.progress-item {
  margin-right: 48rpx;
}
.progress-item .num {
  font-size: 36rpx;
  font-weight: 600;
  color: #e8c27c;
}
.tab {
  padding: 8rpx 20rpx;
  font-size: 28rpx;
  color: #98a0ab;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.tab-active {
  background: rgba(224, 181, 111, 0.16);
  color: #e8c27c;
}
.reg-row {
  padding: 14rpx 4rpx;
}
.nick {
  font-size: 28rpx;
  color: #e8e4da;
}
.secret-row {
  margin-top: 16rpx;
}
.secret-input {
  flex: 1;
  margin-right: 16rpx;
}
.team-name-input {
  flex: 1;
  margin-right: 16rpx;
}
.team-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #e8c27c;
  background: rgba(224, 181, 111, 0.14);
}
.ph {
  color: #9aa4b2;
}

/* 系统分组预览弹层 */
.group-panel {
  max-height: 78vh;
  display: flex;
  flex-direction: column;
}
.group-scroll {
  flex: 1;
  max-height: 52vh;
  margin-top: 20rpx;
}
.group-block {
  border: 1rpx solid rgba(224, 181, 111, 0.18);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8c27c;
  margin-bottom: 8rpx;
}
.group-warn {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #e5484d;
}
.member-line {
  font-size: 26rpx;
  color: #e8e4da;
  line-height: 1.8;
}
.member-name {
  color: #fff;
}
.kv {
  color: #98a0ab;
}
.panel-btns {
  display: flex;
  margin-top: 24rpx;
}
.panel-btn {
  flex: 1;
  margin-top: 0;
}
.panel-btn + .panel-btn {
  margin-left: 20rpx;
}
