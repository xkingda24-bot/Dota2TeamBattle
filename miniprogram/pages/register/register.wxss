/* pages/register/register.wxss */
.register-load-card,
.register-state-card {
  padding: 48rpx 32rpx;
  text-align: center;
}
.register-load-card .card-title,
.register-state-card .card-title {
  margin-top: 14rpx;
}
.register-load-card .sub,
.register-state-card .sub {
  line-height: 1.6;
}
.register-load-mark {
  color: #e8c27c;
  font-size: 48rpx;
  line-height: 1;
  animation: register-load-pulse 1.6s ease-in-out infinite;
}
.register-loading-track {
  height: 6rpx;
  overflow: hidden;
  margin: 30rpx auto 4rpx;
  border-radius: 999rpx;
  background: rgba(224, 181, 111, 0.12);
}
.register-loading-progress {
  width: 38%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(224, 181, 111, 0.2), #e8c27c, rgba(224, 181, 111, 0.2));
  animation: register-load-sweep 1.5s ease-in-out infinite;
}
.register-state-card .btn {
  margin-top: 26rpx;
}
.register-state-card .btn + .btn {
  margin-top: 14rpx;
}
.register-refresh-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}
.register-refresh-error .sub {
  flex: 1;
}
.register-refresh-error .btn-small {
  flex: none;
  margin-left: 16rpx;
}
@keyframes register-load-pulse {
  0%, 100% { opacity: 0.55; transform: scale(0.92); }
  50% { opacity: 1; transform: scale(1.08); }
}
@keyframes register-load-sweep {
  0% { transform: translateX(-110%); }
  100% { transform: translateX(280%); }
}
.progress-item {
  margin-right: 48rpx;
}
.progress-item .num {
  font-size: 36rpx;
  font-weight: 600;
  color: #e8c27c;
}
.tab {
  padding: 8rpx 20rpx;
  font-size: 28rpx;
  color: #98a0ab;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.tab-active {
  background: rgba(224, 181, 111, 0.16);
  color: #e8c27c;
}
.reg-row {
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(224, 181, 111, 0.12);
}
.reg-row:last-child {
  border-bottom: 0;
}
.reg-team-line {
  display: flex;
  align-items: center;
  min-height: 44rpx;
  margin-bottom: 12rpx;
}
.reg-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 12rpx;
}
.nick {
  font-size: 28rpx;
  color: #e8e4da;
}
.secret-row {
  margin-top: 16rpx;
}
.secret-input {
  flex: 1;
  margin-right: 16rpx;
}
.secret-display {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #f5f2ea;
  word-break: break-all;
}
.team-name-input {
  flex: 1;
  margin-right: 16rpx;
}
.team-logo-label { margin-top:18rpx; color:#9aa4b2; font-size:22rpx; }
.team-logo-options { display:flex; flex-wrap:wrap; margin:2rpx 0 0 -10rpx; }
.team-logo-option { display:flex; flex:0 0 calc(20% - 10rpx); flex-direction:column; align-items:center; justify-content:center; min-width:0; min-height:92rpx; margin:10rpx 0 0 10rpx; padding:6rpx 3rpx; border:1rpx solid rgba(224,181,111,.12); border-radius:9rpx; color:#aeb7c2; background:rgba(255,255,255,.025); font-size:18rpx; box-sizing:border-box; }
.team-logo-option-active { border-color:rgba(224,181,111,.62); color:#e8c27c; background:rgba(224,181,111,.09); }
.team-logo-emoji { margin-bottom:4rpx; font-size:40rpx; line-height:1; }
.team-logo-clear { display:flex; flex:0 0 calc(20% - 10rpx); align-items:center; justify-content:center; min-height:74rpx; margin:10rpx 0 0 10rpx; color:#9aa4b2; font-size:18rpx; box-sizing:border-box; }
.team-logo-load-error { margin:8rpx 0; color:#d5a47e; font-size:22rpx; line-height:1.5; }
.captain-team-logo { display:inline-flex; flex:none; align-items:center; justify-content:center; width:44rpx; height:44rpx; margin-right:10rpx; font-size:36rpx; line-height:1; }
.team-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #e8c27c;
  background: rgba(224, 181, 111, 0.14);
}
.registration-hint {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 10rpx;
  color: #8d99a8;
  background: rgba(255, 255, 255, 0.035);
  font-size: 22rpx;
  line-height: 1.5;
}
.registration-help {
  margin-top: 13rpx;
  line-height: 1.55;
}
.change-secret {
  display: inline-flex;
  align-items: center;
  margin-top: 18rpx;
  color: #bca36c;
  font-size: 22rpx;
}
.change-secret text {
  margin-left: 5rpx;
  font-size: 30rpx;
  line-height: 1;
}
.ph {
  color: #9aa4b2;
}

.panel-btns {
  display: flex;
  margin-top: 24rpx;
}
.panel-btn {
  flex: 1;
  margin-top: 0;
}
.panel-btn + .panel-btn {
  margin-left: 20rpx;
}
