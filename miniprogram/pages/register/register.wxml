<!--pages/register/register.wxml - 报名-->
<nav-bar title="报名" />
<view class="container">
  <block wx:if="{{t}}">
    <!-- 比赛信息 -->
    <view class="card">
      <view class="card-title">{{t.name}}</view>
      <view class="sub">时间：{{t.time}} · 共 {{t.N}} 队（每队 1 队长 + {{t.K}} 队员）<text wx:if="{{t.creatorName}}"> · 创建人：{{t.creatorName}}</text></view>
      <view class="divider"></view>
      <view class="row">
        <view class="progress-item">
          <view class="num">{{t.captainFilled}}/{{t.captainTotal}}</view>
          <view class="sub">队长</view>
        </view>
        <view class="progress-item">
          <view class="num">{{t.playerFilled}}/{{t.playerTotal}}</view>
          <view class="sub">队员</view>
        </view>
        <view class="progress-item" wx:if="{{t.waitLimit > 0}}">
          <view class="num">{{t.waitlistFilled}}/{{t.waitLimit}}</view>
          <view class="sub">替补</view>
        </view>
        <view class="spacer"></view>
        <view class="tag tag-gray">{{t.captainFilled === t.captainTotal && t.playerFilled === t.playerTotal ? '名额已满（可报替补）' : '报名中'}}</view>
      </view>
    </view>

    <!-- 报名暗号 -->
    <view class="card" wx:if="{{t.status === 'registration' && !myReg && !secretOk}}">
      <view class="card-title">报名暗号</view>
      <view class="sub">输入管理员设置的暗号后即可报名</view>
      <view class="row secret-row">
        <input class="input secret-input" placeholder="请输入暗号" placeholder-class="ph" value="{{secretInput}}" bindinput="onSecretInput" />
        <view class="btn-small" bindtap="onVerifySecret">验证</view>
      </view>
    </view>

    <!-- 我的报名 -->
    <view class="card">
      <view class="card-title">我的报名</view>
      <view wx:if="{{myReg}}" class="row">
        <view class="tag tag-green">已报名：{{myReg.roleText}}</view>
        <view class="spacer"></view>
        <view class="btn-small btn-danger" bindtap="onCancelReg">取消报名</view>
      </view>

      <!-- 队长：设置队伍名称（报名阶段） -->
      <block wx:if="{{myReg && myReg.role === 'captain' && t.status === 'registration'}}">
        <view class="divider"></view>
        <view class="sub" style="margin-bottom:8rpx;">队伍名称（选填，最多 10 个字；选人前可随时修改）</view>
        <view class="row">
          <input class="input team-name-input" maxlength="10" placeholder="给队伍取个名字" placeholder-class="ph" value="{{teamNameInput}}" bindinput="onTeamNameInput" />
          <view class="btn-small {{teamNameSaving ? 'btn-disabled' : ''}}" bindtap="onSaveTeamName">{{teamNameSaving ? '保存中...' : '保存队名'}}</view>
        </view>
      </block>

      <view wx:elif="{{secretOk}}">
        <view class="sub" wx:if="{{t.status !== 'registration'}}">当前不在报名阶段</view>
        <view wx:else>
          <view class="btn {{t.captainFilled >= t.captainTotal ? 'btn-disabled' : ''}}" bindtap="onReg" data-role="captain">{{t.captainFilled >= t.captainTotal ? '队长名额已满' : '报名队长'}}</view>
          <view class="btn btn-plain {{t.playerFilled >= t.playerTotal ? 'btn-disabled' : ''}}" bindtap="onReg" data-role="player">{{t.playerFilled >= t.playerTotal ? '队员名额已满（可报替补）' : '报名队员'}}</view>
          <view class="btn btn-plain {{t.waitlistFilled >= t.waitLimit ? 'btn-disabled' : ''}}" wx:if="{{t.waitLimit > 0}}" bindtap="onReg" data-role="waitlist">{{t.waitlistFilled >= t.waitLimit ? '替补名额已满' : '报名替补'}}</view>
        </view>
      </view>
      <view wx:else class="row">
        <view class="sub">输入上方暗号验证后即可报名</view>
      </view>
    </view>

    <!-- 名单 -->
    <view class="card">
      <view class="row">
        <view class="tab {{activeTab === 'captain' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="captain">队长（{{t.captainFilled}}）</view>
        <view class="tab {{activeTab === 'player' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="player">队员（{{t.playerFilled}}）</view>
        <view class="tab {{activeTab === 'waitlist' ? 'tab-active' : ''}}" wx:if="{{t.waitLimit > 0}}" bindtap="switchTab" data-tab="waitlist">替补（{{t.waitlistFilled}}）</view>
      </view>
      <view class="divider"></view>
      <view wx:if="{{activeTab === 'captain'}}">
        <view wx:if="{{captainList.length === 0}}" class="empty">还没有队长报名</view>
        <view class="reg-row" wx:for="{{captainList}}" wx:key="openid">
          <view class="row">
            <view class="nick">{{item.nickname}}<text wx:if="{{item.teamName}}" class="team-tag">{{item.teamName}}</text></view>
            <view class="spacer"></view>
            <view wx:if="{{isAdmin && t.status === 'registration'}}" class="btn-small btn-danger" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}" bindtap="onRemoveReg">移除</view>
          </view>
          <view class="pinfo" wx:if="{{item.mmrText || item.rolesText || item.signature}}">
            <text class="kv">{{item.mmrText}}</text>
            <text wx:if="{{item.mmrText && item.rolesText}}"> · </text>
            <text>{{item.rolesText}}</text>
            <text wx:if="{{item.signature}}"> · {{item.signature}}</text>
          </view>
          <view class="pinfo" wx:else>未填写天梯分 / 位置 / 签名</view>
        </view>
      </view>
      <view wx:elif="{{activeTab === 'player'}}">
        <view wx:if="{{playerList.length === 0}}" class="empty">还没有队员报名</view>
        <view class="reg-row" wx:for="{{playerList}}" wx:key="openid">
          <view class="row">
            <view class="nick">{{item.nickname}}</view>
            <view class="spacer"></view>
            <view wx:if="{{isAdmin && t.status === 'registration'}}" class="btn-small btn-plain" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}" data-to="waitlist" bindtap="onMoveReg">移入替补</view>
            <view wx:if="{{isAdmin && t.status === 'registration'}}" class="btn-small btn-danger" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}" bindtap="onRemoveReg">移除</view>
          </view>
          <view class="pinfo" wx:if="{{item.mmrText || item.rolesText || item.signature}}">
            <text class="kv">{{item.mmrText}}</text>
            <text wx:if="{{item.mmrText && item.rolesText}}"> · </text>
            <text>{{item.rolesText}}</text>
            <text wx:if="{{item.signature}}"> · {{item.signature}}</text>
          </view>
          <view class="pinfo" wx:else>未填写天梯分 / 位置 / 签名</view>
        </view>
      </view>
      <view wx:else>
        <view wx:if="{{waitlistList.length === 0}}" class="empty">还没有替补报名</view>
        <view class="reg-row" wx:for="{{waitlistList}}" wx:key="openid">
          <view class="row">
            <view class="nick">{{item.nickname}}</view>
            <view class="spacer"></view>
            <view wx:if="{{isAdmin && t.status === 'registration'}}" class="btn-small btn-plain" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}" data-to="player" bindtap="onMoveReg">移入队员</view>
            <view wx:if="{{isAdmin && t.status === 'registration'}}" class="btn-small btn-danger" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}" bindtap="onRemoveReg">移除</view>
          </view>
          <view class="pinfo" wx:if="{{item.mmrText || item.rolesText || item.signature}}">
            <text class="kv">{{item.mmrText}}</text>
            <text wx:if="{{item.mmrText && item.rolesText}}"> · </text>
            <text>{{item.rolesText}}</text>
            <text wx:if="{{item.signature}}"> · {{item.signature}}</text>
          </view>
          <view class="pinfo" wx:else>未填写天梯分 / 位置 / 签名</view>
        </view>
      </view>
    </view>

    <!-- 管理员操作 -->
    <view class="card" wx:if="{{isAdmin}}">
      <view class="card-title">管理员操作</view>
      <view class="sub">队长 {{t.captainFilled}}/{{t.captainTotal}} · 队员 {{t.playerFilled}}/{{t.playerTotal}}<text wx:if="{{t.waitLimit > 0}}"> · 替补 {{t.waitlistFilled}}/{{t.waitLimit}}</text></view>
      <view class="btn btn-plain" wx:if="{{t.status === 'registration'}}" bindtap="onEditConfig">修改比赛配置</view>
      <view class="btn" wx:if="{{t.status === 'registration'}}" bindtap="onStartDraft">开始选人（随机排序队长）</view>
      <view class="btn btn-danger" wx:if="{{t.status === 'registration'}}" bindtap="onDelete">删除比赛</view>
      <view class="btn btn-plain" wx:if="{{t.status !== 'registration'}}">当前阶段：{{t.status === 'draft' ? '选人中' : t.status === 'battle' ? '对战中' : '已结束'}}</view>
    </view>
  </block>

  <view wx:else class="card">
    <view class="card-title">暂无比赛</view>
    <view class="sub">请从主页选择一场比赛进入</view>
    <view class="btn btn-plain" bindtap="goBack">返回主页</view>
  </view>
</view>
