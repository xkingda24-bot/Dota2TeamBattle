<!-- 刀塔集结首页 -->
<nav-bar title="刀塔集结" />

<view class="home-page">
  <view class="hero">
    <image class="hero-bg" src="/images/ti-banner.png" mode="aspectFill" />
    <view class="hero-shade"></view>
    <view class="hero-copy">
      <view class="hero-kicker">COMMUNITY LEAGUE</view>
      <view class="hero-title">今晚，组队开战</view>
      <view class="hero-subtitle">和熟悉的队友，一起打出属于你们的精彩。</view>
      <view class="hero-action" bindtap="goCreate" hover-class="hero-action-pressed">
        <text>创建比赛</text><text class="hero-action-icon">＋</text>
      </view>
      <view class="hero-hint">今日还可创建 {{todayCreateRemaining}} / {{todayCreateLimit}} 场比赛</view>
    </view>
    <view class="hero-rune" aria-hidden="true">✦</view>
  </view>

  <view wx:if="{{!loading && !loadError && !hasSuper}}" class="setup-note">
    <view class="setup-mark">!</view>
    <view class="setup-copy">
      <view class="setup-title">尚未初始化最高管理员</view>
    <view class="setup-desc">所有用户都可创建比赛；初始化后超管可管理全部赛事</view>
    </view>
    <view class="setup-arrow">›</view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-kicker">MATCH CENTER</view>
      <view class="section-title">今日新增赛事 <text class="section-count">{{today.length}}</text></view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-list" aria-label="正在加载赛事">
    <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line skeleton-meta"></view><view class="skeleton-line skeleton-bar"></view></view>
    <view class="skeleton-card"><view class="skeleton-line skeleton-title"></view><view class="skeleton-line skeleton-meta"></view><view class="skeleton-line skeleton-bar"></view></view>
  </view>

  <view wx:if="{{!loading && loadError}}" class="load-error">
    <view class="load-error-title">赛事暂时无法加载</view>
    <view class="load-error-desc">{{loadError}}</view>
    <view class="load-error-action" bindtap="load" hover-class="link-pressed">重试</view>
  </view>

  <view wx:if="{{!loading && !loadError && today.length === 0}}" class="empty-state">
    <view class="empty-emblem">⚔</view>
    <view class="empty-title">今天还没有新建赛事</view>
    <view class="empty-desc">新建的比赛会显示在这里</view>
    <view class="empty-action" bindtap="goCreate" hover-class="link-pressed">创建第一场比赛 <text>›</text></view>
  </view>

  <view
    wx:if="{{!loading && !loadError}}"
    class="swipe-item"
    wx:for="{{today}}"
    wx:key="id"
    data-index="{{index}}"
    bindtouchstart="onSwipeStart"
    bindtouchmove="onSwipeMove"
    bindtouchend="onSwipeEnd"
  >
    <view class="swipe-actions {{item.champion ? 'swipe-actions-wide' : ''}}" wx:if="{{item.canManage}}">
      <view class="swipe-action" wx:if="{{item.champion}}" data-index="{{index}}" data-action="archive" catch:tap="onSwipeAction">
        <text class="action-symbol">✓</text><text>归档</text>
      </view>
      <view class="swipe-action danger" data-index="{{index}}" data-action="delete" catch:tap="onSwipeAction">
        <text class="action-symbol">×</text><text>删除</text>
      </view>
    </view>

    <view
      class="match-card {{item.swipeDragging ? 'match-card-dragging' : ''}}"
      style="transform: translateX({{item.swipeX}}px);"
      data-index="{{index}}"
      bindtap="goTournament"
      bindlongpress="onLongPressTournament"
      hover-class="match-card-pressed"
    >
      <view class="match-topline">
        <view class="match-title-wrap">
          <view class="match-title">{{item.name}}</view>
          <view class="match-meta">{{item.time}}<text wx:if="{{item.N}}"> · {{item.N}} 支队伍</text></view>
        </view>
        <view class="match-tools">
          <view class="phase-tag {{item.status === 'registration' ? 'phase-registration' : item.status === 'draft' ? 'phase-draft' : item.status === 'battle' ? 'phase-battle' : 'phase-finished'}}">
            <view class="phase-dot"></view>{{item.phaseText}}
          </view>
          <view wx:if="{{item.canManage}}" class="admin-menu" catch:tap="onAdminMenu" data-index="{{index}}" aria-label="比赛管理菜单">•••</view>
        </view>
      </view>

      <view class="match-rule"></view>

      <view class="progress-grid">
        <view class="progress-block" wx:if="{{item.captainTotal > 0}}">
          <view class="progress-label"><text>队长</text><text class="progress-value">{{item.captainFilled}}<text class="progress-total"> / {{item.captainTotal}}</text></text></view>
          <view class="progress-track"><view class="progress-fill captain-fill" style="width: {{item.captainTotal > 0 ? item.captainFilled / item.captainTotal * 100 : 0}}%;"></view></view>
        </view>
        <view class="progress-block">
          <view class="progress-label"><text>队员</text><text class="progress-value">{{item.playerFilled}}<text class="progress-total"> / {{item.playerTotal}}</text></text></view>
          <view class="progress-track"><view class="progress-fill player-fill" style="width: {{item.playerTotal > 0 ? item.playerFilled / item.playerTotal * 100 : 0}}%;"></view></view>
        </view>
        <view class="progress-block" wx:if="{{item.waitLimit > 0}}">
          <view class="progress-label"><text>替补</text><text class="progress-value">{{item.waitlistFilled}}<text class="progress-total"> / {{item.waitLimit}}</text></text></view>
          <view class="progress-track"><view class="progress-fill substitute-fill" style="width: {{item.waitLimit > 0 ? item.waitlistFilled / item.waitLimit * 100 : 0}}%;"></view></view>
        </view>
      </view>

      <view class="match-footer">
        <view class="creator" wx:if="{{item.creatorName}}">发起人 <text>{{item.creatorName}}</text></view>
        <view class="creator" wx:else>比赛详情与队伍信息</view>
        <view wx:if="{{item.champion}}" class="match-cta champion-cta"><text class="champion-star">✦</text>冠军 {{item.champion.name}}</view>
        <view wx:else class="match-cta">查看赛事 <text class="cta-arrow">›</text></view>
      </view>

    </view>
  </view>

  <view wx:if="{{!loading && !loadError}}" class="history-section">
    <view class="history-heading" bindtap="toggleHistory" aria-expanded="{{historyExpanded}}" hover-class="link-pressed">
      <view class="history-heading-copy">
        <view class="history-kicker">TOURNAMENT HISTORY</view>
        <view class="history-title">历史赛事 <text class="history-count">{{older.length}}</text></view>
      </view>
      <view class="history-chevron {{historyExpanded ? 'history-chevron-open' : ''}}">›</view>
    </view>
    <view wx:if="{{historyExpanded}}" class="history-body">
      <view wx:if="{{older.length === 0}}" class="history-empty">暂无历史赛事</view>
      <view wx:for="{{older}}" wx:for-item="item" wx:key="id" class="history-item" data-index="{{index}}" bindtap="goHistoryDetail">
        <view class="history-item-main">
          <view class="history-item-top">
            <view class="history-item-title">{{item.name}}</view>
            <view class="phase-tag {{item.status === 'registration' ? 'phase-registration' : item.status === 'draft' ? 'phase-draft' : item.status === 'battle' ? 'phase-battle' : 'phase-finished'}}">{{item.phaseText}}</view>
          </view>
          <view class="history-item-meta">{{item.time}}<text wx:if="{{item.N}}"> · {{item.N}} 支队伍</text></view>
          <view wx:if="{{item.champion}}" class="history-item-meta history-champion">冠军：{{item.champion.name}}</view>
        </view>
        <button wx:if="{{item.canManage}}" class="history-action history-delete-action" data-index="{{index}}" catch:tap="deleteFromHistory" hover-class="btn-pressed">{{historyBusyId === item.id || historyBusyId === item._id ? '处理中…' : '删除'}}</button>
      </view>
      <view wx:if="{{older.length === 50}}" class="history-footnote">显示最近 50 场历史赛事</view>
    </view>
  </view>


  <view class="home-bottom-note">
    <view>GLHF <text>·</text> GOOD LUCK, HAVE FUN</view>
    <view class="home-feedback-note">有bug · 找Ada阿达</view>
  </view>
</view>

<!-- 报名暗号验证 -->
<view class="mask" wx:if="{{secretModal}}" bindtap="onCloseSecret">
  <view class="panel" catchtap="noop">
    <view class="panel-title">输入报名暗号</view>
    <view class="panel-sub">{{secretTargetName}}</view>
    <input class="input secret-input" placeholder="请输入暗号" placeholder-class="ph" value="{{secretInput}}" bindinput="onSecretInput" />
    <view class="panel-btns">
      <view class="panel-btn btn-plain" bindtap="onCloseSecret">取消</view>
      <view class="panel-btn btn" bindtap="onConfirmSecret">{{secretChecking ? '验证中…' : '确认报名'}}</view>
    </view>
  </view>
</view>

<!-- 首次资料设置 -->
<view class="mask" wx:if="{{nickModal}}" bindtap="onCloseNick">
  <view class="panel profile-panel" catchtap="noop">
    <view class="panel-title">先完善个人资料</view>
    <view class="panel-sub">报名和选人时，队友会看到这些信息</view>

    <view class="field-label">昵称 <text class="req">*</text></view>
    <input class="input nick-input" placeholder="请输入昵称（最多20字）" placeholder-class="ph" maxlength="20" value="{{nickInput}}" bindinput="onNickInput" />

    <view class="field-label">Dota 2 ID <text class="optional">可选</text></view>
    <input class="input" type="number" maxlength="12" placeholder="5-12 位数字 ID" placeholder-class="ph" value="{{pfDota2Id}}" bindinput="onPfDotaId" />
    <view class="field-label">段位</view>
    <view class="dota-id-row">
      <input class="input dota-id-input" value="{{pfDotaRankLabel}}" disabled="{{true}}" />
      <view class="btn-small dota-lookup-btn {{dotaLookupLoading || nickSaving ? 'btn-disabled' : ''}}" bindtap="onLookupDota">{{dotaLookupLoading ? '校验中…' : '段位校验'}}</view>
    </view>
    <view class="sub dota-help">段位校验只读取 OpenDota 资料，不会修改天梯分。</view>
    <view wx:if="{{pfDotaRankVerified}}" class="sub dota-verified-time">已校验于{{pfDotaRankVerifiedAtText}}（14 天有效）</view>
    <view wx:if="{{pfDotaRankVerifiedAt && !pfDotaRankVerified}}" class="sub dota-help">段位校验已过期，可重新校验</view>

    <view class="field-label">天梯分 <text class="req">*</text></view>
    <input class="input" type="number" placeholder="例如 4500" placeholder-class="ph" value="{{pfMmr}}" bindinput="onPfMmr" />

    <view class="field-label">常玩位置 <text class="req">* 至少选择一个</text></view>
    <view class="role-btns">
      <view class="role-btn {{rolesActive[0] ? 'role-btn-active' : ''}}" data-role="1" bindtap="onToggleRole">1号位</view>
      <view class="role-btn {{rolesActive[1] ? 'role-btn-active' : ''}}" data-role="2" bindtap="onToggleRole">2号位</view>
      <view class="role-btn {{rolesActive[2] ? 'role-btn-active' : ''}}" data-role="3" bindtap="onToggleRole">3号位</view>
      <view class="role-btn {{rolesActive[3] ? 'role-btn-active' : ''}}" data-role="4" bindtap="onToggleRole">4号位</view>
      <view class="role-btn {{rolesActive[4] ? 'role-btn-active' : ''}}" data-role="5" bindtap="onToggleRole">5号位</view>
    </view>
    <view class="sub role-help">1 核心 · 2 中单 · 3 劣单 · 4/5 辅助</view>

    <view class="field-label">个人签名</view>
    <input class="input" placeholder="选填，最多15个字" placeholder-class="ph" maxlength="15" value="{{pfSig}}" bindinput="onPfSig" />
    <view class="char-count">{{pfSig.length}}/15</view>

    <view class="panel-btns">
      <view class="panel-btn btn-plain" bindtap="onCloseNick">稍后</view>
      <view class="panel-btn btn" bindtap="onConfirmNick">{{nickSaving ? '保存中…' : '保存资料'}}</view>
    </view>
  </view>
</view>
