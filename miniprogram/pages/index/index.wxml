<!--pages/index/index.wxml - 主页-->
<nav-bar title="Dota2 战队赛" />
<view class="container">
  <!-- 顶部横幅 -->
  <view class="hero">
    <image class="hero-bg" src="/images/ti-banner.png" mode="aspectFill"></image>
    <view class="hero-scrim"></view>
    <view class="hero-title">DOTA2 战队赛</view>
    <view class="hero-sub">THE INTERNATIONAL · 群内赛 · 报名 / 选人 / 赛程全自动</view>
  </view>

  <!-- 超管未初始化提示 -->
  <view wx:if="{{!hasSuper}}" class="card tip-card">
    <view class="tip-text">系统尚未初始化最高管理员：请点右上角「我的」，第一位初始化者将成为最高管理员（可添加/移除管理员）。</view>
  </view>

  <!-- 创建比赛（仅管理员） -->
  <view class="card">
    <view class="row">
      <view>
        <view class="card-title">创建比赛</view>
        <view class="sub">设置名称、时间、队长数、每队队友数、报名暗号</view>
      </view>
      <view class="spacer"></view>
      <view class="btn-small {{isAdmin ? '' : 'btn-disabled'}}" bindtap="goCreate">{{isAdmin ? '去创建' : '仅管理员'}}</view>
    </view>
    <view class="sub" wx:if="{{!isAdmin}}">只有管理员可以创建比赛；管理员由最高管理员添加</view>
  </view>

  <!-- 今天的比赛 -->
  <view class="section">今天的比赛（{{today.length}}）<text wx:if="{{isAdmin}}" class="section-hint"> · 左滑卡片可归档/删除</text></view>
  <view wx:if="{{today.length === 0}}" class="empty">今天还没有创建比赛</view>
  <view
    class="swipe-item"
    wx:for="{{today}}"
    wx:key="id"
    data-index="{{index}}"
    bindtouchstart="onSwipeStart"
    bindtouchmove="onSwipeMove"
    bindtouchend="onSwipeEnd"
  >
    <!-- 操作按钮（卡片左滑露出） -->
    <view class="swipe-btns" wx:if="{{isAdmin}}">
      <view class="swipe-btn" wx:if="{{item.status === 'battle'}}" data-index="{{index}}" data-action="archive" catchtap="onSwipeAction">归档</view>
      <view class="swipe-btn danger" data-index="{{index}}" data-action="delete" catchtap="onSwipeAction">删除</view>
    </view>
    <!-- 卡片本体 -->
    <view class="swipe-card" style="transform: translateX({{item.swipeX}}px);" data-index="{{index}}" bindtap="goTournament">
      <view class="row">
        <view class="card-title">{{item.name}}</view>
        <view class="tag {{item.status === 'registration' ? 'tag-blue' : item.status === 'draft' ? 'tag-red' : item.status === 'battle' ? 'tag-green' : 'tag-gray'}}">{{item.phaseText}}</view>
      </view>
      <view class="sub">时间：{{item.time}} · {{item.N}} 队<text wx:if="{{item.creatorName}}"> · 创建人：{{item.creatorName}}</text></view>
      <view class="divider"></view>
      <view class="row">
        <view class="progress-item">
          <view class="num">{{item.captainFilled}}/{{item.captainTotal}}</view>
          <view class="sub">队长</view>
        </view>
        <view class="progress-item">
          <view class="num">{{item.playerFilled}}/{{item.playerTotal}}</view>
          <view class="sub">队员</view>
        </view>
        <view class="spacer"></view>
        <view wx:if="{{item.champion}}" class="tag tag-red">冠军 {{item.champion.name}}</view>
        <view wx:else class="tag tag-blue">进入</view>
      </view>
    </view>
  </view>

  <!-- 历史比赛 -->
  <view class="card row" bindtap="goHistory" hover-class="nav-hover">
    <view>
      <view class="card-title">历史比赛</view>
      <view class="sub">查看之前创建的比赛、比赛过程与结果</view>
    </view>
    <view class="spacer"></view>
    <view class="btn-small btn-plain">进入</view>
  </view>
</view>

<!-- 暗号验证弹窗 -->
<view class="mask" wx:if="{{secretModal}}" bindtap="onCloseSecret">
  <view class="panel" catchtap="noop">
    <view class="panel-title">输入报名暗号</view>
    <view class="panel-sub">{{secretTargetName}}</view>
    <input class="input secret-input" placeholder="请输入暗号" placeholder-class="ph" value="{{secretInput}}" bindinput="onSecretInput" />
    <view class="panel-btns">
      <view class="panel-btn btn-plain" bindtap="onCloseSecret">取消</view>
      <view class="panel-btn btn" bindtap="onConfirmSecret">{{secretChecking ? '验证中…' : '确认'}}</view>
    </view>
  </view>
</view>

<!-- 昵称设置弹窗 -->
<view class="mask" wx:if="{{nickModal}}" bindtap="onCloseNick">
  <view class="panel" catchtap="noop">
    <view class="panel-title">设置你的资料</view>
    <view class="panel-sub">报名、选人时其他群友看到的名称和信息</view>

    <view class="field-label">昵称 <text class="req">*</text></view>
    <input class="input nick-input" placeholder="请输入昵称（最多20字）" placeholder-class="ph" maxlength="20" value="{{nickInput}}" bindinput="onNickInput" />

    <view class="field-label">天梯分</view>
    <input class="input" type="number" placeholder="选填，如 4500" placeholder-class="ph" value="{{pfMmr}}" bindinput="onPfMmr" />

    <view class="field-label">常玩位置（可多选）</view>
    <view class="role-btns">
      <view class="role-btn {{rolesActive[0] ? 'role-btn-active' : ''}}" data-role="1" bindtap="onToggleRole">1号位</view>
      <view class="role-btn {{rolesActive[1] ? 'role-btn-active' : ''}}" data-role="2" bindtap="onToggleRole">2号位</view>
      <view class="role-btn {{rolesActive[2] ? 'role-btn-active' : ''}}" data-role="3" bindtap="onToggleRole">3号位</view>
      <view class="role-btn {{rolesActive[3] ? 'role-btn-active' : ''}}" data-role="4" bindtap="onToggleRole">4号位</view>
      <view class="role-btn {{rolesActive[4] ? 'role-btn-active' : ''}}" data-role="5" bindtap="onToggleRole">5号位</view>
    </view>
    <view class="sub" style="margin-top:8rpx;">1号位核心 · 2号位中单 · 3号位劣单 · 4/5号位辅助</view>

    <view class="field-label">个人签名</view>
    <input class="input" placeholder="选填，最多15个字" placeholder-class="ph" maxlength="15" value="{{pfSig}}" bindinput="onPfSig" />
    <view class="char-count {{pfSig.length > 15 ? 'over' : ''}}">{{pfSig.length}}/15</view>

    <view class="panel-btns">
      <view class="panel-btn btn-plain" bindtap="onCloseNick">稍后再说</view>
      <view class="panel-btn btn" bindtap="onConfirmNick">{{nickSaving ? '保存中…' : '保存'}}</view>
    </view>
  </view>
</view>

