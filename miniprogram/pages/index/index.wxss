/* Homepage visual system: night battlefield surfaces with restrained gold accents. */
.home-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: radial-gradient(circle at 84% 1%, rgba(183,130,62,.12), transparent 32%), linear-gradient(180deg,#0d121b 0%,#0a0e15 58%,#0b1018 100%);
}
.hero { position:relative; min-height:300rpx; overflow:hidden; border:1rpx solid rgba(224,181,111,.25); border-radius:24rpx; background:#151f2c; box-shadow:0 16rpx 44rpx rgba(0,0,0,.25); }
.hero-bg,.hero-shade { position:absolute; top:0; left:0; width:100%; height:100%; }
.hero-bg { opacity:.8; filter:saturate(.82) contrast(1.06); }
.hero-shade { background:linear-gradient(90deg,rgba(9,13,20,.95) 0%,rgba(9,13,20,.74) 48%,rgba(9,13,20,.22) 100%),linear-gradient(180deg,rgba(8,12,18,.08),rgba(8,12,18,.73)); }
.hero-copy { position:relative; z-index:2; padding:42rpx 34rpx 34rpx; }
.hero-kicker,.section-kicker { color:#d7b46f; font-size:19rpx; font-weight:700; letter-spacing:4rpx; }
.hero-title { margin-top:18rpx; color:#f6f0e4; font-size:48rpx; font-weight:700; letter-spacing:2rpx; line-height:1.25; text-shadow:0 4rpx 20rpx rgba(0,0,0,.55); }
.hero-subtitle { max-width:430rpx; margin-top:12rpx; color:#bac5d2; font-size:24rpx; line-height:1.65; }
.hero-action { display:flex; align-items:center; justify-content:space-between; width:220rpx; margin-top:28rpx; padding:15rpx 20rpx 15rpx 24rpx; border-radius:10rpx; color:#21180b; background:linear-gradient(110deg,#efd79f,#c79c52); box-shadow:0 8rpx 20rpx rgba(0,0,0,.24); font-size:26rpx; font-weight:700; }
.hero-action-icon { font-size:34rpx; font-weight:400; line-height:1; }
.hero-action-pressed,.link-pressed { opacity:.65; transform:scale(.98); }
.hero-hint { margin-top:28rpx; color:#d6c291; font-size:23rpx; }
.hero-rune { position:absolute; z-index:1; right:50rpx; bottom:30rpx; color:rgba(235,202,131,.46); font-size:56rpx; text-shadow:0 0 34rpx rgba(224,167,83,.8); transform:rotate(22deg); }

.setup-note { display:flex; align-items:center; margin-top:18rpx; padding:20rpx 22rpx; border:1rpx solid rgba(216,174,97,.25); border-radius:14rpx; background:rgba(199,159,83,.08); }
.setup-mark { display:flex; align-items:center; justify-content:center; width:40rpx; height:40rpx; border:1rpx solid rgba(231,194,119,.5); border-radius:50%; color:#e4c078; font-size:25rpx; font-weight:700; }
.setup-copy { flex:1; margin-left:16rpx; }
.setup-title { color:#e4ca92; font-size:25rpx; font-weight:600; }
.setup-desc { margin-top:5rpx; color:#9aa4b3; font-size:21rpx; }
.setup-arrow { color:#d5b26e; font-size:42rpx; font-weight:200; line-height:1; }

.section-head { display:flex; align-items:flex-end; justify-content:space-between; margin:38rpx 4rpx 18rpx; }
.section-title { margin-top:8rpx; color:#f0f1f3; font-size:34rpx; font-weight:700; }
.section-count { margin-left:9rpx; color:#d6b36c; font-size:25rpx; font-weight:500; }
.history-section { margin-top:34rpx; border-top:1rpx solid rgba(213,183,124,.13); border-bottom:1rpx solid rgba(213,183,124,.13); }
.history-heading { display:flex; align-items:center; justify-content:space-between; min-height:104rpx; padding:0 8rpx; }
.history-heading-copy { min-width:0; }
.history-kicker { color:#8c7958; font-size:17rpx; font-weight:700; letter-spacing:3rpx; }
.history-title { margin-top:6rpx; color:#c7cdd5; font-size:27rpx; font-weight:600; }
.history-count { margin-left:8rpx; color:#8490a0; font-size:22rpx; font-weight:400; }
.history-body { padding:0 8rpx 8rpx; }
.history-item { display:flex; align-items:center; justify-content:space-between; gap:14rpx; padding:20rpx 0; border-top:1rpx solid rgba(218,190,133,.09); }
.history-item-main { min-width:0; flex:1; }
.history-item-top { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.history-item-title { min-width:0; overflow:hidden; color:#d8dde4; font-size:25rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.history-item-top .phase-tag { flex:none; }
.history-item-meta { margin-top:7rpx; color:#7f8997; font-size:20rpx; line-height:1.5; }
.history-champion { color:#d6b36c; }
.history-delete-action { flex:none; }

.swipe-item { position:relative; margin-bottom:18rpx; overflow:hidden; border-radius:18rpx; }
.swipe-actions { position:absolute; top:0; right:0; bottom:0; display:flex; width:140rpx; }
.swipe-actions-wide { width:280rpx; }
.swipe-action { display:flex; flex:1; flex-direction:column; align-items:center; justify-content:center; color:#1d170d; background:linear-gradient(180deg,#e2c47f,#bd914a); font-size:22rpx; font-weight:600; }
.swipe-action.danger { color:#fff4f1; background:linear-gradient(180deg,#ca5a4f,#a53b37); }
.action-symbol { margin-bottom:5rpx; font-size:30rpx; line-height:1; }
.match-card { position:relative; z-index:1; padding:26rpx 26rpx 22rpx; border:1rpx solid rgba(213,183,124,.15); border-radius:18rpx; background:radial-gradient(circle at 100% 0%,rgba(173,125,65,.1),transparent 34%),linear-gradient(145deg,#172230,#111923 72%); transition:transform .18s ease,opacity .18s ease; }
.match-card-dragging { transition:none; }
.match-card-pressed { opacity:.72; transform:scale(.985); }
.match-topline { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }
.match-title-wrap { min-width:0; flex:1; }
.match-title { overflow:hidden; color:#f0f1f3; font-size:31rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.match-meta { margin-top:8rpx; overflow:hidden; color:#9da8b8; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }
.match-tools { display:flex; align-items:center; gap:8rpx; flex:none; }
.phase-tag { display:flex; align-items:center; padding:8rpx 13rpx; border-radius:8rpx; font-size:20rpx; white-space:nowrap; }
.phase-dot { width:9rpx; height:9rpx; margin-right:7rpx; border-radius:50%; background:currentColor; box-shadow:0 0 12rpx currentColor; }
.phase-registration { color:#a9d7a5; background:rgba(74,171,105,.14); }
.phase-draft { color:#dfc27c; background:rgba(215,169,72,.15); }
.phase-battle { color:#e7b480; background:rgba(203,115,69,.15); }
.phase-finished { color:#a6b0bd; background:rgba(146,161,180,.13); }
.admin-menu { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; color:#8591a1; font-size:25rpx; letter-spacing:2rpx; }
.match-rule { height:1rpx; margin:22rpx 0 20rpx; background:rgba(218,190,133,.11); }
.progress-grid { display:flex; gap:24rpx; }
.progress-block { min-width:0; flex:1; }
.progress-label { display:flex; align-items:baseline; justify-content:space-between; color:#8f9baa; font-size:22rpx; }
.progress-value { color:#e5c47d; font-size:29rpx; font-weight:650; }
.progress-total { color:#8e98a6; font-size:20rpx; font-weight:400; }
.progress-track { height:7rpx; margin-top:10rpx; overflow:hidden; border-radius:8rpx; background:rgba(255,255,255,.1); }
.progress-fill { height:100%; border-radius:inherit; }
.captain-fill { background:linear-gradient(90deg,#b88442,#e6ca87); }
.player-fill { background:linear-gradient(90deg,#52799c,#9bc6d9); }
.substitute-fill { background:linear-gradient(90deg,#3f7d58,#8fc79a); }
.match-footer { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:20rpx; padding-top:18rpx; border-top:1rpx solid rgba(218,190,133,.09); }
.creator { overflow:hidden; color:#808d9e; font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }
.creator text { color:#b3bdca; }
.match-cta { flex:none; color:#e0bd73; font-size:22rpx; font-weight:600; }
.cta-arrow { margin-left:4rpx; font-size:30rpx; font-weight:400; line-height:1; }
.champion-cta { color:#e4bf66; }
.champion-star { margin-right:4rpx; }

.loading-list { display:flex; flex-direction:column; gap:18rpx; }
.load-error { padding:34rpx 24rpx; border:1rpx solid rgba(216,117,101,.22); border-radius:16rpx; background:rgba(169,63,54,.08); text-align:center; }
.load-error-title { color:#e0a39a; font-size:27rpx; font-weight:600; }
.load-error-desc { margin-top:9rpx; color:#a99898; font-size:22rpx; line-height:1.5; }
.load-error-action { display:inline-flex; align-items:center; justify-content:center; margin-top:18rpx; padding:12rpx 28rpx; border-radius:999rpx; background:#dcae56; color:#171a20; font-size:23rpx; font-weight:600; }
.skeleton-card { padding:28rpx 26rpx; border:1rpx solid rgba(213,183,124,.1); border-radius:18rpx; background:#131c28; }
.skeleton-line { height:22rpx; border-radius:8rpx; background:linear-gradient(90deg,rgba(255,255,255,.05),rgba(255,255,255,.12),rgba(255,255,255,.05)); background-size:240% 100%; animation:skeleton-shimmer 1.5s ease-in-out infinite; }
.skeleton-title { width:42%; }
.skeleton-meta { width:64%; height:16rpx; margin-top:18rpx; }
.skeleton-bar { width:100%; height:8rpx; margin-top:27rpx; }
@keyframes skeleton-shimmer { 0% { background-position:100% 0; } 100% { background-position:-100% 0; } }
.empty-state { padding:68rpx 20rpx 76rpx; border:1rpx dashed rgba(219,183,110,.17); border-radius:18rpx; text-align:center; background:rgba(19,28,40,.62); }
.empty-emblem { color:rgba(214,176,98,.55); font-size:50rpx; text-shadow:0 0 24rpx rgba(214,176,98,.38); }
.empty-title { margin-top:14rpx; color:#dce0e7; font-size:29rpx; font-weight:600; }
.empty-desc { margin-top:9rpx; color:#818c9b; font-size:22rpx; }
.empty-action { display:inline-block; margin-top:25rpx; color:#d7b46f; font-size:23rpx; }
.empty-action text { margin-left:4rpx; font-size:32rpx; vertical-align:-2rpx; }
.home-bottom-note { padding:36rpx 0 16rpx; color:#596474; font-size:18rpx; letter-spacing:3rpx; text-align:center; }
.home-bottom-note text { margin:0 8rpx; color:#a17c43; }
.home-feedback-note { margin-top:10rpx; color:#788495; font-size:21rpx; letter-spacing:1rpx; }

.trash-section { margin-top:0; border-top:0; }
.trash-heading { display:flex; align-items:center; justify-content:space-between; min-height:104rpx; padding:0 8rpx; }
.trash-heading-copy { min-width:0; }
.trash-kicker { color:#8c7958; font-size:17rpx; font-weight:700; letter-spacing:3rpx; }
.trash-title { margin-top:6rpx; color:#c7cdd5; font-size:27rpx; font-weight:600; }
.trash-count { margin-left:8rpx; color:#8490a0; font-size:22rpx; font-weight:400; }
.trash-chevron { color:#929cab; font-size:42rpx; line-height:1; transform:rotate(90deg); transition:transform .18s ease; }
.trash-chevron-open { transform:rotate(-90deg); }
.trash-body { padding:0 8rpx 8rpx; }
.trash-empty { padding:22rpx 0; color:#7f8997; font-size:23rpx; }
.trash-state { padding:22rpx 0; color:#8792a0; font-size:22rpx; }
.trash-state-error { color:#d49289; }
.trash-retry { display:inline-flex; align-items:center; justify-content:center; min-height:48rpx; margin-top:10rpx; padding:0 20rpx; border:1rpx solid rgba(202,178,116,.3); border-radius:8rpx; color:#d9c17f; }
.trash-item { display:flex; flex-direction:column; gap:14rpx; padding:20rpx 0; border-top:1rpx solid rgba(218,190,133,.09); }
.trash-item-main { min-width:0; }
.trash-item-top { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.trash-item-title { min-width:0; overflow:hidden; color:#d8dde4; font-size:25rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.trash-item-top .phase-tag { flex:none; }
.trash-item-meta { margin-top:7rpx; color:#7f8997; font-size:20rpx; line-height:1.5; }
.trash-actions { display:flex; justify-content:flex-end; gap:12rpx; }
.trash-action { display:flex; align-items:center; justify-content:center; min-width:112rpx; min-height:54rpx; padding:0 18rpx; box-sizing:border-box; border:1rpx solid transparent; border-radius:8rpx; font-size:21rpx; font-weight:600; }
.trash-restore { border-color:rgba(202,178,116,.3); color:#d9c17f; background:rgba(202,178,116,.08); }
.trash-purge { border-color:rgba(206,99,87,.28); color:#e1998f; background:rgba(206,99,87,.08); }
.trash-action-disabled { opacity:.45; }
.trash-footnote { padding:12rpx 0 4rpx; color:#626e7d; font-size:19rpx; }

.profile-panel { max-height:83vh; }
.role-help { margin-top:10rpx; }
.char-count { margin-top:7rpx; color:#737f8f; font-size:21rpx; text-align:right; }
.dota-id-row { display:flex; align-items:center; gap:12rpx; }
.dota-id-input { flex:1; min-width:0; }
.dota-lookup-btn { flex:none; min-width:92rpx; box-sizing:border-box; text-align:center; }
.dota-help { margin-top:8rpx; line-height:1.5; }
.dota-verified-time { margin-top:8rpx; color:#7bc89b; }
.dota-lookup-result { display:flex; align-items:center; margin-top:14rpx; padding:14rpx 16rpx; border:1rpx solid rgba(224,181,111,.2); border-radius:8rpx; background:rgba(224,181,111,.06); }
.dota-lookup-copy { flex:1; min-width:0; }
.dota-player-name { overflow:hidden; color:#e8e4da; font-size:26rpx; text-overflow:ellipsis; white-space:nowrap; }
.dota-change-btn { flex:none; margin-left:12rpx; }
.verified-lock { margin-left:12rpx; color:#7bc89b; font-size:22rpx; }
@media (prefers-reduced-motion: reduce) { .skeleton-line { animation:none; } }
