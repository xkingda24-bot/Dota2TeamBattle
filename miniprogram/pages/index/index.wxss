/* pages/index/index.wxss */
.hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 44rpx 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(224, 181, 111, 0.3);
  text-align: center;
}
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.hero-scrim {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(10, 12, 18, 0.45), rgba(10, 12, 18, 0.75));
}
.hero-title {
  position: relative;
  z-index: 2;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffd98c;
  letter-spacing: 6rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
}
.hero-sub {
  position: relative;
  z-index: 2;
  font-size: 22rpx;
  color: #cfd6df;
  margin-top: 10rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.8);
}
.progress-item {
  margin-right: 48rpx;
}
.section-hint {
  font-size: 22rpx;
  color: #98a0ab;
  font-weight: 400;
}
.progress-item .num {
  font-size: 36rpx;
  font-weight: 600;
  color: #e8c27c;
}
.tip-card {
  border: 2rpx solid rgba(224, 181, 111, 0.4);
}
.tip-text {
  font-size: 24rpx;
  color: #d9c089;
  line-height: 1.6;
}
.nav-hover {
  opacity: 0.6;
}

/* 左滑卡片：归档 / 删除 */
.swipe-item {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.swipe-btns {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 280rpx;
  display: flex;
}
.swipe-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #10141c;
  background: linear-gradient(180deg, #d9b877, #c8a45c);
}
.swipe-btn.danger {
  color: #fff;
  background: linear-gradient(180deg, #d54b52, #b93a41);
}
.swipe-card {
  position: relative;
  background: linear-gradient(180deg, #1a202c 0%, #141924 100%);
  border: 1rpx solid rgba(224, 181, 111, 0.18);
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  transition: transform 0.18s ease;
}

/* 暗号验证弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel {
  width: 86%;
  background: linear-gradient(180deg, #171d29 0%, #12161f 100%);
  border: 1rpx solid rgba(224, 181, 111, 0.2);
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8c27c;
  text-align: center;
  letter-spacing: 2rpx;
}
.panel-sub {
  font-size: 24rpx;
  color: #98a0ab;
  text-align: center;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.secret-input,
.nick-input {
  margin-top: 28rpx;
  text-align: center;
}
.panel-btns {
  display: flex;
  margin-top: 28rpx;
}
.panel-btn {
  flex: 1;
  margin-top: 0;
}
.panel-btn + .panel-btn {
  margin-left: 20rpx;
}
