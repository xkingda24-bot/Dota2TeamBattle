/* pages/bracket/bracket.wxss - Dota2 风格 */
.champion-banner {
  background: linear-gradient(135deg, rgba(224, 181, 111, 0.28), rgba(200, 69, 47, 0.12));
  border: 2rpx solid rgba(224, 181, 111, 0.5);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #e8c27c;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
}
.admin-btn {
  flex: 1;
  margin-top: 0;
}

.match-card {
  border-left: 6rpx solid #e8c27c;
}
.match-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8e4da;
}
.vs-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.team {
  flex: 1;
  font-size: 28rpx;
  color: #e8e4da;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-win {
  color: #e8c27c;
  font-weight: 600;
}
.vs-center {
  width: 140rpx;
  text-align: center;
}
.score {
  color: #e8c27c;
  font-weight: 700;
  font-size: 32rpx;
}
.vs-text {
  color: #6d7480;
  font-size: 24rpx;
}
.admin-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(224, 181, 111, 0.1);
}
.picker-sm {
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.16);
  border-radius: 8rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  color: #cfd6df;
}

/* 落位调整 */
.seed-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.seed-label {
  width: 110rpx;
  font-size: 24rpx;
  color: #98a0ab;
}
.seed-row .picker {
  flex: 1;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  color: #e8e4da;
  font-size: 26rpx;
}
.seed-btn {
  flex: 1;
  margin-top: 20rpx;
}

/* 记录结果弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel {
  width: 86%;
  background: linear-gradient(180deg, #171d29 0%, #12161f 100%);
  border: 1rpx solid rgba(224, 181, 111, 0.2);
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.team-btn {
  flex: 1;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.16);
  border-radius: 10rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #e8e4da;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-btn-active {
  background: rgba(224, 181, 111, 0.18);
  border-color: #e8c27c;
  color: #e8c27c;
  font-weight: 600;
}
.field {
  margin-top: 20rpx;
}
.label {
  font-size: 24rpx;
  color: #98a0ab;
  margin-bottom: 10rpx;
}
.score-input {
  flex: 1;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 10rpx;
  padding: 14rpx 0;
  text-align: center;
  color: #e8e4da;
  font-size: 30rpx;
}
.score-colon {
  padding: 0 20rpx;
  color: #98a0ab;
}
.panel-btn {
  flex: 1;
  margin-top: 28rpx;
}
.panel-btn + .panel-btn {
  margin-left: 20rpx;
}
