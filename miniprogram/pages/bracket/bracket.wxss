/* pages/bracket/bracket.wxss - Dota2 风格 */
.tree-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}
.tree-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e8e4da;
}
.tree-toggle {
  padding: 10rpx 24rpx;
  background: rgba(224, 181, 111, 0.14);
  border: 1rpx solid rgba(224, 181, 111, 0.4);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #e8c27c;
}
.tree-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.tree-flex {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 4rpx;
}
.tree-col {
  flex-shrink: 0;
  width: 320rpx;
  margin-right: 24rpx;
  display: flex;
  flex-direction: column;
}
.tree-col-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #e8c27c;
  margin-bottom: 16rpx;
  text-align: center;
}
.tree-node {
  background: #171d29;
  border: 1rpx solid rgba(224, 181, 111, 0.35);
  border-radius: 10rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 24rpx;
}
.tree-node-head {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}
.tree-node-status {
  font-size: 20rpx;
  color: #6d7480;
}
.tree-node-status.done {
  color: #e8c27c;
}
.tree-node-team {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #e8e4da;
  padding: 6rpx 0;
  overflow: hidden;
}
.tree-node-team.win {
  color: #e8c27c;
  font-weight: 600;
}
.tn-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tn-score {
  margin-left: 12rpx;
  font-weight: 700;
}
.tree-node-arrow {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #556070;
  text-align: right;
}
.champion-banner {
  background: linear-gradient(135deg, rgba(224, 181, 111, 0.28), rgba(200, 69, 47, 0.12));
  border: 2rpx solid rgba(224, 181, 111, 0.5);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  color: #e8c27c;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 2rpx;
}
.admin-btn {
  flex: 1;
  margin-top: 0;
}

.match-card {
  border-left: 6rpx solid #e8c27c;
}
.match-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8e4da;
}
.vs-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}
.team-col {
  flex: 1;
  min-width: 0;
}
.team {
  font-size: 28rpx;
  color: #e8e4da;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-win {
  color: #e8c27c;
  font-weight: 600;
}
.team-info-btn {
  display: inline-block;
  margin-top: 10rpx;
  padding: 4rpx 16rpx;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.16);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #98a0ab;
}
.team-members {
  margin-top: 12rpx;
  background: rgba(19, 24, 33, 0.85);
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 10rpx;
  padding: 16rpx;
}
.member {
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(224, 181, 111, 0.06);
}
.member:last-child {
  border-bottom: none;
}
.member-name {
  font-size: 26rpx;
  color: #e8e4da;
  font-weight: 600;
  word-break: break-all;
}
.member-captain {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  background: rgba(224, 181, 111, 0.18);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #e8c27c;
}
.member-line {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #98a0ab;
  word-break: break-all;
}
.vs-center {
  width: 140rpx;
  text-align: center;
}
.score {
  color: #e8c27c;
  font-weight: 700;
  font-size: 32rpx;
}
.vs-text {
  color: #6d7480;
  font-size: 24rpx;
}
.admin-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(224, 181, 111, 0.1);
}
.picker-sm {
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.16);
  border-radius: 8rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  color: #cfd6df;
}

/* 落位调整 */
.seed-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.seed-label {
  width: 110rpx;
  font-size: 24rpx;
  color: #98a0ab;
}
.seed-row .picker {
  flex: 1;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  color: #e8e4da;
  font-size: 26rpx;
}
.seed-btn {
  flex: 1;
  margin-top: 20rpx;
}

/* 记录结果弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel {
  width: 86%;
  background: linear-gradient(180deg, #171d29 0%, #12161f 100%);
  border: 1rpx solid rgba(224, 181, 111, 0.2);
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.team-btn {
  flex: 1;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.16);
  border-radius: 10rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #e8e4da;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.team-btn-active {
  background: rgba(224, 181, 111, 0.18);
  border-color: #e8c27c;
  color: #e8c27c;
  font-weight: 600;
}
.field {
  margin-top: 20rpx;
}
.label {
  font-size: 24rpx;
  color: #98a0ab;
  margin-bottom: 10rpx;
}
.score-input {
  flex: 1;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 10rpx;
  padding: 14rpx 0;
  text-align: center;
  color: #e8e4da;
  font-size: 30rpx;
}
.score-colon {
  padding: 0 20rpx;
  color: #98a0ab;
}
.panel-btn {
  flex: 1;
  margin-top: 28rpx;
}
.panel-btn + .panel-btn {
  margin-left: 20rpx;
}
