<!--pages/bracket/bracket.wxml - 对战赛程-->
<nav-bar title="{{pageTitle}}" />
<tournament-flow wx:if="{{t}}" tournament="{{t}}" readonly="{{readonly}}" current="{{t.status}}" display-stage="{{stageView}}" settlement-ready="{{settlementReady}}" />
<view class="container">
  <block wx:if="{{t}}">
    <view wx:if="{{refreshError}}" class="card">
      <view class="sub">刷新失败，当前仍显示已加载的比赛信息。</view>
      <view class="btn-small btn-plain" bindtap="retryLoad">重新加载</view>
    </view>

    <!-- 分组页：我的战队资料（对战阶段通过晋级图设置） -->
    <view class="card" wx:if="{{myTeam && !readonly && t.status === 'draft'}}">
      <view class="card-title">我的战队资料</view>
      <view class="sub">你是本队天梯分最高的组长，可设置队名和队标；队名最多 10 个字，留空使用默认名称。</view>
      <view class="my-team-summary">
        <text wx:if="{{myTeam.teamIconEmoji}}" class="team-logo-mark my-team-logo">{{myTeam.teamIconEmoji}}</text>
        <text class="my-team-name">{{myTeam.captain.teamName || myTeam.defaultName}}</text>
      </view>
      <view class="btn btn-plain team-config-trigger" bindtap="openMyTeamConfig">设置队名和队标</view>
    </view>

    <!-- 队伍名单，供参赛者从流程栏返回查看 -->
    <view id="team-stage-edit-anchor" class="card group-edit-card" wx:if="{{groupedTeams.length && t.mode === 'auto' && t.status === 'draft' && isAdmin && !readonly}}">
      <view class="card-title">分组调整</view>
      <view class="group-average-summary">平均分最高 {{groupAverageStats.max}} · 最低 {{groupAverageStats.min}} · 相差 {{groupAverageStats.diff}} 分</view>
      <view class="sub">点击队员名片，再点其他组队员可交换；使用队伍右侧箭头调整首轮落位，保存后组长按组内天梯分更新。</view>
      <view wx:if="{{groupSaving}}" class="group-save-status">正在保存分组…</view>
      <view wx:if="{{groupOrderSaving}}" class="group-save-status">正在保存队伍顺序…</view>
      <view wx:if="{{groupSelection.openid}}" class="group-selection-hint">已选择：{{groupSelection.nickname}}　请点击其他组的队员完成交换 <text bindtap="clearGroupSelection">取消</text></view>
      <view class="flow-team group-edit-team" wx:for="{{groupedTeams}}" wx:key="teamIndex">
        <view class="flow-team-head group-edit-head">
          <view class="group-edit-title">
            <text wx:if="{{item.teamIconEmoji}}" class="team-logo-mark group-edit-team-logo">{{item.teamIconEmoji}}</text>
            <view class="flow-team-name">第 {{item.slot + 1}} 组 · {{item.name}}</view>
          </view>
          <view class="flow-team-average">平均分 {{item.avgMmr}}</view>
          <view class="group-order-tools">
            <view class="group-order-btn {{item.slot === 0 || groupOrderSaving ? 'group-order-disabled' : ''}}" data-slot="{{item.slot}}" data-dir="-1" catchtap="onGroupMove">↑</view>
            <view class="group-order-btn {{item.slot === groupedTeams.length - 1 || groupOrderSaving ? 'group-order-disabled' : ''}}" data-slot="{{item.slot}}" data-dir="1" catchtap="onGroupMove">↓</view>
          </view>
        </view>
        <view class="flow-team-members">
          <view wx:for="{{item.members}}" wx:key="openid" wx:for-item="member" class="group-edit-member-row">
            <view class="group-edit-select {{groupSelection.openid === member.openid ? 'group-edit-member-selected' : ''}}" data-team-index="{{item.teamIndex}}" data-openid="{{member.openid}}" bindtap="onOpenGroupSwap">
              <player-card player="{{member}}" card-style="{{member.cardStyle}}" compact="{{true}}" />
            </view>
            <view class="group-edit-replace" data-team-index="{{item.teamIndex}}" data-openid="{{member.openid}}" catchtap="onOpenGroupSubstitution">替换</view>
          </view>
        </view>
      </view>
      <view class="btn group-start-bracket {{groupOrderSaving || groupSaving ? 'btn-disabled' : ''}}" bindtap="onStartBracket">生成对阵并开始</view>
    </view>

    <view id="team-stage-anchor" class="card" wx:if="{{groupedTeams.length && (t.status === 'draft' || stageView === 'draft') && !(t.mode === 'auto' && t.status === 'draft' && isAdmin && !readonly)}}">
      <view class="card-title">{{t.mode === 'auto' ? '系统分组结果' : '参赛队伍'}}</view>
      <view wx:if="{{t.mode === 'auto'}}" class="group-average-summary">平均分最高 {{groupAverageStats.max}} · 最低 {{groupAverageStats.min}} · 相差 {{groupAverageStats.diff}} 分</view>
      <view class="flow-team {{index === 0 ? 'flow-team-first' : ''}}" wx:for="{{groupedTeams}}" wx:key="teamIndex">
        <view class="flow-team-head">
          <text wx:if="{{item.teamIconEmoji}}" class="team-logo-mark">{{item.teamIconEmoji}}</text>
          <view class="flow-team-name">{{item.name}}</view>
          <view class="flow-team-average">平均分 {{item.avgMmr}}</view>
        </view>
        <view class="flow-team-members">
          <player-card
            wx:for="{{item.members}}"
            wx:key="openid"
            wx:for-item="member"
            player="{{member}}"
            card-style="{{member.cardStyle}}"
            compact="{{true}}"
          />
        </view>
      </view>
    </view>

    <!-- 晋级树形图（赛程生成后才有） -->
    <view id="battle-stage-anchor" class="flow-anchor" wx:if="{{stageView === 'battle'}}"></view>
    <view class="tree-head" wx:if="{{stageView === 'battle' && t.matches.length > 0}}">
      <view class="tree-title">晋级树形图</view>
      <view wx:if="{{showTree}}" class="tree-toggle" bindtap="onHideTree">收起晋级图</view>
      <view wx:else class="tree-toggle" bindtap="onShowTree">查看晋级图</view>
    </view>
    <scroll-view class="tree-scroll" scroll-x wx:if="{{stageView === 'battle' && showTree}}">
      <view class="tree-canvas" style="width:{{treeW}}rpx;height:{{treeH}}rpx;">
        <!-- 连线（胜者金色实线 / 败者灰色虚线） -->
        <view
          wx:for="{{treeLines}}"
          wx:key="idx"
          wx:for-item="ln"
          class="tree-line {{ln.horizontal ? 'line-h' : 'line-v'}} {{ln.type === 'win' ? 'line-win' : 'line-lose'}}"
          style="{{ln.horizontal ? 'left:' + ln.x + 'rpx;top:' + ln.y + 'rpx;width:' + ln.w + 'rpx;' : 'left:' + ln.x + 'rpx;top:' + ln.y + 'rpx;height:' + ln.w + 'rpx;'}}"
        ></view>
        <!-- 比赛节点 -->
        <view
          wx:for="{{treeNodes}}"
          wx:key="id"
          wx:for-item="nd"
          class="tree-node tree-node-abs"
          style="left:{{nd.x}}rpx;top:{{nd.y}}rpx;"
        >
          <view class="tree-node-head">
            <text class="tree-node-status {{nd.status === 'done' ? 'done' : ''}}">{{nd.status === 'done' ? '已结束' : '待打'}}</text>
          </view>
          <view class="tree-node-team tree-node-team-clickable {{nd.status === 'done' && nd.winner === nd.teamAInfo.openid ? 'win' : ''}}" data-mid="{{nd.id}}" data-side="A" bindtap="showMembers">
            <text wx:if="{{nd.teamAInfo.teamIconEmoji}}" class="team-logo-mark tree-team-logo">{{nd.teamAInfo.teamIconEmoji}}</text>
            <text class="tn-name tn-name-clickable">{{nd.displayA}}</text>
            <text class="tn-score" wx:if="{{nd.status === 'done'}}">{{nd.scoreA}}</text>
          </view>
          <view class="tn-actions" wx:if="{{nd.stage === 'UB1'}}">
            <view wx:if="{{nd.canEditA}}" class="tn-btn tn-btn-config" data-openid="{{nd.teamACaptain.openid}}" data-name="{{nd.teamACaptain.teamName || ''}}" data-icon="{{nd.teamACaptain.teamIcon || ''}}" data-title="{{nd.displayA}}" catchtap="openTeamConfig">设置队名和队标</view>
            <view class="tn-btn tn-btn-members" data-mid="{{nd.id}}" data-side="A" catchtap="showMembers">人员详情</view>
          </view>
          <view class="tree-node-team tree-node-team-clickable {{nd.status === 'done' && nd.winner === nd.teamBInfo.openid ? 'win' : ''}}" data-mid="{{nd.id}}" data-side="B" bindtap="showMembers">
            <text wx:if="{{nd.teamBInfo.teamIconEmoji}}" class="team-logo-mark tree-team-logo">{{nd.teamBInfo.teamIconEmoji}}</text>
            <text class="tn-name tn-name-clickable">{{nd.displayB}}</text>
            <text class="tn-score" wx:if="{{nd.status === 'done'}}">{{nd.scoreB}}</text>
          </view>
          <view class="tn-actions" wx:if="{{nd.stage === 'UB1'}}">
            <view wx:if="{{nd.canEditB}}" class="tn-btn tn-btn-config" data-openid="{{nd.teamBCaptain.openid}}" data-name="{{nd.teamBCaptain.teamName || ''}}" data-icon="{{nd.teamBCaptain.teamIcon || ''}}" data-title="{{nd.displayB}}" catchtap="openTeamConfig">设置队名和队标</view>
            <view class="tn-btn tn-btn-members" data-mid="{{nd.id}}" data-side="B" catchtap="showMembers">人员详情</view>
          </view>
          <view class="tree-node-admin" wx:if="{{nd.showAdmin && nd.status !== 'done'}}">
            <picker mode="selector" range="{{nd.boRange}}" value="{{nd.boIndex}}" bindchange="onBoChange" data-id="{{nd.id}}">
              <view class="tree-picker">赛制 {{nd.bo}}</view>
            </picker>
            <view class="spacer"></view>
            <view class="btn-small tree-rec" data-id="{{nd.id}}" bindtap="recordResult">记录胜负</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 冠军 -->
    <!-- 最终结算：总决赛完成后由云函数确定性返回冠亚季军及其他名次 -->
    <view id="settlement-anchor" wx:if="{{stageView === 'settlement' && settlement}}" class="settlement-card card {{settlementEditing ? 'settlement-ordering' : ''}}">
      <view class="settlement-head">
        <view>
          <view class="card-title">最终结算</view>
          <view class="sub">双败赛制 · 名次根据已完成赛果生成</view>
        </view>
        <view class="settlement-head-tools">
          <view class="settlement-badge">{{settlementEditing ? '调整中' : '已结算'}}</view>
          <view wx:if="{{settlement.canManageOrder && !settlementEditing}}" class="btn-small btn-plain settlement-action" bindtap="onEditSettlementOrder">调整名次</view>
        </view>
      </view>
      <view wx:if="{{settlementEditing}}" class="settlement-edit-actions">
        <view class="btn-small btn-plain settlement-action" bindtap="onResetSettlementOrder">恢复自动</view>
        <view class="btn-small btn-plain settlement-action" bindtap="onCancelSettlementOrder">取消</view>
        <view class="btn-small settlement-action {{settlementSaving ? 'btn-disabled' : ''}}" bindtap="onSaveSettlementOrder">{{settlementSaving ? '保存中…' : '保存名次'}}</view>
      </view>

      <view class="podium-list">
        <view
          wx:for="{{settlement.podium}}"
          wx:key="teamId"
          wx:for-item="entry"
          class="podium-item podium-rank-{{entry.rank}}"
        >
          <view class="podium-medal">{{entry.rank === 1 ? '冠' : entry.rank === 2 ? '亚' : '季'}}</view>
          <view class="podium-main">
            <view class="podium-line">
              <view class="podium-rank">{{entry.label}}</view>
              <text wx:if="{{entry.teamIconEmoji}}" class="team-logo-mark standing-logo">{{entry.teamIconEmoji}}</text>
              <view class="podium-team">{{entry.teamName}}</view>
              <view class="spacer"></view>
              <view wx:if="{{!settlementEditing}}" class="btn-small btn-plain podium-toggle" data-team-id="{{entry.teamId}}" bindtap="toggleSettlementMembers">{{entry.showMembers ? '收起成员' : '查看成员'}}</view>
              <view wx:if="{{settlementEditing}}" class="settlement-order-controls">
                <button class="settlement-order-button" size="mini" plain="{{true}}" aria-label="上移" disabled="{{entry.orderIndex === 0 || settlementSaving}}" data-index="{{entry.orderIndex}}" data-direction="-1" bindtap="moveSettlementItem">↑</button>
                <button class="settlement-order-button" size="mini" plain="{{true}}" aria-label="下移" disabled="{{entry.orderIndex === settlement.items.length - 1 || settlementSaving}}" data-index="{{entry.orderIndex}}" data-direction="1" bindtap="moveSettlementItem">↓</button>
              </view>
            </view>
            <view class="settlement-members" wx:if="{{entry.showMembers && !settlementEditing}}">
              <view wx:if="{{!entry.members.length}}" class="sub">暂无队员资料</view>
              <player-card
                wx:for="{{entry.members}}"
                wx:key="openid"
                wx:for-item="member"
                player="{{member}}"
                card-style="{{member.cardStyle}}"
                compact="{{true}}"
              />
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{settlement.others.length}}" class="settlement-other-title">其他名次</view>
      <view
        wx:for="{{settlement.others}}"
        wx:key="teamId"
        wx:for-item="entry"
        class="standing-row"
      >
        <view class="standing-rank">{{entry.label}}</view>
        <text wx:if="{{entry.teamIconEmoji}}" class="team-logo-mark standing-logo">{{entry.teamIconEmoji}}</text>
        <view class="standing-team">{{entry.teamName}}</view>
        <view class="spacer"></view>
        <view wx:if="{{!settlementEditing}}" class="btn-small btn-plain standing-toggle" data-team-id="{{entry.teamId}}" bindtap="toggleSettlementMembers">{{entry.showMembers ? '收起' : '成员'}}</view>
        <view wx:if="{{settlementEditing}}" class="settlement-order-controls">
          <button class="settlement-order-button" size="mini" plain="{{true}}" aria-label="上移" disabled="{{entry.orderIndex === 0 || settlementSaving}}" data-index="{{entry.orderIndex}}" data-direction="-1" bindtap="moveSettlementItem">↑</button>
          <button class="settlement-order-button" size="mini" plain="{{true}}" aria-label="下移" disabled="{{entry.orderIndex === settlement.items.length - 1 || settlementSaving}}" data-index="{{entry.orderIndex}}" data-direction="1" bindtap="moveSettlementItem">↓</button>
        </view>
        <view class="standing-members" wx:if="{{entry.showMembers && !settlementEditing}}">
          <player-card
            wx:for="{{entry.members}}"
            wx:key="openid"
            wx:for-item="member"
            player="{{member}}"
            card-style="{{member.cardStyle}}"
            compact="{{true}}"
          />
        </view>
      </view>

      <view class="comments-section">
        <view class="comments-heading">
          <view class="settlement-other-title comments-title">赛后感言</view>
          <view class="comments-count">{{settlement.comments.length}} 条</view>
        </view>
        <view wx:if="{{!settlement.comments.length}}" class="comments-empty">还没有感言，欢迎参赛者和管理员分享这场比赛。</view>
        <view wx:for="{{settlement.comments}}" wx:key="viewKey" wx:for-item="comment" class="comment-item">
          <view class="comment-author">{{comment.nickname}}<text wx:if="{{comment.isMine}}" class="comment-mine">我</text></view>
          <view class="comment-text">{{comment.text}}</view>
        </view>
        <view wx:if="{{settlement.canComment}}" class="comment-editor">
          <view class="comment-hint">每位参赛者和管理员可发布一条感言，之后可以修改（最多 100 字）</view>
          <textarea
            class="comment-input"
            maxlength="100"
            auto-height
            value="{{commentText}}"
            placeholder="写下你对这场比赛的感受…"
            placeholder-class="ph"
            bindinput="onCommentInput"
          />
          <view class="row comment-actions">
            <view class="spacer"></view>
            <view class="btn-small {{commentSaving ? 'btn-disabled' : ''}}" bindtap="onSubmitComment">{{commentSaving ? '提交中…' : (settlement.myComment ? '保存修改' : '发表感言')}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 对阵调整（选人/分组完成后、生成对阵前） -->
    <view class="card" wx:if="{{stageView !== 'battle' && showSeeding && t.mode !== 'auto'}}">
      <view class="card-title">对阵调整（胜者组第一轮落位）</view>
      <view class="sub">共 {{t.N}} 个落位，相邻两个落位互为第一轮对手；可用上移/下移调整顺序或随机排位</view>
      <view class="seed-row" wx:for="{{seedSlots}}" wx:key="slot">
        <view class="seed-col">
          <view class="seed-label">落位 {{item.slot + 1}}</view>
          <view class="seed-name">{{item.name}}</view>
          <view class="seed-members">
            <player-card
              wx:for="{{item.members}}"
              wx:key="openid"
              wx:for-item="m"
              player="{{m}}"
              card-style="{{m.cardStyle}}"
              compact="{{true}}"
            />
          </view>
        </view>
        <view class="seed-btns">
          <view class="btn-small btn-plain seed-move" data-slot="{{item.slot}}" data-dir="-1" bindtap="onSeedMove">上移</view>
          <view class="btn-small btn-plain seed-move" data-slot="{{item.slot}}" data-dir="1" bindtap="onSeedMove">下移</view>
        </view>
      </view>
      <view class="row">
        <view class="btn btn-plain seed-btn" bindtap="onShuffleSeeding">随机排位</view>
        <view class="spacer"></view>
        <view class="btn seed-btn" bindtap="onStartBracket">生成对阵并开始</view>
      </view>
    </view>

    <!-- 选人/分组阶段管理 -->
    <view class="card" wx:if="{{isAdmin && !readonly && t.status === 'draft'}}">
      <view class="card-title">赛前管理</view>
      <view class="sub" wx:if="{{t.mode !== 'auto'}}">队伍信息有误时可替换队员；退回报名会清除队伍和选人进度，但保留报名名单。</view>
      <view class="sub" wx:else>退回报名会清除分组结果，但保留报名名单。</view>
      <view class="replacement-list" wx:if="{{replacementTeams.length && t.mode !== 'auto'}}">
        <view class="replacement-row" wx:for="{{replacementTeams}}" wx:key="teamIndex">
          <view class="replacement-team">{{item.teamName}}</view>
          <view class="spacer"></view>
          <view class="btn-small btn-plain" data-index="{{index}}" bindtap="onOpenReplacement">替换队员</view>
        </view>
      </view>
      <view class="sub" wx:elif="{{t.mode !== 'auto'}}">暂无可替换队员；需要该队已有队员，并且仍有未选队员或候补。</view>
      <view class="btn btn-plain" data-stage="registration" bindtap="onRollbackStage">退回报名阶段</view>
    </view>

    <view wx:if="{{stageView === 'battle' && t.matches.length === 0}}" class="empty">赛程还未生成（需先完成选人）</view>

    <!-- 对战阶段管理 -->
    <view class="card" wx:if="{{isAdmin && !readonly && t.status === 'battle' && t.mode === 'auto'}}">
      <view class="card-title">系统分组管理</view>
      <view class="sub">可清除当前赛程和落位，保留现有队伍名单，返回分组页面继续微调；调整完成后需要重新生成对阵。</view>
      <view class="btn btn-plain" data-stage="draft" bindtap="onRollbackStage">退回分组页面</view>
    </view>

    <!-- 管理员操作（结束/删除） -->
    <view class="card" wx:if="{{isAdmin && !readonly && t.status === 'finished'}}">
      <view class="card-title">管理员操作</view>
      <view class="sub">{{t.status === 'finished' ? '本场比赛已结束，归档后主页不再显示' : '比赛结束后（产生冠军）才可归档'}}</view>
      <view class="row">
        <view class="btn btn-plain admin-btn" wx:if="{{t.status === 'battle' || t.status === 'finished'}}" bindtap="onFinish">{{t.status === 'finished' ? '归档到历史' : '结束并归档'}}</view>
        <view class="spacer"></view>
        <view class="btn btn-danger admin-btn" bindtap="onDelete">删除比赛</view>
      </view>
    </view>
  </block>

  <view wx:elif="{{loading}}" class="card">
    <view class="card-title">正在加载比赛</view>
    <view class="sub">正在读取赛程和结算信息，请稍候…</view>
  </view>

  <view wx:elif="{{loadError && !notFound}}" class="card">
    <view class="card-title">比赛加载失败</view>
    <view class="sub">{{loadError}}</view>
    <view class="btn" bindtap="retryLoad">重试</view>
    <view class="btn btn-plain" bindtap="goBack">返回</view>
  </view>

  <view wx:else class="card">
    <view class="card-title">暂无比赛</view>
    <view class="btn btn-plain" bindtap="goBack">返回主页</view>
  </view>

  <!-- 记录结果弹层 -->
  <view class="mask" wx:if="{{showPanel}}">
    <view class="panel">
      <view class="card-title">{{panelMatch.label}}</view>
      <view class="sub">赛制 {{panelMatch.bo}} · 胜者晋级，败者跌入败者组或淘汰（自动）</view>
      <view class="divider"></view>
      <view class="vs-row">
        <view class="team-btn {{panelWinner === panelMatch.teamAInfo.openid ? 'team-btn-active' : ''}}" data-winner="{{panelMatch.teamAInfo.openid}}" bindtap="pickWinner">{{panelMatch.displayA}}</view>
        <view class="vs-text">VS</view>
        <view class="team-btn {{panelWinner === panelMatch.teamBInfo.openid ? 'team-btn-active' : ''}}" data-winner="{{panelMatch.teamBInfo.openid}}" bindtap="pickWinner">{{panelMatch.displayB}}</view>
      </view>
      <view class="field" wx:if="{{panelMatch.bo !== 'BO1'}}">
        <view class="label">比分（{{panelMatch.bo}}）</view>
        <view class="row">
          <input class="score-input" type="number" value="{{scoreA}}" bindinput="onScoreA" placeholder="0" />
          <view class="score-colon">:</view>
          <input class="score-input" type="number" value="{{scoreB}}" bindinput="onScoreB" placeholder="0" />
        </view>
      </view>
      <view class="row">
        <view class="btn btn-plain panel-btn" bindtap="closePanel">取消</view>
        <view class="spacer"></view>
        <view class="btn panel-btn" bindtap="confirmResult">确认记录</view>
      </view>
    </view>
  </view>

  <!-- 队员信息弹层（晋级树图用） -->
  <view class="mask" wx:if="{{memberPanel.show}}">
    <view class="panel">
      <view class="card-title">{{memberPanel.title}}</view>
      <view class="sub">队员名片信息（只读）</view>
      <view class="divider"></view>
      <view wx:if="{{!memberPanel.members.length}}" class="sub">暂无队员信息</view>
      <player-card
        wx:for="{{memberPanel.members}}"
        wx:key="openid"
        wx:for-item="p"
        player="{{p}}"
        card-style="{{p.cardStyle}}"
        compact="{{true}}"
      />
      <view class="row">
        <view class="btn panel-btn" bindtap="closeMembers">关闭</view>
      </view>
    </view>
  </view>

  <!-- 管理员替换队员 -->
  <view class="mask" wx:if="{{replacementPanel.show}}">
    <view class="panel">
      <view class="card-title">替换队员</view>
      <view class="sub">{{replacementPanel.teamName}} · 换下队员会进入{{replacementPanel.incomingLabel}}。</view>
      <view class="field">
        <view class="label">换下</view>
        <view class="replacement-choice">
          <player-card player="{{replacementPanel.outPlayers[replacementPanel.outIndex]}}" card-style="{{replacementPanel.outPlayers[replacementPanel.outIndex].cardStyle}}" compact="{{true}}" />
          <view wx:if="{{t.mode !== 'auto'}}" class="btn-small btn-plain replacement-change" bindtap="onOpenReplacementOptions" data-field="outIndex">选择其他队员</view>
        </view>
      </view>
      <view class="field">
        <view class="label">换上</view>
        <view class="replacement-choice">
          <player-card player="{{replacementPanel.inPlayers[replacementPanel.inIndex]}}" card-style="{{replacementPanel.inPlayers[replacementPanel.inIndex].cardStyle}}" compact="{{true}}" />
          <view class="btn-small btn-plain replacement-change" bindtap="onOpenReplacementOptions" data-field="inIndex">选择其他队员</view>
        </view>
      </view>
      <view class="row">
        <view class="btn btn-plain panel-btn" bindtap="onCloseReplacement">取消</view>
        <view class="spacer"></view>
        <view class="btn panel-btn {{replacementSaving ? 'btn-disabled' : ''}}" bindtap="onConfirmReplacement">{{replacementSaving ? '保存中…' : '确认替换'}}</view>
      </view>
    </view>
    <view class="replacement-options-mask" wx:if="{{replacementPanel.selecting}}" catchtap="onCloseReplacementOptions">
      <view class="replacement-options-panel" catchtap="noop">
        <view class="panel-title">{{replacementPanel.selecting === 'outIndex' ? '选择换下队员' : '选择换上队员'}}</view>
        <scroll-view scroll-y class="replacement-options-list">
          <view
            wx:for="{{replacementPanel.selecting === 'outIndex' ? replacementPanel.outPlayers : replacementPanel.inPlayers}}"
            wx:key="openid"
            class="replacement-option"
            data-field="{{replacementPanel.selecting}}"
            data-index="{{index}}"
            bindtap="onSelectReplacementPlayer"
          >
            <player-card player="{{item}}" card-style="{{item.cardStyle}}" compact="{{true}}" />
          </view>
        </scroll-view>
        <view class="panel-btns">
          <view class="panel-btn btn-plain" bindtap="onCloseReplacementOptions">取消</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 晋级图第一轮：设置队名和队标（队长本人或管理员） -->
  <view class="mask" wx:if="{{teamConfigPanel.show}}">
    <view class="panel">
      <view class="card-title">设置队名和队标</view>
      <view class="sub">{{teamConfigPanel.title}} · 队名最多 10 个字，留空用默认名</view>
      <view class="field">
        <view class="label">队伍名称</view>
        <input class="input team-name-input" maxlength="10" placeholder="输入战队名（选填）" placeholder-class="ph" value="{{teamConfigPanel.name}}" bindinput="onTeamConfigNameInput" />
      </view>
      <view class="field">
        <view class="label">战队队标</view>
        <view class="team-logo-options">
          <view wx:for="{{teamLogos}}" wx:key="id" class="team-logo-option {{teamConfigPanel.icon === item.id ? 'team-logo-option-active' : ''}}" data-id="{{item.id}}" bindtap="onTeamConfigIconSelect">
            <text class="team-logo-emoji">{{item.emoji}}</text>
            <text>{{item.name}}</text>
          </view>
          <view class="team-logo-clear" bindtap="onTeamConfigIconClear">不使用队标</view>
        </view>
      </view>
      <view class="row">
        <view class="btn btn-plain panel-btn" bindtap="closeTeamConfig">取消</view>
        <view class="spacer"></view>
        <view class="btn panel-btn {{teamConfigSaving ? 'btn-disabled' : ''}}" bindtap="saveTeamConfig">{{teamConfigSaving ? '保存中…' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>

<!-- 比赛卡片模板 -->
<template name="matchCard">
  <view class="card match-card">
    <view class="row">
      <view class="match-label">{{label}}</view>
      <view class="spacer"></view>
      <view class="tag {{status === 'done' ? 'tag-green' : 'tag-blue'}}">{{status === 'done' ? '已结束' : '待打'}}</view>
    </view>
    <view class="vs-row">
      <view class="team-col">
        <view class="team team-clickable {{status === 'done' && winner === teamAInfo.openid ? 'team-win' : ''}}" data-id="{{id}}" data-side="A" bindtap="showMembers"><text wx:if="{{teamAInfo.teamIconEmoji}}" class="team-logo-mark match-team-logo">{{teamAInfo.teamIconEmoji}}</text><text>{{displayA}}</text></view>
        <view class="team-info-btn" wx:if="{{membersA}}" bindtap="toggleTeam" data-id="{{id}}" data-side="A">队员信息 {{expandedA ? '收起' : '展开'}}</view>
      </view>
      <view class="vs-center">
        <view class="score" wx:if="{{status === 'done'}}">{{scoreA}} : {{scoreB}}</view>
        <view class="vs-text" wx:else>VS</view>
      </view>
      <view class="team-col">
        <view class="team team-clickable {{status === 'done' && winner === teamBInfo.openid ? 'team-win' : ''}}" data-id="{{id}}" data-side="B" bindtap="showMembers"><text wx:if="{{teamBInfo.teamIconEmoji}}" class="team-logo-mark match-team-logo">{{teamBInfo.teamIconEmoji}}</text><text>{{displayB}}</text></view>
        <view class="team-info-btn" wx:if="{{membersB}}" bindtap="toggleTeam" data-id="{{id}}" data-side="B">队员信息 {{expandedB ? '收起' : '展开'}}</view>
      </view>
    </view>
    <view class="team-members" wx:if="{{expandedA && membersA}}">
      <player-card
        wx:for="{{membersA}}"
        wx:key="openid"
        player="{{item}}"
        card-style="{{item.cardStyle}}"
        compact="{{true}}"
      />
    </view>
    <view class="team-members" wx:if="{{expandedB && membersB}}">
      <player-card
        wx:for="{{membersB}}"
        wx:key="openid"
        player="{{item}}"
        card-style="{{item.cardStyle}}"
        compact="{{true}}"
      />
    </view>
    <view class="row admin-row" wx:if="{{showAdmin && status !== 'done'}}">
      <picker mode="selector" range="{{boRange}}" value="{{boIndex}}" bindchange="onBoChange" data-id="{{id}}">
        <view class="picker-sm">赛制设置：{{bo}}</view>
      </picker>
      <view class="spacer"></view>
      <view class="btn-small" data-id="{{id}}" bindtap="recordResult">记录胜负</view>
    </view>
    <view class="row admin-row" wx:if="{{showAdmin && status === 'done'}}">
      <view class="sub">已结束</view>
      <view class="spacer"></view>
      <view class="btn-small btn-danger" data-id="{{id}}" bindtap="resetResult">修正结果</view>
    </view>
  </view>
</template>
