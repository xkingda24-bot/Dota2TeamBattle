.logo-list { margin-top: 16rpx; }
.logo-row { display:flex; align-items:center; min-height:88rpx; padding:10rpx 0; border-bottom:1rpx solid rgba(224,181,111,.09); }
.logo-row:last-child { border-bottom:0; }
.logo-image { flex:none; width:64rpx; height:64rpx; border-radius:8rpx; background:rgba(255,255,255,.035); }
.logo-name { min-width:0; margin-left:16rpx; color:#e8e4da; font-size:25rpx; }
.logo-order { flex:none; width:38rpx; margin-left:auto; color:#7f8a98; text-align:center; font-size:21rpx; }
.logo-actions { display:flex; flex:none; gap:8rpx; margin-left:12rpx; }
.icon-btn { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border:1rpx solid rgba(224,181,111,.2); border-radius:8rpx; color:#d9c38d; background:#1a2130; font-size:28rpx; }
.icon-hide { color:#d68c7f; }
.icon-disabled { opacity:.35; }
.hidden-grid { display:flex; flex-wrap:wrap; margin:8rpx 0 0 -10rpx; }
.hidden-item { display:flex; flex:0 0 calc(25% - 10rpx); flex-direction:column; align-items:center; min-width:0; margin:10rpx 0 0 10rpx; padding:14rpx 6rpx; border:1rpx solid rgba(224,181,111,.1); border-radius:10rpx; background:rgba(255,255,255,.025); box-sizing:border-box; }
.hidden-image { width:74rpx; height:74rpx; }
.hidden-name { max-width:100%; margin-top:8rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#c5c0b5; font-size:21rpx; }
.restore-btn { margin-top:10rpx; padding:4rpx 18rpx; }
.note { padding:4rpx 10rpx 28rpx; color:#7f8a98; font-size:21rpx; line-height:1.55; }
