<nav-bar title="队标库管理" />
<view class="container">
  <view wx:if="{{loading}}" class="card">
    <view class="card-title">正在加载队标</view>
  </view>
  <view wx:elif="{{loadError}}" class="card">
    <view class="card-title">队标列表加载失败</view>
    <view class="sub">{{loadError}}</view>
    <view class="btn btn-plain" bindtap="retryLoad">重试</view>
  </view>
  <view wx:elif="{{accessDenied}}" class="card">
    <view class="card-title">没有管理权限</view>
    <view class="sub">队标库仅最高管理员可以管理。</view>
  </view>
  <block wx:else>
    <view class="card">
      <view class="card-title">当前队标（{{activeLogos.length}}）</view>
      <view class="sub">可上移、下移或隐藏队标；调整顺序会立即保存，已使用的队标仍保留在历史赛果中。</view>
      <view wx:if="{{!activeLogos.length}}" class="empty">至少保留一个可用队标</view>
      <view class="logo-list">
        <view class="logo-row" wx:for="{{activeLogos}}" wx:key="id">
          <image class="logo-image" src="{{item.src}}" mode="aspectFit" />
          <view class="logo-name">{{item.name}}</view>
          <view class="logo-order">{{index + 1}}</view>
          <view class="logo-actions">
            <view class="icon-btn {{index === 0 || busy ? 'icon-disabled' : ''}}" data-index="{{index}}" data-direction="-1" bindtap="move" aria-label="上移">↑</view>
            <view class="icon-btn {{index === activeLogos.length - 1 || busy ? 'icon-disabled' : ''}}" data-index="{{index}}" data-direction="1" bindtap="move" aria-label="下移">↓</view>
            <view class="icon-btn icon-hide {{busy ? 'icon-disabled' : ''}}" data-index="{{index}}" bindtap="remove" aria-label="删除">×</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{hiddenLogos.length}}">
      <view class="card-title">可增加的内置队标（{{hiddenLogos.length}}）</view>
      <view class="hidden-grid">
        <view class="hidden-item" wx:for="{{hiddenLogos}}" wx:key="id">
          <image class="hidden-image" src="{{item.src}}" mode="aspectFit" />
          <view class="hidden-name">{{item.name}}</view>
          <view class="btn-small btn-plain restore-btn {{busy ? 'icon-disabled' : ''}}" data-index="{{index}}" bindtap="restore">增加</view>
        </view>
      </view>
    </view>
    <view class="note">队标随小程序安装包发布。目前可管理内置队标；自定义图片上传需要额外配置云存储。</view>
  </block>
</view>
