/* pages/draft/draft.wxss */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  background: #1a2130;
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid rgba(224, 181, 111, 0.16);
  min-width: 120rpx;
}
.chip-active {
  background: rgba(224, 181, 111, 0.16);
  border-color: #e8c27c;
}
.chip-title {
  font-size: 24rpx;
  color: #e8c27c;
  font-weight: 600;
}
.chip-name {
  font-size: 26rpx;
  color: #e8e4da;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rule-tip {
  font-size: 22rpx;
  color: #6b7583;
  margin-top: 16rpx;
}
.team-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.team-card {
  width: 100%;
  background: #141a26;
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 12rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.team-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.team-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #e8c27c;
  margin-right: 8rpx;
}
.team-players {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.team-players .player-card,
.draft-player-row .player-card {
  width: 100%;
}
.draft-pick-tip { margin-left: 12rpx; color: #9a917f; font-size: 22rpx; font-weight: 400; }
.draft-player-row { padding: 12rpx 0; border-bottom: 1rpx solid rgba(224, 181, 111, .12); }
.draft-player-row:last-child { border-bottom: 0; }
.nick {
  font-size: 28rpx;
  color: #e8e4da;
}

/* 选人页替补席（分组阶段仍可收替补，管理者可移出） */
.waitlist-card { border-color: rgba(224,181,111,.28); }
.waitlist-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(224,181,111,.1);
}
.waitlist-row .player-card { flex: 1; min-width: 0; }
.waitlist-target { flex: 1; min-width: 0; }
.waitlist-target-disabled { opacity: .55; }
.waitlist-target-tip { margin-top: 8rpx; padding-left: 4rpx; font-size: 22rpx; color: #8d8578; letter-spacing: .5rpx; }
.waitlist-view { margin-left: 18rpx; padding: 2rpx 0 2rpx 10rpx; font-size: 24rpx; color: #e0b56f; letter-spacing: 1rpx; }
.waitlist-view-arrow { font-size: 26rpx; }
.waitlist-mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; padding: 30rpx; box-sizing: border-box; background: rgba(0,0,0,.78); }
.waitlist-panel { display: flex; flex-direction: column; width: 100%; max-height: 82vh; padding: 28rpx; box-sizing: border-box; border: 1rpx solid rgba(224,181,111,.2); border-radius: 16rpx; background: linear-gradient(180deg,#171d29 0%,#12161f 100%); }
.waitlist-panel-list { min-height: 0; height: 56vh; max-height: 56vh; }
.waitlist-empty { padding: 40rpx 0; text-align: center; }
.waitlist-close { margin-top: 20rpx; }
.waitlist-cancel { border-color: rgba(209,84,63,.45); color: #ff9e91; }
.waitlist-join { margin-top: 20rpx; }

/* 选人完成后：队伍名单内直接交换 / 替换（与系统分组页一致） */
.roster-edit-tip { margin: -6rpx 0 12rpx; }
.roster-selection-hint {
  margin-bottom: 14rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid rgba(75,201,255,.3);
  border-radius: 8rpx;
  background: rgba(44,151,207,.12);
  color: #91dcff;
  font-size: 23rpx;
  line-height: 1.5;
}
.roster-selection-hint text { margin-left: 12rpx; color: #98a0ab; }
/* 平均分与极差：与系统分组页同一套数值口径和样式 */
.group-average-summary { margin: -4rpx 0 10rpx; color: #9bdef8; font-size: 23rpx; line-height: 1.5; }
.team-average { flex: none; margin-right: 12rpx; color: #9bdef8; font-size: 23rpx; font-weight: 600; white-space: nowrap; }
.roster-member-row { display: flex; align-items: stretch; gap: 10rpx; }
.roster-member-select { flex: 1; min-width: 0; padding: 2rpx; border: 1rpx solid transparent; border-radius: 12rpx; box-sizing: border-box; }
.roster-member-select .player-card { width: 100%; }
.roster-member-selected { border-color: rgba(75,201,255,.88); background: rgba(44,151,207,.14); box-shadow: 0 0 16rpx rgba(49,178,238,.28); }
.roster-member-replace {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 48rpx;
  border: 1rpx solid rgba(100,190,231,.38);
  border-radius: 8rpx;
  box-sizing: border-box;
  color: #9bdef8;
  background: rgba(43,111,145,.18);
  font-size: 26rpx;
  line-height: 1;
}
.substitute-scroll { min-height: 0; max-height: 56vh; margin-top: 8rpx; }
.substitute-row { display: flex; align-items: center; gap: 12rpx; padding: 10rpx 0; border-bottom: 1rpx solid rgba(224,181,111,.12); }
.substitute-row:last-child { border-bottom: 0; }
.substitute-row .player-card { flex: 1; min-width: 0; }
.substitute-tag { flex: none; }
