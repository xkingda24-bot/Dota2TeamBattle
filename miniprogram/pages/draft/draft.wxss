/* pages/draft/draft.wxss */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  background: #1a2130;
  border-radius: 10rpx;
  padding: 12rpx 18rpx;
  border: 2rpx solid rgba(224, 181, 111, 0.16);
  min-width: 120rpx;
}
.chip-active {
  background: rgba(224, 181, 111, 0.16);
  border-color: #e8c27c;
}
.chip-title {
  font-size: 24rpx;
  color: #e8c27c;
  font-weight: 600;
}
.chip-name {
  font-size: 26rpx;
  color: #e8e4da;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rule-tip {
  font-size: 22rpx;
  color: #6b7583;
  margin-top: 16rpx;
}
.team-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.team-card {
  width: 48.5%;
  background: #141a26;
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 12rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.team-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.team-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #e8c27c;
  margin-right: 8rpx;
}
.team-players {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.player-chip {
  background: #1a2130;
  border-radius: 8rpx;
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  color: #cfd6df;
  min-width: 96rpx;
}
.pc-name {
  font-size: 22rpx;
  color: #cfd6df;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pc-roles {
  font-size: 20rpx;
  color: #c9b98f;
  margin-top: 2rpx;
}
.nick {
  font-size: 28rpx;
  color: #e8e4da;
}
