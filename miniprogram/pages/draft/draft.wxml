<!--pages/draft/draft.wxml - 队长选人-->
<nav-bar title="队长选人" />
<tournament-flow wx:if="{{t}}" tournament="{{t}}" readonly="{{readonly}}" display-stage="{{stageView}}" settlement-ready="{{t.standings && t.standings.complete}}" />
<view class="container">
  <view wx:if="{{refreshError}}" class="card">
    <view class="sub">刷新失败，当前显示的是上次加载的数据。</view>
    <view class="btn-small btn-plain" bindtap="retryLoad">重新加载</view>
  </view>
  <block wx:if="{{t && t.draftInfo}}">
    <!-- 轮次状态 -->
    <view class="card">
      <view class="row">
        <view class="card-title">{{pickStateText}}</view>
        <view class="spacer"></view>
        <view wx:if="{{t.draftInfo.done}}" class="tag tag-green">选人完成</view>
        <view wx:elif="{{canPick}}" class="tag tag-red">轮到你了！</view>
        <view wx:else class="tag tag-blue">等待 {{t.draftInfo.currentCaptain ? t.draftInfo.currentCaptain.nickname : ''}}</view>
      </view>
      <view class="sub" wx:if="{{!t.draftInfo.done}}">当前：队长{{t.draftInfo.capIdx + 1}}（{{t.draftInfo.currentCaptain ? t.draftInfo.currentCaptain.nickname : ''}}）选人</view>
      <view class="divider"></view>
      <!-- 本轮选人顺序 -->
      <view class="chips">
        <view class="chip {{item.active ? 'chip-active' : ''}}" wx:for="{{orderChips}}" wx:key="idx">
          <view class="chip-title">队长{{item.idx + 1}}</view>
          <view class="chip-name">{{item.nickname}}</view>
        </view>
      </view>
      <view class="rule-tip">严格按顺序轮流：上一个队长未选，下一个队长不能选（系统强制）</view>
    </view>

    <!-- 队伍名单 -->
    <view class="section">队伍名单</view>
    <view wx:if="{{rosterEditable}}" class="sub roster-edit-tip">点击队员名片，再点其他队队员即可交换；点队员右侧「替换」可用未选队员或替补换人。队长不参与交换。</view>
    <view wx:if="{{rosterSaving}}" class="sub roster-edit-tip">正在保存阵容…</view>
    <view wx:if="{{rosterSelection.openid}}" class="roster-selection-hint">已选择：{{rosterSelection.nickname}}　请点击其他队的队员完成交换 <text bindtap="clearRosterSelection">取消</text></view>
    <view class="team-grid">
      <view class="team-card" wx:for="{{t.draftInfo.picks}}" wx:key="teamIndex">
        <view class="team-head">
          <view class="team-name">{{item.captain && item.captain.teamName ? item.captain.teamName : '队长' + (item.teamIndex + 1)}}</view>
          <view class="spacer"></view>
          <view class="tag tag-gray">{{item.players.length}}/{{t.K}}</view>
        </view>
        <view class="team-players" wx:if="{{item.captain || item.players.length}}">
          <block wx:if="{{rosterEditable}}">
            <view wx:if="{{item.captain}}" class="roster-member-row">
              <view
                class="roster-member-select {{rosterSelection.openid === item.captain.openid ? 'roster-member-selected' : ''}}"
                data-team-index="{{item.teamIndex}}"
                data-openid="{{item.captain.openid}}"
                data-is-captain="true"
                bindtap="onTapRosterMember"
              >
                <player-card player="{{item.captain}}" card-style="{{item.captain.cardStyle}}" />
              </view>
            </view>
            <view class="roster-member-row" wx:for="{{item.players}}" wx:key="openid" wx:for-item="p">
              <view
                class="roster-member-select {{rosterSelection.openid === p.openid ? 'roster-member-selected' : ''}}"
                data-team-index="{{item.teamIndex}}"
                data-openid="{{p.openid}}"
                bindtap="onTapRosterMember"
              >
                <player-card player="{{p}}" card-style="{{p.cardStyle}}" />
              </view>
              <view class="roster-member-replace" data-team-index="{{item.teamIndex}}" data-openid="{{p.openid}}" catchtap="onOpenSubstitution">替换</view>
            </view>
          </block>
          <block wx:else>
            <player-card wx:if="{{item.captain}}" player="{{item.captain}}" card-style="{{item.captain.cardStyle}}" />
            <player-card
              wx:for="{{item.players}}"
              wx:key="openid"
              wx:for-item="p"
              player="{{p}}"
              card-style="{{p.cardStyle}}"
            />
          </block>
        </view>
        <view class="sub" wx:else>未选队员</view>
      </view>
    </view>

    <!-- 剩余队员（仅选人阶段） -->
    <block wx:if="{{t.status === 'draft' && !readonly}}">
      <view class="section">可选队员（{{t.draftInfo.remainingPlayers.length}}）<text class="draft-pick-tip">队长点击名片选择，管理员可代选</text></view>
      <view wx:if="{{t.draftInfo.remainingPlayers.length === 0}}" class="empty">没有剩余队员了</view>
      <view wx:else class="card draft-player-list">
        <view
          class="draft-player-row"
          wx:for="{{t.draftInfo.remainingPlayers}}"
          wx:key="openid"
          data-openid="{{item.openid}}"
          data-name="{{item.nickname}}"
          bindtap="onPick"
          aria-disabled="{{!canPick && !canManage}}"
        >
          <player-card player="{{item}}" card-style="{{item.cardStyle}}" />
        </view>
      </view>
    </block>

    <!-- 比赛管理者 -->
    <view class="card" wx:if="{{canManage && !readonly}}">
      <view class="card-title">比赛管理操作</view>
      <view class="sub">可代当前轮次队长选人；选人完成后可直接在队伍名单里交换队员、用未选队员或替补替换阵容，再生成对阵。</view>
      <view class="btn" wx:if="{{t.draftInfo.done}}" bindtap="onStartBracket">生成对阵并进入对战</view>
      <view class="btn btn-plain" bindtap="onResetDraft">重置选人（按天梯分重新排序）</view>
      <view wx:if="{{canDelete && !readonly}}" class="btn btn-danger" bindtap="onDelete">删除比赛</view>
    </view>

    <!-- 替补席（分组阶段仍可继续收替补，管理者可移出） -->
    <view class="card waitlist-card" wx:if="{{t.status === 'draft'}}">
      <view class="row">
        <view class="card-title">替补席</view>
        <view class="spacer"></view>
        <view class="tag {{waitlistPlayers.length ? 'tag-blue' : 'tag-gray'}}">{{waitlistPlayers.length}} / {{t.waitLimit}}</view>
        <view class="waitlist-view" bindtap="onOpenWaitlistPanel">查看 <text class="waitlist-view-arrow">›</text></view>
      </view>
      <view class="sub">{{waitlistPlayers.length ? (canManage && !readonly ? '分组还在进行，替补席位没报满前其他玩家仍可报名替补；点「查看替补」可看名单并移出替补。' : '分组还在进行，替补席位没报满前仍可报名替补。') : (t.waitLimit > 0 ? '替补席位还空着，其他玩家仍可报名替补。' : '本场比赛没有设置替补席位。')}}</view>
      <view wx:if="{{!t.myReg && t.waitLimit > 0 && waitlistPlayers.length < t.waitLimit && !readonly}}" class="btn btn-plain waitlist-join {{waitlistJoining ? 'btn-disabled' : ''}}" aria-disabled="{{waitlistJoining}}" bindtap="onJoinWaitlist">
          {{waitlistJoining ? '报名中…' : '我要报名替补'}}<text wx:if="{{!waitlistJoining}}">（剩 {{t.waitLimit - waitlistPlayers.length}} 个席位）</text>
        </view>
        <view wx:elif="{{t.myReg && t.myReg.role === 'waitlist' && !readonly}}" class="btn btn-plain waitlist-join waitlist-cancel {{waitlistRemoving === 'self' ? 'btn-disabled' : ''}}" aria-disabled="{{waitlistRemoving === 'self'}}" bindtap="confirmCancelWaitlist">
          {{waitlistRemoving === 'self' ? '正在取消…' : '取消自己的替补报名'}}
      </view>
    </view>

    <!-- 替补席弹窗：名单收起来，点「查看替补」才展开 -->
    <view wx:if="{{waitlistPanelVisible}}" class="waitlist-mask" catchtap="onCloseWaitlistPanel">
      <view class="waitlist-panel" catchtap="noopStop">
        <view class="row">
          <view class="card-title">替补席</view>
          <view class="spacer"></view>
          <view class="tag {{waitlistPlayers.length ? 'tag-blue' : 'tag-gray'}}">{{waitlistPlayers.length}} / {{t.waitLimit}}</view>
        </view>
        <view class="sub">{{waitlistPlayers.length ? (canManage && !readonly ? '点替补名片可把他移出替补席（确认后生效）。' : '当前替补名单。') : '替补席还没有人报名。'}}</view>
        <scroll-view scroll-y class="waitlist-panel-list">
          <view class="waitlist-row" wx:for="{{waitlistPlayers}}" wx:key="openid">
            <view class="waitlist-target {{waitlistRemoving === item.openid ? 'waitlist-target-disabled' : ''}}" data-openid="{{item.openid}}" data-nickname="{{item.nickname}}" catchtap="onTapWaitlistMember">
              <player-card player="{{item}}" card-style="{{item.cardStyle}}" />
              <view wx:if="{{t.myOpenid === item.openid}}" class="waitlist-target-tip">我自己</view>
              <view wx:elif="{{canManage && !readonly}}" class="waitlist-target-tip">点名片可移出替补席</view>
            </view>
          </view>
        </scroll-view>
        <view class="btn btn-plain waitlist-close" catchtap="onCloseWaitlistPanel">关闭</view>
      </view>
    </view>

  </block>

  <view wx:elif="{{loading}}" class="card">
    <view class="card-title">正在加载比赛</view>
    <view class="sub">请稍候…</view>
  </view>

  <view wx:elif="{{loadError}}" class="card">
    <view class="card-title">比赛加载失败</view>
    <view class="sub">{{loadError}}</view>
    <view class="btn" bindtap="retryLoad">重试</view>
    <view class="btn btn-plain" bindtap="goBack">返回主页</view>
  </view>

  <view wx:elif="{{t}}" class="card">
    <view class="card-title">当前不在选人阶段</view>
    <view class="sub">当前阶段：{{t.status === 'registration' ? '报名中' : t.status === 'battle' ? '对战中' : '已结束'}}</view>
    <view class="btn btn-plain" bindtap="goBack">返回</view>
  </view>

  <view wx:else class="card">
    <view class="card-title">暂无比赛</view>
    <view class="btn btn-plain" bindtap="goBack">返回主页</view>
  </view>
</view>

<!-- 选人完成后替换队员：选未选队员或替补换下该队员 -->
<view class="mask" wx:if="{{substitution.show}}">
  <view class="panel">
    <view class="card-title">替换 {{substitution.outNickname}}</view>
    <view class="sub">选择换上队员；若换上替补，换下队员会进入替补席。</view>
    <scroll-view class="substitute-scroll" scroll-y>
      <view wx:if="{{!substitution.candidates.length}}" class="empty">暂无可换上队员（未选队员与替补席都已为空）</view>
      <view
        class="substitute-row"
        wx:for="{{substitution.candidates}}"
        wx:key="openid"
        data-openid="{{item.openid}}"
        bindtap="onPickSubstitute"
      >
        <player-card player="{{item}}" card-style="{{item.cardStyle}}" />
        <text wx:if="{{item.role === 'waitlist'}}" class="tag tag-blue substitute-tag">替补</text>
      </view>
    </scroll-view>
    <view class="btn btn-plain" bindtap="onCloseSubstitution">取消</view>
  </view>
</view>

<!-- 生成对阵前选择赛制 -->
<bracket-type-sheet visible="{{bracketTypeVisible}}" teamCount="{{t.N}}" bind:confirm="onConfirmBracketType" bind:cancel="onCloseBracketType" />
