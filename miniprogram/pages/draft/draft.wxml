<!--pages/draft/draft.wxml - 队长选人-->
<nav-bar title="队长选人" />
<tournament-flow wx:if="{{t}}" tournament="{{t}}" readonly="{{readonly}}" display-stage="{{stageView}}" settlement-ready="{{t.standings && t.standings.complete}}" />
<view class="container">
  <view wx:if="{{refreshError}}" class="card">
    <view class="sub">刷新失败，当前显示的是上次加载的数据。</view>
    <view class="btn-small btn-plain" bindtap="retryLoad">重新加载</view>
  </view>
  <block wx:if="{{t && t.draftInfo}}">
    <!-- 轮次状态 -->
    <view class="card">
      <view class="row">
        <view class="card-title">{{pickStateText}}</view>
        <view class="spacer"></view>
        <view wx:if="{{t.draftInfo.done}}" class="tag tag-green">选人完成</view>
        <view wx:elif="{{canPick}}" class="tag tag-red">轮到你了！</view>
        <view wx:else class="tag tag-blue">等待 {{t.draftInfo.currentCaptain ? t.draftInfo.currentCaptain.nickname : ''}}</view>
      </view>
      <view class="sub" wx:if="{{!t.draftInfo.done}}">当前：队长{{t.draftInfo.capIdx + 1}}（{{t.draftInfo.currentCaptain ? t.draftInfo.currentCaptain.nickname : ''}}）选人</view>
      <view class="divider"></view>
      <!-- 本轮选人顺序 -->
      <view class="chips">
        <view class="chip {{item.active ? 'chip-active' : ''}}" wx:for="{{orderChips}}" wx:key="idx">
          <view class="chip-title">队长{{item.idx + 1}}</view>
          <view class="chip-name">{{item.nickname}}</view>
        </view>
      </view>
      <view class="rule-tip">严格按顺序轮流：上一个队长未选，下一个队长不能选（系统强制）</view>
    </view>

    <!-- 队伍名单 -->
    <view class="section">队伍名单</view>
    <view class="team-grid">
      <view class="team-card" wx:for="{{t.draftInfo.picks}}" wx:key="teamIndex">
        <view class="team-head">
          <view class="team-name">{{item.captain && item.captain.teamName ? item.captain.teamName : '队长' + (item.teamIndex + 1)}}</view>
          <view class="spacer"></view>
          <view class="tag tag-gray">{{item.players.length}}/{{t.K}}</view>
        </view>
        <view class="team-players" wx:if="{{item.captain || item.players.length}}">
          <player-card wx:if="{{item.captain}}" player="{{item.captain}}" card-style="{{item.captain.cardStyle}}" compact="{{true}}" />
          <player-card
            wx:for="{{item.players}}"
            wx:key="openid"
            wx:for-item="p"
            player="{{p}}"
            card-style="{{p.cardStyle}}"
            compact="{{true}}"
          />
        </view>
        <view class="sub" wx:else>未选队员</view>
      </view>
    </view>

    <!-- 剩余队员（仅选人阶段） -->
    <block wx:if="{{t.status === 'draft' && !readonly}}">
      <view class="section">可选队员（{{t.draftInfo.remainingPlayers.length}}）</view>
      <view wx:if="{{t.draftInfo.remainingPlayers.length === 0}}" class="empty">没有剩余队员了</view>
      <view class="card draft-player-row" wx:for="{{t.draftInfo.remainingPlayers}}" wx:key="openid">
        <player-card player="{{item}}" card-style="{{item.cardStyle}}" compact="{{true}}" />
        <view class="row">
          <view wx:if="{{canPick || canManage}}" class="btn-small" data-openid="{{item.openid}}" data-name="{{item.nickname}}" bindtap="onPick">选他</view>
          <view wx:else class="sub">等待轮到你</view>
        </view>
      </view>
    </block>

    <!-- 报名暗号（仅比赛创建者或管理员可见） -->
    <view class="card" wx:if="{{canManage && !readonly && t.secret}}">
      <view class="card-title">报名暗号</view>
      <view class="sub">你是本场创建者或管理员，进入无需验证暗号；可把暗号发给群友报名。</view>
      <view class="row">
        <view style="flex:1;font-size:32rpx;font-weight:600;letter-spacing:2rpx;word-break:break-all;">{{t.secret}}</view>
        <view class="spacer"></view>
        <view class="btn-small" bindtap="onCopySecret">复制</view>
      </view>
    </view>

    <!-- 比赛管理者 -->
    <view class="card" wx:if="{{canManage && !readonly}}">
      <view class="card-title">比赛管理操作</view>
      <view class="sub">可代当前轮次队长选人（直接点上方「选他」）；选人完成后生成对阵进入对战阶段</view>
      <view class="btn" wx:if="{{t.draftInfo.done}}" bindtap="onStartBracket">生成对阵并进入对战</view>
      <view class="btn btn-plain" bindtap="onOpenStageManagement">队伍管理与阶段回退</view>
      <view class="btn btn-plain" bindtap="onResetDraft">重置选人（重新随机队长顺序）</view>
      <view wx:if="{{canDelete && !readonly}}" class="btn btn-danger" bindtap="onDelete">删除比赛</view>
    </view>
  </block>

  <view wx:elif="{{loading}}" class="card">
    <view class="card-title">正在加载比赛</view>
    <view class="sub">请稍候…</view>
  </view>

  <view wx:elif="{{loadError}}" class="card">
    <view class="card-title">比赛加载失败</view>
    <view class="sub">{{loadError}}</view>
    <view class="btn" bindtap="retryLoad">重试</view>
    <view class="btn btn-plain" bindtap="goBack">返回主页</view>
  </view>

  <view wx:elif="{{t}}" class="card">
    <view class="card-title">当前不在选人阶段</view>
    <view class="sub">当前阶段：{{t.status === 'registration' ? '报名中' : t.status === 'battle' ? '对战中' : '已结束'}}</view>
    <view class="btn btn-plain" bindtap="goBack">返回</view>
  </view>

  <view wx:else class="card">
    <view class="card-title">暂无比赛</view>
    <view class="btn btn-plain" bindtap="goBack">返回主页</view>
  </view>
</view>
