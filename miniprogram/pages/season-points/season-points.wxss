/* pages/season-points/season-points.wxss */
.season-page {
  padding: 12rpx 24rpx 44rpx;
  box-sizing: border-box;
}
.season-heading { padding: 16rpx 4rpx 20rpx; }
.season-kicker {
  color: #a9864e;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}
.season-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}
.season-title {
  color: #f0e4c9;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.demo-tag, .sample-label {
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(224, 181, 111, .28);
  border-radius: 20rpx;
  color: #d9b66e;
  background: rgba(224, 181, 111, .08);
  font-size: 20rpx;
}
.season-subtitle { margin-top: 7rpx; color: #939ba8; font-size: 24rpx; }

.season-picker {
  display: flex;
  padding: 7rpx;
  border: 1rpx solid rgba(224, 181, 111, .12);
  border-radius: 12rpx;
  background: #111620;
}
.season-choice {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border-radius: 9rpx;
  color: #858d99;
}
.season-choice-active {
  color: #f0d394;
  background: linear-gradient(145deg, rgba(224, 181, 111, .2), rgba(224, 181, 111, .06));
  box-shadow: inset 0 0 0 1rpx rgba(224, 181, 111, .18);
}
.season-choice-pressed { opacity: .72; }
.season-choice-quarter { font-size: 27rpx; font-weight: 700; letter-spacing: 1rpx; }
.season-choice-status { margin-top: 3rpx; font-size: 18rpx; }

.season-dates {
  display: flex;
  align-items: center;
  margin: 22rpx 4rpx 14rpx;
  color: #c9c4b9;
  font-size: 22rpx;
}
.season-live-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #67707d;
}
.season-live-dot-on { background: #65c58a; box-shadow: 0 0 12rpx rgba(101, 197, 138, .55); }
.season-dates-title { color: #e5d4b2; }
.season-dates-range { margin-left: auto; color: #858d99; font-size: 21rpx; }

.points-card {
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  border: 1rpx solid rgba(224, 181, 111, .24);
  border-radius: 14rpx;
  background:
    radial-gradient(ellipse at 96% 0, rgba(214, 164, 78, .22), transparent 43%),
    linear-gradient(135deg, #222b39 0%, #141923 62%, #17171b 100%);
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, .2), inset 0 0 30rpx rgba(226, 177, 94, .04);
}
.points-card-top, .points-card-identity, .points-metrics, .points-card-bottom { display: flex; align-items: center; }
.points-card-top { justify-content: space-between; }
.points-card-identity { min-width: 0; }
.points-avatar, .leader-avatar, .my-rank-avatar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #f0d394;
  background: linear-gradient(145deg, #50402b, #26212a);
}
.points-avatar { width: 68rpx; height: 68rpx; border: 1rpx solid rgba(224, 181, 111, .38); font-size: 26rpx; }
.points-player-copy { min-width: 0; margin-left: 16rpx; }
.points-card-label { color: #b1a68f; font-size: 21rpx; }
.points-player-name { margin-top: 5rpx; overflow: hidden; color: #f1e8d6; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.points-metrics { margin-top: 25rpx; }
.points-metric { flex: 1; min-width: 0; }
.points-metric-label { color: #9ca3ad; font-size: 22rpx; }
.points-metric-value { margin-top: 5rpx; color: #f0d394; font-size: 54rpx; font-weight: 700; letter-spacing: 1rpx; line-height: 1.15; }
.points-unit { margin-left: 7rpx; color: #c5b28b; font-size: 22rpx; font-weight: 400; }
.metric-divider { width: 1rpx; height: 70rpx; margin: 0 28rpx; background: rgba(224, 181, 111, .19); }
.mmr-value { margin-top: 13rpx; color: #e7e1d5; font-size: 37rpx; font-weight: 600; letter-spacing: 1rpx; }
.points-card-bottom {
  justify-content: space-between;
  margin-top: 21rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(224, 181, 111, .13);
  color: #aab0b8;
  font-size: 21rpx;
}
.points-rank { margin: 0 4rpx; color: #f0d394; font-weight: 700; }

.season-tabs {
  display: flex;
  margin-top: 26rpx;
  border-bottom: 1rpx solid rgba(224, 181, 111, .14);
}
.season-tab {
  position: relative;
  flex: 1;
  padding: 20rpx 4rpx 18rpx;
  text-align: center;
  color: #929aa6;
  font-size: 25rpx;
}
.season-tab-active { color: #f0d394; font-weight: 600; }
.season-tab-active::after {
  position: absolute;
  right: 28%;
  bottom: -1rpx;
  left: 28%;
  height: 4rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: #d6ad68;
  content: '';
}
.season-panel { padding: 22rpx 4rpx 0; }
.panel-heading-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 17rpx; }
.panel-heading { color: #e8dfce; font-size: 29rpx; font-weight: 600; }
.panel-caption { color: #818a97; font-size: 20rpx; }
.leaderboard-head {
  display: flex;
  align-items: center;
  min-height: 54rpx;
  border-bottom: 1rpx solid rgba(224, 181, 111, .08);
  color: #777f8d;
  font-size: 20rpx;
}
.col-place { width: 64rpx; flex: none; text-align: center; }
.col-player { flex: 1; min-width: 0; }
.col-points { width: 108rpx; flex: none; text-align: right; }
/* 积分榜改为名片条目：左侧名次、右侧玩家名片，底部翻页 */
.leader-card-row { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; border-bottom: 1rpx solid rgba(224, 181, 111, .08); }
.leader-card-row-mine { background: rgba(224, 181, 111, .05); }
.leader-rank { display: flex; align-items: center; justify-content: center; width: 64rpx; flex: none; }
.leader-rank-number { color: #aab1ba; font-size: 30rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.leader-rank-top1 { color: #e8c47c; }
.leader-rank-top2 { color: #c7d0dc; }
.leader-rank-top3 { color: #c99773; }
.leader-card-wrap { flex: 1; min-width: 0; }
.board-pager { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 18rpx; }
.pager-btn { flex: none; min-width: 128rpx; padding: 10rpx 20rpx; border: 1rpx solid rgba(224, 181, 111, .3); border-radius: 999rpx; color: #dfd3ba; font-size: 21rpx; text-align: center; }
.pager-btn-disabled { border-color: rgba(150, 150, 150, .18); color: #5c6470; }
.pager-info { flex: 1; color: #8b939f; font-size: 21rpx; text-align: center; }
.my-rank-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 15rpx 10rpx;
  border: 1rpx solid rgba(224, 181, 111, .18);
  border-radius: 10rpx;
  background: rgba(224, 181, 111, .07);
}
.my-rank-place { width: 54rpx; flex: none; color: #e8c27c; text-align: center; font-size: 24rpx; font-weight: 700; }
.my-rank-player { display: flex; flex: 1; min-width: 0; align-items: center; }
.my-rank-avatar { width: 50rpx; height: 50rpx; margin-right: 12rpx; color: #171920; background: linear-gradient(145deg, #e5c47f, #a87838); font-size: 21rpx; font-weight: 700; }
.my-rank-name { color: #eee5d6; font-size: 23rpx; }
.my-rank-meta { margin-top: 3rpx; color: #9199a4; font-size: 19rpx; }
.my-rank-points { width: 108rpx; flex: none; color: #f0d394; text-align: right; font-size: 25rpx; font-weight: 700; }
.demo-footnote { margin-top: 15rpx; color: #727b87; font-size: 20rpx; text-align: center; }

.record-row { display: flex; align-items: center; min-height: 96rpx; border-bottom: 1rpx solid rgba(224, 181, 111, .08); }
.record-mark { width: 12rpx; height: 12rpx; flex: none; margin: 0 18rpx 0 8rpx; border-radius: 50%; background: #cba35e; box-shadow: 0 0 10rpx rgba(203, 163, 94, .35); }
.record-main { flex: 1; min-width: 0; }
.record-title { color: #e1dacd; font-size: 24rpx; }
.record-meta { margin-top: 6rpx; color: #828b98; font-size: 20rpx; }
.record-delta { flex: none; margin-left: 12rpx; color: #8fd1a7; font-size: 26rpx; font-weight: 600; }
.record-delta-negative { color: #e18c7a; }
.rules-panel { padding-bottom: 4rpx; }
.rule-row { display: flex; padding: 18rpx 0; border-bottom: 1rpx solid rgba(224, 181, 111, .08); }
.rule-mark { width: 56rpx; flex: none; color: #b38a4e; font-size: 21rpx; font-weight: 600; letter-spacing: 1rpx; }
.rule-copy { flex: 1; min-width: 0; }
.rule-title { color: #e1dacd; font-size: 24rpx; font-weight: 600; }
.rule-desc { margin-top: 7rpx; color: #929aa6; font-size: 21rpx; line-height: 1.55; }
.score-table-title { margin-top: 22rpx; color: #c8ad78; font-size: 22rpx; font-weight: 600; }
.score-rule-row { margin-top: 12rpx; padding: 14rpx 12rpx; border-radius: 9rpx; background: rgba(255, 255, 255, .025); }
.score-rule-head { display: flex; align-items: center; justify-content: space-between; }
.score-rule-teams { color: #e2d8c5; font-size: 21rpx; font-weight: 600; }
.score-rule-net { color: #7fba91; font-size: 18rpx; }
.score-rule-values { display: flex; margin-top: 12rpx; }
.score-rule-value { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; color: #828b98; font-size: 18rpx; text-align: center; }
.score-rule-value + .score-rule-value { border-left: 1rpx solid rgba(224, 181, 111, .08); }
.score-rule-number { color: #e3d7be; font-size: 20rpx; font-weight: 600; }
.rule-note { margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 8rpx; color: #bda875; background: rgba(224, 181, 111, .07); font-size: 20rpx; line-height: 1.5; }
.season-page-footer { margin-top: 34rpx; color: #68717d; font-size: 18rpx; letter-spacing: 2rpx; text-align: center; }
.season-page-footer text { padding: 0 5rpx; color: #b28b50; }

@media screen and (max-width: 360px) {
  .season-dates { flex-wrap: wrap; row-gap: 6rpx; }
  .season-dates-range { width: 100%; margin-left: 22rpx; }
  .col-points, .my-rank-points { width: 92rpx; }
}
