<nav-bar title="赛季积分" />

<view class="season-page">
  <view class="season-heading">
    <view class="season-kicker">SEASON RANKING</view>
    <view class="season-title-row">
      <view class="season-title">赛季积分</view>
      <view class="demo-tag">真实赛果结算</view>
    </view>
    <view class="season-subtitle">记录赛事表现，与天梯分独立计算</view>
  </view>

  <view class="season-picker" aria-label="选择赛季">
    <view
      wx:for="{{seasons}}"
      wx:key="code"
      class="season-choice {{selectedSeason === item.code ? 'season-choice-active' : ''}}"
      data-season="{{item.code}}"
      bindtap="onSelectSeason"
      hover-class="season-choice-pressed"
    >
      <text class="season-choice-quarter">{{item.short}}</text>
      <text class="season-choice-status">{{item.status}}</text>
    </view>
  </view>

  <view class="season-dates">
    <view class="season-live-dot {{seasonStatus === '进行中' ? 'season-live-dot-on' : ''}}"></view>
    <text class="season-dates-title">{{seasonLabel}} · {{seasonStatus}}</text>
    <text class="season-dates-range">{{seasonPeriod}}</text>
  </view>

  <view wx:if="{{loading}}" class="season-state">
    <view class="season-state-title">正在读取赛季数据</view>
    <view class="season-state-desc">积分只根据已归档赛事结算</view>
  </view>
  <view wx:elif="{{loadError}}" class="season-state season-state-error">
    <view class="season-state-title">赛季数据暂不可用</view>
    <view class="season-state-desc">{{loadError}}</view>
    <view class="season-retry" bindtap="retryLoad" hover-class="season-choice-pressed">重新加载</view>
  </view>

  <view wx:if="{{hasLoaded}}" class="points-card">
    <view class="points-card-top">
      <view class="points-card-identity">
        <view class="points-avatar">我</view>
        <view class="points-player-copy">
          <view class="points-card-label">我的赛季名片</view>
          <view class="points-player-name">{{myNickname}}</view>
        </view>
      </view>
      <view class="sample-label">实时数据</view>
    </view>

    <view class="points-metrics">
      <view class="points-metric points-metric-primary">
        <view class="points-metric-label">{{seasonLabel}} 积分</view>
        <view class="points-metric-value">{{myPoints}}<text class="points-unit">分</text></view>
      </view>
      <view class="metric-divider"></view>
      <view class="points-metric">
        <view class="points-metric-label">天梯分</view>
        <view class="mmr-value">{{mmr}}</view>
      </view>
    </view>

    <view class="points-card-bottom">
      <text>本季排名 <text class="points-rank">#{{myRank === null || myRank === undefined ? '--' : myRank}}</text> / {{totalPlayers}}</text>
      <text>已结算 {{completedMatches}} 场</text>
    </view>
  </view>

  <view class="season-tabs" role="tablist" aria-label="赛季积分内容">
    <view class="season-tab {{activeTab === 'leaderboard' ? 'season-tab-active' : ''}}" data-tab="leaderboard" bindtap="onSelectTab">积分榜</view>
    <view class="season-tab {{activeTab === 'records' ? 'season-tab-active' : ''}}" data-tab="records" bindtap="onSelectTab">积分流水</view>
    <view class="season-tab {{activeTab === 'rules' ? 'season-tab-active' : ''}}" data-tab="rules" bindtap="onSelectTab">规则</view>
  </view>

  <view wx:if="{{activeTab === 'leaderboard'}}" class="season-panel">
    <view class="panel-heading-row">
      <view class="panel-heading">本季排行榜</view>
      <view class="panel-caption">按赛季积分排序</view>
    </view>
    <view class="leaderboard-head">
      <text class="col-player">玩家名片</text>
      <text class="col-points">每页 10 人</text>
    </view>
    <view
      wx:for="{{leaderboard}}"
      wx:key="seq"
      class="leader-card-row {{item.isMine ? 'leader-card-row-mine' : ''}}"
    >
      <view class="leader-card-wrap">
        <player-card player="{{item.player}}" compact="{{true}}" honorsText="{{item.honorsText}}" />
      </view>
    </view>

    <view wx:if="{{leaderboardPage.totalPages > 1}}" class="board-pager">
      <view class="pager-btn {{leaderboardPage.canPrev ? '' : 'pager-btn-disabled'}}" data-dir="-1" bindtap="onLeaderboardPage" hover-class="season-choice-pressed">上一页</view>
      <view class="pager-numbers">
        <view
          wx:for="{{leaderboardPage.pageItems}}"
          wx:key="key"
          class="pager-number {{item.active ? 'pager-number-active' : ''}} {{item.page ? '' : 'pager-number-gap'}}"
          data-page="{{item.page}}"
          bindtap="onLeaderboardPageTap"
          hover-class="{{item.page ? 'season-choice-pressed' : ''}}"
        >{{item.label}}</view>
      </view>
      <view class="pager-btn {{leaderboardPage.canNext ? '' : 'pager-btn-disabled'}}" data-dir="1" bindtap="onLeaderboardPage" hover-class="season-choice-pressed">下一页</view>
    </view>

    <view wx:if="{{showMyRankRow}}" class="my-rank-row">
      <view class="my-rank-place">{{myRankText}}</view>
      <view class="my-rank-player">
        <view class="my-rank-avatar">我</view>
        <view>
          <view class="my-rank-name">{{myNickname}}</view>
          <view class="my-rank-meta">天梯 {{mmr}}</view>
        </view>
      </view>
      <view class="my-rank-points">{{myPoints}}</view>
    </view>
    <view wx:if="{{leaderboard.length === 0}}" class="season-empty">本赛季暂无已结算积分</view>
    <view wx:else class="demo-footnote">{{leaderboardPage.summaryText}} · 名次按积分排序</view>
  </view>

  <view wx:elif="{{activeTab === 'records'}}" class="season-panel">
    <view class="panel-heading-row">
      <view class="panel-heading">积分流水</view>
      <view class="panel-caption">最近的赛事结算</view>
    </view>
    <view wx:for="{{records}}" wx:key="date" class="record-row">
      <view class="record-mark"></view>
      <view class="record-main">
        <view class="record-title">{{item.title}}</view>
        <view class="record-meta">{{item.date}} · {{item.detail}}</view>
      </view>
      <view class="record-delta {{item.negative ? 'record-delta-negative' : ''}}">{{item.delta}}</view>
    </view>
    <view wx:if="{{records.length === 0}}" class="season-empty">暂无积分流水</view>
    <view wx:else class="demo-footnote">每条记录关联已归档赛事和结算名次</view>
  </view>

  <view wx:else class="season-panel rules-panel">
    <view class="panel-heading-row">
      <view class="panel-heading">积分规则</view>
      <view class="panel-caption">2026 赛季规则预览</view>
    </view>
    <view class="rule-row">
      <view class="rule-mark">01</view>
      <view class="rule-copy">
        <view class="rule-title">按赛事最终名次结算</view>
        <view class="rule-desc">赛事归档后，按该队每位正式参赛成员分别记分；同一赛事不会重复发分。</view>
      </view>
    </view>
    <view class="rule-row">
      <view class="rule-mark">02</view>
      <view class="rule-copy">
        <view class="rule-title">赛季按自然季度划分</view>
        <view class="rule-desc">2026 Q1 至 Q4 分别统计；以赛事归档时间归属季度，历史赛季可查询。</view>
      </view>
    </view>
    <view class="rule-row">
      <view class="rule-mark">03</view>
      <view class="rule-copy">
        <view class="rule-title">积分和天梯分互不换算</view>
        <view class="rule-desc">天梯分用于实力展示与现有分队流程；赛季积分只用于赛季排名，不改变天梯分。</view>
      </view>
    </view>
    <view class="rule-row">
      <view class="rule-mark">04</view>
      <view class="rule-copy">
        <view class="rule-title">不同赛制的名次口径不同</view>
        <view class="rule-desc">单败 / 双败：季军与第 4 名同按季军分值，其余淘汰队伍同分；单败排位赛：季军、第 4、5、6、9、10 名各有独立分值，同一名次有多支队伍时同分。</view>
      </view>
    </view>
    <view class="rule-row">
      <view class="rule-mark">05</view>
      <view class="rule-copy">
        <view class="rule-title">结算条件</view>
        <view class="rule-desc">只自动结算 4、8、16 队、全部场次打完并归档的赛事；每队参赛人数不一致时暂不自动结算，原表未定义的“平摊额”不计入本版规则。</view>
      </view>
    </view>
    <view class="rule-row">
      <view class="rule-mark">06</view>
      <view class="rule-copy">
        <view class="rule-title">每场赛事人人有分，名次越高分越多</view>
        <view class="rule-desc">最后一名也是加分，只是少一点；单场合计随队伍数固定（4 队 125、8 队 340、16 队 710，单败排位赛更高），不再有扣分。</view>
      </view>
    </view>
    <block wx:for="{{scoreRules}}" wx:key="title" wx:for-item="table">
      <view class="score-table-title">名次分值 · {{table.title}}</view>
      <view class="score-grid">
        <view class="score-grid-row score-grid-head">
          <view class="score-grid-name">名次</view>
          <view wx:for="{{table.columns}}" wx:key="*this" wx:for-item="column" class="score-grid-cell">{{column}}</view>
        </view>
        <view wx:for="{{table.rows}}" wx:key="label" wx:for-item="row" class="score-grid-row {{row.total ? 'score-grid-total' : ''}}">
          <view class="score-grid-name">{{row.label}}</view>
          <view wx:for="{{row.cells}}" wx:key="key" wx:for-item="cell" class="score-grid-cell {{cell.negative ? 'score-grid-negative' : ''}}">{{cell.text}}</view>
        </view>
      </view>
    </block>
    <view class="rule-note">当前只自动结算 4、8、16 队的已归档赛事；其他队伍数需要后续明确新规则。</view>
  </view>

  <view class="season-page-footer">GLHF <text>·</text> GOOD LUCK, HAVE FUN</view>
</view>
