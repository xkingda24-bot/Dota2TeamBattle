/**app.wxss - Dota2 战队赛 全局暗色主题（The International 金/红配色）**/
page {
  background: #0d1017;
  color: #e8e4da;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: linear-gradient(180deg, #171d29 0%, #12161f 100%);
  border: 1rpx solid rgba(224, 181, 111, 0.14);
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e8c27c;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.section {
  margin: 30rpx 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #d9c089;
  letter-spacing: 2rpx;
}

.sub {
  color: #98a0ab;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.spacer {
  flex: 1;
}

.divider {
  height: 1rpx;
  background: rgba(224, 181, 111, 0.1);
  margin: 16rpx 0;
}

.empty {
  text-align: center;
  color: #6d7480;
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* 按钮 */
.btn {
  background: linear-gradient(135deg, #e5b96f, #b98a3e);
  color: #241a08;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 18rpx 0;
  text-align: center;
  line-height: 1.4;
  margin-top: 16rpx;
}
.btn::after {
  border: none;
}
.btn-plain {
  background: #1a2130;
  color: #dcd6c8;
  border: 1rpx solid rgba(224, 181, 111, 0.28);
}
.btn-disabled {
  background: #232a38;
  color: #6d7480;
}
.btn-danger {
  background: linear-gradient(135deg, #d1543f, #a52f22);
  color: #fff;
}
.btn-small {
  display: inline-block;
  padding: 6rpx 22rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin: 0;
  line-height: 1.6;
  background: linear-gradient(135deg, #e5b96f, #b98a3e);
  color: #241a08;
}
.btn-small.btn-plain {
  background: #1a2130;
  color: #dcd6c8;
  border: 1rpx solid rgba(224, 181, 111, 0.28);
}
.btn-small.btn-danger {
  background: linear-gradient(135deg, #d1543f, #a52f22);
  color: #ffdcd5;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-left: 12rpx;
}
.tag-red {
  background: rgba(224, 181, 111, 0.16);
  color: #e8c27c;
}
.tag-blue {
  background: rgba(132, 162, 210, 0.16);
  color: #a5b9dd;
}
.tag-green {
  background: rgba(46, 180, 120, 0.14);
  color: #5fd08e;
}
.tag-gray {
  background: rgba(255, 255, 255, 0.08);
  color: #98a0ab;
}

/* 输入框 / 选择器 */
.input {
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.12);
  border-radius: 10rpx;
  padding: 18rpx 24rpx;
  color: #e8e4da;
  font-size: 28rpx;
  width: 100%;
  min-height: 92rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.mono {
  font-family: Menlo, Consolas, monospace;
}

/* 输入框占位文字（统一调亮，深色背景上清晰可见） */
.ph {
  color: #9aa4b2;
}

/* 资料信息行（天梯分/位置/签名，报名页与选人页通用） */
.pinfo {
  font-size: 22rpx;
  color: #8b94a1;
  margin-top: 6rpx;
  line-height: 1.5;
  word-break: break-all;
}
.pinfo .kv {
  color: #c9b98f;
}

/* 位置选择按钮（1-5 号位多选，表单通用） */
.role-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.role-btn {
  padding: 12rpx 0;
  width: 18.5%;
  text-align: center;
  border-radius: 10rpx;
  background: #1a2130;
  border: 1rpx solid rgba(224, 181, 111, 0.18);
  color: #98a0ab;
  font-size: 26rpx;
  box-sizing: border-box;
}
.role-btn-active {
  background: rgba(224, 181, 111, 0.18);
  border-color: #e8c27c;
  color: #e8c27c;
  font-weight: 600;
}

/* 弹窗表单字段 */
.field-label {
  font-size: 26rpx;
  color: #c9c3b6;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}
.field-label .req {
  color: #e5484d;
}
.char-count {
  font-size: 22rpx;
  color: #6d7480;
  text-align: right;
  margin-top: 8rpx;
}
.char-count .over {
  color: #e5484d;
}

/* 弹窗（遮罩 + 面板） */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
}
.panel {
  width: 86%;
  background: linear-gradient(180deg, #171d29 0%, #12161f 100%);
  border: 1rpx solid rgba(224, 181, 111, 0.2);
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
  max-height: 86vh;
  overflow-y: auto;
}
.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #e8c27c;
  text-align: center;
  letter-spacing: 2rpx;
}
.panel-sub {
  font-size: 24rpx;
  color: #98a0ab;
  text-align: center;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.panel-btns {
  display: flex;
  margin-top: 28rpx;
}
.panel-btn {
  flex: 1;
  margin-top: 0;
}
.panel-btn + .panel-btn {
  margin-left: 20rpx;
}
